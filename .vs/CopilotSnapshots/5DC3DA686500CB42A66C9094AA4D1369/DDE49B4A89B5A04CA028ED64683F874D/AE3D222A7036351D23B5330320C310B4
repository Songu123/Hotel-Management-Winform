     private async void BtnCompleteCleaning_Click(object sender, EventArgs e)
        {
        try
          {
                if (_currentCleaning == null)
     {
           MessageBox.Show("Vui lòng bắt đầu dọn phòng trước!", "Thông báo",
   MessageBoxButtons.OK, MessageBoxIcon.Warning);
         return;
       }

    var cboConditionAfter = this.Controls.Find("cboConditionAfter", true).FirstOrDefault() as ComboBox;
                var txtNotes = this.Controls.Find("txtNotes", true).FirstOrDefault() as TextBox;

       if (cboConditionAfter == null)
            {
    MessageBox.Show("Vui lòng chọn tình trạng phòng sau dọn!", "Thông báo",
      MessageBoxButtons.OK, MessageBoxIcon.Warning);
  return;
 }

     var result = await _cleaningService.CompleteCleaningAsync(
_currentCleaning.CleaningId,
  cboConditionAfter.SelectedIndex,
txtNotes?.Text ?? ""
          );

         if (result)
       {
      MessageBox.Show("✓ Hoàn thành dọn phòng thành công!", "Thành công",
       MessageBoxButtons.OK, MessageBoxIcon.Information);

   this.DialogResult = DialogResult.OK;
         this.Close();
      }
            }
        catch (Exception ex)
   {
         MessageBox.Show($"❌ Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
    }

        private async void BtnCancelCleaning_Click(object sender, EventArgs e)
        {
     try
            {
       if (_currentCleaning == null)
     {
             MessageBox.Show("Không có dọn phòng đang thực hiện!", "Thông báo",
           MessageBoxButtons.OK, MessageBoxIcon.Warning);
          return;
          }

     var result = MessageBox.Show("Bạn có chắc muốn hủy dọn phòng này?", "Xác nhận",
            MessageBoxButtons.YesNo, MessageBoxIcon.Question);

              if (result != DialogResult.Yes) return;

          await _cleaningService.CancelCleaningAsync(_currentCleaning.CleaningId);

   MessageBox.Show("✓ Hủy dọn phòng thành công!", "Thành công",
                  MessageBoxButtons.OK, MessageBoxIcon.Information);

  this.DialogResult = DialogResult.Cancel;
                this.Close();
   }
  catch (Exception ex)
        {
              MessageBox.Show($"❌ Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
   }

        private void UpdateCleaningStartedUI()
        {
          var btnStartCleaning = this.Controls.Find("btnStartCleaning", true).FirstOrDefault() as Button;
    var btnCompleteCleaning = this.Controls.Find("btnCompleteCleaning", true).FirstOrDefault() as Button;
            var btnCancelCleaning = this.Controls.Find("btnCancelCleaning", true).FirstOrDefault() as Button;
            var lblStartTime = this.Controls.Find("lblStartTime", true).FirstOrDefault() as Label;

    if (btnStartCleaning != null) btnStartCleaning.Enabled = false;
            if (btnCompleteCleaning != null) btnCompleteCleaning.Enabled = true;
      if (btnCancelCleaning != null) btnCancelCleaning.Enabled = true;
         if (lblStartTime != null) lblStartTime.Text = _currentCleaning.StartTime.ToString("HH:mm:ss");
        }

        private string GetRoomTypeName(int roomType)
     {
  return roomType switch
    {
   1 => "Phòng Đơn",
            2 => "Phòng Đôi",
  3 => "Phòng Gia đình",
              4 => "Phòng VIP",
        5 => "Phòng Suite",
            _ => "Không xác định"
        };
        }

        private string GetRoomStatusName(int status)
        {
return status switch
            {
   0 => "Sẵn sàng",
                1 => "Đang sử dụng",
                2 => "Đang dọn",
          3 => "Bảo trì",
    _ => "Không xác định"
       };
      }
