using QuanLyKhachSan.Models; using QuanLyKhachSan.Repositories.Implementations; using QuanLyKhachSan.Repositories.Interfaces; using QuanLyKhachSan.Services.Interfaces;  namespace QuanLyKhachSan.Services.Implementations {     /// <summary>     /// Service implementation cho RoomRentalDetail     /// </summary>     public class RoomRentalDetailService : IRoomRentalDetailService     {         private readonly RoomRentalDetailRepository _roomRentalDetailRepository;         private readonly IRoomRepository _roomRepository;          public RoomRentalDetailService(      RoomRentalDetailRepository roomRentalDetailRepository,        IRoomRepository roomRepository)         {             _roomRentalDetailRepository = roomRentalDetailRepository ?? throw new ArgumentNullException(nameof(roomRentalDetailRepository));             _roomRepository = roomRepository ?? throw new ArgumentNullException(nameof(roomRepository));         }          /// <summary>         /// Thêm chi tiết phòng thuê mới         /// </summary>         public async Task<bool> AddRoomRentalDetailAsync(RoomRentalDetail roomRentalDetail)         {             try             {                 if (roomRentalDetail == null)                     throw new ArgumentNullException(nameof(roomRentalDetail));                  // Validate required fields                 if (string.IsNullOrWhiteSpace(roomRentalDetail.RentalDetailId))                     throw new ArgumentException("Mã chi tiết thuê không được để trống");                  if (string.IsNullOrWhiteSpace(roomRentalDetail.RoomId))                     throw new ArgumentException("Mã phòng không được để trống");                  // ✅ FIX: Only log warning if room doesn't exist                 var room = await _roomRepository.GetRoomWithTypeAsync(roomRentalDetail.RoomId);                 if (room == null)                 {                     System.Diagnostics.Debug.WriteLine($"⚠️ Warning: Room {roomRentalDetail.RoomId} may not exist in system");                 }                  await _roomRentalDetailRepository.AddAsync(roomRentalDetail);                 await _roomRentalDetailRepository.SaveChangesAsync();                  System.Diagnostics.Debug.WriteLine($"✅ Successfully saved room rental detail for room {roomRentalDetail.RoomId}");                 return true;             }             catch (Exception ex)             {                 System.Diagnostics.Debug.WriteLine($"❌ Error in AddRoomRentalDetailAsync: {ex.Message}");                 throw new Exception($"Lỗi khi thêm chi tiết phòng thuê: {ex.InnerException?.Message ?? ex.Message}", ex);             }         }          /// <summary>         /// Thêm nhiều chi tiết phòng thuê         /// </summary>         public async Task<bool> AddRoomRentalDetailsAsync(IEnumerable<RoomRentalDetail> roomRentalDetails)         {             try             {                 if (roomRentalDetails == null || !roomRentalDetails.Any())                     throw new ArgumentException("Danh sách chi tiết phòng không được để trống");                  var detailsList = roomRentalDetails.ToList();                  // ✅ Validate ALL items first before adding any                 foreach (var detail in detailsList)                 {                     if (detail == null)                         throw new ArgumentNullException(nameof(detail));                      if (string.IsNullOrWhiteSpace(detail.RentalDetailId))                         throw new ArgumentException("Mã chi tiết thuê không được để trống");                      if (string.IsNullOrWhiteSpace(detail.RoomId))                         throw new ArgumentException("Mã phòng không được để trống");                      // ✅ FIX: Only log warning if room doesn't exist, don't throw                     var room = await _roomRepository.GetRoomWithTypeAsync(detail.RoomId);                     if (room == null)                     {                         // Log warning but continue - room may be added later                         System.Diagnostics.Debug.WriteLine($"⚠️ Warning: Room {detail.RoomId} may not exist in system");                     }                 }                  // ✅ Add all at once using AddRangeAsync                 await _roomRentalDetailRepository.AddRangeAsync(detailsList);                 await _roomRentalDetailRepository.SaveChangesAsync();                  System.Diagnostics.Debug.WriteLine($"✅ Successfully saved {detailsList.Count} room rental details");                 return true;             }             catch (Exception ex)             {                 System.Diagnostics.Debug.WriteLine($"❌ Error in AddRoomRentalDetailsAsync: {ex.Message}\n{ex.InnerException?.Message}");                 throw new Exception($"Lỗi khi thêm nhiều chi tiết phòng thuê: {ex.InnerException?.Message ?? ex.Message}", ex);             }         }          /// <summary>         /// Lấy chi tiết phòng thuê theo ID chi tiết thuê         /// </summary>         public async Task<IEnumerable<RoomRentalDetail>> GetRoomRentalDetailsByRentalDetailIdAsync(string rentalDetailId)         {             try             {                 if (string.IsNullOrWhiteSpace(rentalDetailId))                     return new List<RoomRentalDetail>();                  var allDetails = await _roomRentalDetailRepository.GetAllAsync();                 return allDetails.Where(r => r.RentalDetailId == rentalDetailId).ToList();             }             catch (Exception ex)             {                 throw new Exception($"Lỗi khi lấy chi tiết phòng thuê", ex);             }         }          /// <summary>         /// Lấy chi tiết phòng thuê theo ID phòng         /// </summary>         public async Task<IEnumerable<RoomRentalDetail>> GetRoomRentalDetailsByRoomIdAsync(string roomId)         {             try             {                 if (string.IsNullOrWhiteSpace(roomId))                     return new List<RoomRentalDetail>();                  var allDetails = await _roomRentalDetailRepository.GetAllAsync();                 return allDetails.Where(r => r.RoomId == roomId).ToList();             }             catch (Exception ex)             {                 throw new Exception($"Lỗi khi lấy chi tiết phòng {roomId}", ex);             }         }          /// <summary>         /// Cập nhật chi tiết phòng thuê         /// </summary>         public async Task<bool> UpdateRoomRentalDetailAsync(RoomRentalDetail roomRentalDetail)         {             try             {                 if (roomRentalDetail == null)                     throw new ArgumentNullException(nameof(roomRentalDetail));                  await _roomRentalDetailRepository.UpdateAsync(roomRentalDetail);                 await _roomRentalDetailRepository.SaveChangesAsync();                  return true;             }             catch (Exception ex)             {                 throw new Exception("Lỗi khi cập nhật chi tiết phòng thuê", ex);             }         }          /// <summary>         /// Xóa chi tiết phòng thuê         /// </summary>         public async Task<bool> DeleteRoomRentalDetailAsync(string rentalDetailId, string roomId, DateTime rentalDate)         {             try             {                 if (string.IsNullOrWhiteSpace(rentalDetailId) || string.IsNullOrWhiteSpace(roomId))                     throw new ArgumentException("Mã chi tiết thuê và mã phòng không được để trống");                  var allDetails = await _roomRentalDetailRepository.GetAllAsync();                 var detail = allDetails.FirstOrDefault(r =>          r.RentalDetailId == rentalDetailId &&              r.RoomId == roomId &&                 r.RentalDate == rentalDate);                  if (detail == null)                     throw new InvalidOperationException("Chi tiết phòng thuê không tồn tại");                  await _roomRentalDetailRepository.DeleteAsync(detail);                 await _roomRentalDetailRepository.SaveChangesAsync();                  return true;             }             catch (Exception ex)             {                 throw new Exception("Lỗi khi xóa chi tiết phòng thuê", ex);             }         }          /// <summary>         /// Xóa tất cả chi tiết phòng của một chi tiết thuê         /// </summary>         public async Task<bool> DeleteAllRoomRentalDetailsByRentalDetailIdAsync(string rentalDetailId)         {             try             {                 if (string.IsNullOrWhiteSpace(rentalDetailId))                     throw new ArgumentException("Mã chi tiết thuê không được để trống");                  var allDetails = await _roomRentalDetailRepository.GetAllAsync();                 var detailsToDelete = allDetails.Where(r => r.RentalDetailId == rentalDetailId).ToList();                  foreach (var detail in detailsToDelete)                 {                     await _roomRentalDetailRepository.DeleteAsync(detail);                 }                  await _roomRentalDetailRepository.SaveChangesAsync();                  return true;             }             catch (Exception ex)             {                 throw new Exception("Lỗi khi xóa chi tiết phòng thuê", ex);             }         }          /// <summary>         /// Lấy chi tiết phòng thuê cùng với thông tin phòng         /// </summary>         public async Task<IEnumerable<RoomRentalDetail>> GetRoomRentalDetailsWithRoomAsync(string rentalDetailId)         {             try             {                 if (string.IsNullOrWhiteSpace(rentalDetailId))                     return new List<RoomRentalDetail>();                  return await GetRoomRentalDetailsByRentalDetailIdAsync(rentalDetailId);             }             catch (Exception ex)             {                 throw new Exception($"Lỗi khi lấy chi tiết phòng cùng thông tin", ex);             }         }          /// <summary>         /// Tính tổng tiền cho chi tiết thuê         /// </summary>         public async Task<int> CalculateTotalPriceAsync(string rentalDetailId)         {             try             {                 var roomDetails = await GetRoomRentalDetailsByRentalDetailIdAsync(rentalDetailId);                 return roomDetails.Sum(r => r.RentalPrice);             }             catch (Exception ex)             {                 throw new Exception("Lỗi khi tính tổng tiền", ex);             }         }     } } 