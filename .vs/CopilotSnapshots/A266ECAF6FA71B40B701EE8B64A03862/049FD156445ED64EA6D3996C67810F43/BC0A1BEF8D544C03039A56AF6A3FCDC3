   Location = new Point(x, y),
Width = width,
           Height = 28,
      BorderStyle = BorderStyle.FixedSingle,
    Font = new Font("Segoe UI", 9)
       };
        }

        private void LoadData()
  {
            try
            {
                // Load customer info
           txtCustomerName.Text = _rentalDetail?.Customer?.Name ?? "N/A";
            txtIdNumber.Text = _rentalDetail?.Customer?.IdNumber ?? "N/A";
    txtInvoiceNumber.Text = "1";

         // Load totals
          txtTotalRoom.Text = _totalRoomCost.ToString("N0") + " VNĐ";
           txtTotalService.Text = _totalServiceCost.ToString("N0") + " VNĐ";
          txtDeposit.Text = _depositAmount.ToString("N0") + " VNĐ";

          int grandTotal = _totalRoomCost + _totalServiceCost;
   txtTotal.Text = grandTotal.ToString("N0") + " VNĐ";

       // Load rooms and services to grids
         LoadRoomsToGrid();
    LoadServicesToGrid();
            }
            catch (Exception ex)
            {
       MessageBox.Show($"Lỗi tải dữ liệu: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void LoadRoomsToGrid()
        {
  dgvRooms.Rows.Clear();
   int stt = 1;

            if (_rentalDetail?.RoomRentalDetails != null)
       {
      foreach (var room in _rentalDetail.RoomRentalDetails)
         {
       dgvRooms.Rows.Add(
   stt++,
    room.RoomId,
             "Theo Ngày",
       room.RentalDate.ToString("dd/MM/yyyy HH:mm:ss"),
             room.ReturnDate.ToString("dd/MM/yyyy HH:mm:ss"),
        room.CheckoutDate.ToString("dd/MM/yyyy HH:mm:ss"),
     room.RentalPrice.ToString("N0") + " VNĐ"
        );
 }
            }
        }

        private void LoadServicesToGrid()
        {
    dgvServices.Rows.Clear();
            int stt = 1;

    if (_rentalDetail?.ServiceRentalDetails != null)
            {
      foreach (var service in _rentalDetail.ServiceRentalDetails)
              {
       int total = service.Price * service.Quantity;
       dgvServices.Rows.Add(
     stt++,
      service.ServiceId,
           "Dịch Vụ",
     service.UsageDate.ToString("dd/MM/yyyy HH:mm:ss"),
           service.Quantity,
 service.Price.ToString("N0") + " VNĐ",
    total.ToString("N0") + " VNĐ"
 );
       }
       }
        }

