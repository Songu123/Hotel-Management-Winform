      private Label CreateLabelControl(string text, int x, int y, Color? color = null, int fontSize = 9, FontStyle fontStyle = FontStyle.Regular)
        {
            return new Label
      {
       Text = text,
      Location = new Point(x, y),
 Font = new Font("Segoe UI", fontSize, fontStyle),
          ForeColor = color ?? Color.FromArgb(60, 60, 60),
         AutoSize = true
       };
        }

        private TextBox CreateTextBoxControl(int x, int y, int width)
      {
