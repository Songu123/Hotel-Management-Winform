 public async Task LoadInvoiceDataAsync()
        {
     try
   {
              // Customer Info
        if (_rentalDetail?.Customer != null)
    {
                  txtCustomerName.Text = _rentalDetail.Customer.Name;
          txtCustomerId.Text = _rentalDetail.Customer.CustomerId;
                    txtPhoneNumber.Text = _rentalDetail.Customer.PhoneNumber;
       txtAddress.Text = _rentalDetail.Customer.Address;
  }

       // Load Room & Service Details
            var roomDetails = await _roomRentalDetailService.GetRoomRentalDetailsByRentalDetailIdAsync(_rentalDetail.RentalDetailId);
     var serviceDetails = await _dbContext.ServiceRentalDetails
 .Where(x => x.RentalDetailId == _rentalDetail.RentalDetailId)
        .ToListAsync();

          int stt = 1;
     int roomTotal = 0;
        int serviceTotal = 0;

       // Add Room Details
              foreach (var room in roomDetails)
     {
        int nights = Math.Max(1, (int)(room.ReturnDate - room.RentalDate).TotalDays);
  int roomPrice = room.RentalPrice * nights;
         roomTotal += roomPrice;

           dgvInvoiceDetails.Rows.Add(
         stt++,
        $"Phòng {room.RoomId}",
           nights,
        room.RentalPrice.ToString("N0"),
        roomPrice.ToString("N0")
  );
           }

                // Add Service Details
          foreach (var service in serviceDetails)
        {
          int itemTotal = service.Price * service.Quantity;
  serviceTotal += itemTotal;

    dgvInvoiceDetails.Rows.Add(
  stt++,
            $"Dịch Vụ: {service.ServiceId}",
  service.Quantity,
      service.Price.ToString("N0"),
             itemTotal.ToString("N0")
 );
}

    // Summary
    int subtotal = roomTotal + serviceTotal;
    int discount = _invoice.Discount;
  int surcharge = _invoice.Surcharge;
            int total = subtotal - discount + surcharge;

    lblRoomTotal.Text = $"{roomTotal:N0} VNĐ";
      lblServiceTotal.Text = $"{serviceTotal:N0} VNĐ";
        lblSubtotal.Text = $"{subtotal:N0} VNĐ";
    lblDiscount.Text = $"- {discount:N0} VNĐ";
    lblSurcharge.Text = $"+ {surcharge:N0} VNĐ";
             lblTotal.Text = $"{total:N0} VNĐ";

      // Payment Method
  txtPaymentMethod.Text = GetPaymentMethodText(_invoice.PaymentMethod);
            }
            catch (Exception ex)
      {
      MessageBox.Show($"Lỗi tải dữ liệu hoá đơn: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
   }
  }

 private string GetPaymentMethodText(int method)
        {
            return method switch
        {
           0 => "Tiền mặt",
         1 => "Thẻ tín dụng",
     2 => "Ví điện tử",
         3 => "Chuyển khoản",
         _ => "Khác"
  };
        }

