        public async Task LoadInvoiceDataAsync()
      {
     try
            {
  // Load room and service details
      var roomDetails = await _roomRentalDetailService.GetRoomRentalDetailsByRentalDetailIdAsync(_rentalDetail.RentalDetailId);
    var serviceDetails = await _dbContext.ServiceRentalDetails
  .Where(x => x.RentalDetailId == _rentalDetail.RentalDetailId)
 .ToListAsync();

                var employee = await _employeeService.GetEmployeeAsync(_rentalDetail.EmployeeId);

      // Calculate totals
    int roomTotal = 0;
      foreach (var room in roomDetails)
       {
           int nights = Math.Max(1, (int)(room.ReturnDate - room.RentalDate).TotalDays);
 roomTotal += room.RentalPrice * nights;
    }

    int serviceTotal = serviceDetails.Sum(s => s.Price * s.Quantity);
       int subtotal = roomTotal + serviceTotal;
                int total = subtotal - _invoice.Discount + _invoice.Surcharge;

           // Build invoice content
                string content = BuildInvoiceContent(
          roomDetails.ToList(),
           serviceDetails,
        employee?.Name ?? "N/A",
         roomTotal,
   serviceTotal,
          subtotal,
        total
        );

   rtbInvoice.Rtf = content;
     }
        catch (Exception ex)
            {
          MessageBox.Show($"Lỗi tải dữ liệu hoá đơn: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
      }
        }

        private string BuildInvoiceContent(
   List<RoomRentalDetail> roomDetails,
       List<ServiceRentalDetail> serviceDetails,
     string employeeName,
            int roomTotal,
            int serviceTotal,
            int subtotal,
            int total)
        {
          var rtf = new System.Text.StringBuilder();
       rtf.AppendLine(@"{\rtf1\ansi\ansicpg1252\deff0");
  rtf.AppendLine(@"{\fonttbl{\f0\fnil Arial;}}");
            rtf.AppendLine(@"{\colortbl;\red0\green0\blue255;}");
    rtf.AppendLine(@"\viewkind4\uc1\pard\f0");

      // Header - Hotel Name
            rtf.AppendLine(@"\b\fs32\cf1 KHÁNH SẠN LUXURY\b0\fs20");
    rtf.AppendLine(@"\par Địa chỉ: 273 An Dương Vương, Phường 3, Quận 5, TP Hồ Chí Minh");
   rtf.AppendLine(@"\par Hotline Booking: 0987654321");
            rtf.AppendLine(@"\par Fax: 0987654321");
        rtf.AppendLine(@"\par\par");

 // Invoice Info Section
            rtf.AppendLine(@"\b\fs24 THÔNG TIN HÓA ĐƠN\b0\fs20");
     rtf.AppendLine(@"\par Mã chi tiết thuê: " + _rentalDetail.RentalDetailId);
   rtf.AppendLine(@"\par Nhân viên lập hóa đơn: " + employeeName);
         rtf.AppendLine(@"\par Ngày lập hóa đơn: " + _invoice.PaymentDate.ToString("HH:mm:ss dd/MM/yyyy"));
    rtf.AppendLine(@"\par\par");

            // Rooms Section
            rtf.AppendLine(@"\b\fs24 THÔNG TIN PHÒNG THUÊ\b0\fs20");
          rtf.AppendLine(@"\par\pard\tldot\tx8640\tqr");

    // Room Table Header
            rtf.AppendLine(@"\b TÊN PHÒNG\tab LOẠI HÌNH THUÊ\tab NGÀY THUÊ\tab NGÀY CHECKOUT\tab GIÁ THUÊ\b0");
   rtf.AppendLine(@"\par\pard");

            // Room rows
 int rowCount = 0;
     foreach (var room in roomDetails)
    {
       int nights = Math.Max(1, (int)(room.ReturnDate - room.RentalDate).TotalDays);
                int roomPrice = room.RentalPrice * nights;
    string rentalType = "Theo ngày"; // Can customize based on RentalType

    rtf.AppendLine($@"{room.RoomId}\tab {rentalType}\tab {room.RentalDate:dd/MM/yyyy}\tab {room.CheckoutDate:dd/MM/yyyy}\tab {roomPrice:N0} VNĐ");
          rtf.AppendLine(@"\par");
                rowCount++;
 }

       rtf.AppendLine(@"\par");

       // Services Section
            if (serviceDetails.Count > 0)
            {
    rtf.AppendLine(@"\b\fs24 THÔNG TIN DỊCH VỤ THUÊ\b0\fs20");
rtf.AppendLine(@"\par");

   // Service Table Header
           rtf.AppendLine(@"\b TÊN DỊCH VỤ\tab LOẠI DỊCH VỤ\tab NGÀY SỬ DỤNG\tab SỐ LƯỢNG\tab ĐƠN GIÁ\tab THÀNH TIỀN\b0");
       rtf.AppendLine(@"\par");

  // Service rows
              foreach (var service in serviceDetails)
             {
         int itemTotal = service.Price * service.Quantity;
            rtf.AppendLine($@"{service.ServiceId}\tab Dịch vụ\tab {service.UsageDate:dd/MM/yyyy}\tab {service.Quantity}\tab {service.Price:N0} VNĐ\tab {itemTotal:N0} VNĐ");
          rtf.AppendLine(@"\par");
  }

                rtf.AppendLine(@"\par");
       }

          // Summary Section
   rtf.AppendLine(@"\b\fs20 THÔNG TIN THANH TOÁN\b0");
      rtf.AppendLine(@"\par");

            rtf.AppendLine($@"Tổng tiền phòng: {roomTotal:N0} VNĐ");
            rtf.AppendLine(@"\par");

            if (serviceTotal > 0)
            {
  rtf.AppendLine($@"Tổng tiền dịch vụ: {serviceTotal:N0} VNĐ");
     rtf.AppendLine(@"\par");
  }

     rtf.AppendLine($@"Cộng tiền: {subtotal:N0} VNĐ");
       rtf.AppendLine(@"\par");

            if (_invoice.Discount > 0)
            {
 rtf.AppendLine($@"Giảm giá: -{_invoice.Discount:N0} VNĐ");
     rtf.AppendLine(@"\par");
         }

            if (_invoice.Surcharge > 0)
          {
          rtf.AppendLine($@"Phụ thu: +{_invoice.Surcharge:N0} VNĐ");
      rtf.AppendLine(@"\par");
          }

rtf.AppendLine(@"\par");
            rtf.AppendLine($@"\b\fs28 TỔNG CỘNG: {total:N0} VNĐ\b0");
         rtf.AppendLine(@"\par\par");

            rtf.AppendLine(@"Phương thức thanh toán: " + GetPaymentMethodText(_invoice.PaymentMethod));
     rtf.AppendLine(@"\par");

  rtf.AppendLine(@"}");

     return rtf.ToString();
      }

 private string GetPaymentMethodText(int method)
        {
    return method switch
 {
        0 => "Tiền mặt",
    1 => "Thẻ tín dụng",
    2 => "Ví điện tử",
     3 => "Chuyển khoản",
       _ => "Khác"
          };
  }

        private void PrintInvoice()
        {
   var printDoc = new System.Drawing.Printing.PrintDocument();
 printDoc.PrintPage += (sender, e) =>
     {
    var textHeight = (int)(rtbInvoice.Font.Height * (rtbInvoice.Lines.Length + 2));
     e.Graphics.DrawString(rtbInvoice.Text, rtbInvoice.Font, Brushes.Black, new Rectangle(50, 50, e.PageBounds.Width - 100, e.PageBounds.Height - 100));
         e.HasMorePages = false;
       };

       var preview = new System.Windows.Forms.PrintPreviewDialog { Document = printDoc, Width = 900, Height = 700 };
            preview.ShowDialog();
        }

