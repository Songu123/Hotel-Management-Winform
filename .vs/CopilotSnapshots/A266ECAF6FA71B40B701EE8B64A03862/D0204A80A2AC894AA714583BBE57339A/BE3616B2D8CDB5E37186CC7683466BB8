        /// <summary>
        /// Load phòng đang dọn dẹp (Status = 1)
        /// </summary>
        private async Task LoadAllRoomsAsync()
        {
            try
            {
                System.Diagnostics.Debug.WriteLine("📌 Loading room rental details with Status = 1 (Đang Dọn Dẹp)...");

                // Get all rentals
                var rentals = await _rentalDetailService.GetAllRentalDetailsAsync();
                if (rentals == null)
                {
                    MessageBox.Show("Không có dữ liệu chi tiết thuê.", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    return;
                }

                _allRoomDetails.Clear();

                // Get room details for each rental
                foreach (var rental in rentals)
                {
                    var roomDetails = await _roomRentalDetailService.GetRoomRentalDetailsByRentalDetailIdAsync(rental.RentalDetailId);
                    if (roomDetails != null)
                    {
                        // ✅ FILTER: Chỉ lấy phòng có Status = 1 (Đang Dọn Dẹp)
                        var cleaningRooms = roomDetails.Where(r => r.Status == 1).ToList();
                        _allRoomDetails.AddRange(cleaningRooms);
                    }
                }

                BindGrid(_allRoomDetails);
                lblStatusInfo.Text = $"✅ Đã tải {_allRoomDetails.Count} phòng đang dọn dẹp";

                System.Diagnostics.Debug.WriteLine($"✅ Loaded {_allRoomDetails.Count} room details with Status = 1");
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"❌ Error loading rooms: {ex.Message}");
                MessageBox.Show($"Lỗi tải dữ liệu: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        /// <summary>
        /// Tìm kiếm phòng theo Mã Chi Tiết Thuê
        /// </summary>
        private async Task SearchRoomsAsync()
        {
            try
            {
                string searchText = txtSearchRental.Text.Trim();
                if (string.IsNullOrWhiteSpace(searchText))
                {
                    await LoadAllRoomsAsync();
                    return;
                }

                System.Diagnostics.Debug.WriteLine($"🔍 Searching rooms for rental: {searchText}");

                var roomDetails = await _roomRentalDetailService.GetRoomRentalDetailsByRentalDetailIdAsync(searchText);
                if (roomDetails == null || !roomDetails.Any())
                {
                    MessageBox.Show($"Không tìm thấy phòng cho mã chi tiết thuê: {searchText}", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    _allRoomDetails.Clear();
                    BindGrid(_allRoomDetails);
                    return;
                }

                _allRoomDetails = roomDetails.ToList();
                BindGrid(_allRoomDetails);
                lblStatusInfo.Text = $"✅ Tìm thấy {_allRoomDetails.Count} phòng";

                System.Diagnostics.Debug.WriteLine($"✅ Found {_allRoomDetails.Count} rooms");
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"❌ Error searching rooms: {ex.Message}");
                MessageBox.Show($"Lỗi tìm kiếm: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        /// <summary>
        /// Cập nhật trạng thái phòng
        /// </summary>
        private async Task UpdateRoomStatusAsync()
        {
            try
            {
                if (dgvRoomStatus.SelectedRows.Count == 0)
                {
                    MessageBox.Show("Vui lòng chọn phòng cần cập nhật.", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    return;
                }

                int updatedCount = 0;

                foreach (DataGridViewRow row in dgvRoomStatus.SelectedRows)
                {
                    // Get new status from grid
                    var newStatusText = row.Cells["NewStatus"].Value?.ToString();
                    if (string.IsNullOrWhiteSpace(newStatusText))
                    {
                        lblStatusInfo.Text = "⚠️ Vui lòng chọn trạng thái mới cho tất cả phòng";
                        continue;
                    }

                    // Convert status text to number
                    int newStatus = GetStatusValue(newStatusText);

                    // Find original room detail
                    var rentalDetailId = row.Cells[1].Value?.ToString();
                    var roomId = row.Cells[2].Value?.ToString();

                    if (string.IsNullOrWhiteSpace(rentalDetailId) || string.IsNullOrWhiteSpace(roomId))
                        continue;

                    var roomDetail = _allRoomDetails.FirstOrDefault(x =>
                        x.RentalDetailId == rentalDetailId && x.RoomId == roomId);

                    if (roomDetail != null)
                    {
                        // Update status
                        roomDetail.Status = newStatus;

                        // Save to database
                        bool success = await _roomRentalDetailService.UpdateRoomRentalDetailAsync(roomDetail);

                        if (success)
                        {
                            System.Diagnostics.Debug.WriteLine($"✅ Updated room {roomId} status to {newStatus}");
                            updatedCount++;

                            // Update grid display
                            row.Cells["CurrentStatus"].Value = newStatusText;
                            row.Cells["NewStatus"].Value = "";
                        }
                        else
                        {
                            System.Diagnostics.Debug.WriteLine($"⚠️ Failed to update room {roomId}");
                        }
                    }
                }

                MessageBox.Show(
                       $"✅ Đã cập nhật {updatedCount} phòng.\n\nTrạng thái được cập nhật thành công!",
           "Thành công",
                 MessageBoxButtons.OK,
                MessageBoxIcon.Information);

                lblStatusInfo.Text = $"✅ Đã cập nhật {updatedCount} phòng";

                // Reload data
                await LoadAllRoomsAsync();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"❌ Error updating room status: {ex.Message}");
                MessageBox.Show($"Lỗi cập nhật: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        /// <summary>
        /// Convert status text to value
        /// </summary>
        private int GetStatusValue(string statusText)
        {
            return statusText switch
            {
                "Đang Thuê" => 0,
                "Đang Dọn Dẹp" => 1,
                "Sẵn Sàng" => 2,
                _ => 0
            };
        }

        /// <summary>
        /// Convert status value to text
        /// </summary>
        private string GetStatusText(int status)
        {
            return status switch
            {
                0 => "Đang Thuê",
                1 => "Đang Dọn Dẹp",
                2 => "Sẵn Sàng",
                _ => "Không xác định"
            };
        }

        /// <summary>
        /// Bind data to grid
        /// </summary>
        private void BindGrid(List<RoomRentalDetail> roomDetails)
        {
            dgvRoomStatus.Rows.Clear();
            int stt = 1;

            foreach (var room in roomDetails)
            {
                dgvRoomStatus.Rows.Add(
          stt++,
 room.RentalDetailId,
  room.RoomId,
 room.RentalDate.ToString("dd/MM/yyyy HH:mm"),
   room.ReturnDate.ToString("dd/MM/yyyy HH:mm"),
  GetStatusText(room.Status),
              ""  // New status column (empty for user to select)
    );
            }
        }
