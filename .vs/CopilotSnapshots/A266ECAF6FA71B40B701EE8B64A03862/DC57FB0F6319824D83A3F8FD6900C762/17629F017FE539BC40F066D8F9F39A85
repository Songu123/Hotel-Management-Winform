        private void PopulateUI()
        {
            try
            {
                if (txtRentalId != null) txtRentalId.Text = _currentRental?.RentalDetailId ?? "N/A";
                if (txtCreatedDate != null) txtCreatedDate.Text = _currentRental?.CreatedDate.ToString("dd/MM/yyyy HH:mm") ?? "N/A";
                if (txtDeposit != null) txtDeposit.Text = (_currentRental?.DepositAmount ?? 0).ToString("N0") + " VNĐ";
                if (txtStatus != null) txtStatus.Text = GetStatusName(_currentRental?.ProcessingStatus ?? 0);

                if (txtCustomerName != null) txtCustomerName.Text = _currentCustomer?.Name ?? "N/A";
                if (txtIdNumber != null) txtIdNumber.Text = _currentCustomer?.IdNumber ?? "N/A";
                if (txtPhone != null) txtPhone.Text = _currentCustomer?.PhoneNumber ?? "N/A";
                if (txtAddress != null) txtAddress.Text = _currentCustomer?.Address ?? "N/A";

                DebugLogger.Info("✓ UI populated with data");
            }
            catch (Exception ex)
            {
                DebugLogger.Error("Error populating UI", ex);
            }
        }

        private void RefreshUI()
        {
            RefreshRoomsGrid();
            RefreshServicesGrid();
        }

        private void RefreshRoomsGrid()
        {
            try
            {
                if (dgvRooms == null) return;

                dgvRooms.Rows.Clear();
                int stt = 1;

                foreach (var room in _roomDetails)
                {
                    int nights = Math.Max(1, (int)(room.ReturnDate - room.RentalDate).TotalDays);
                    int total = room.RentalPrice * nights;

                    dgvRooms.Rows.Add(
            stt++,
         room.RoomId,
           "Standard",
                  room.RentalDate.ToString("dd/MM"),
                      room.ReturnDate.ToString("dd/MM"),
             nights,
                  room.RentalPrice.ToString("N0"),
                     total.ToString("N0")
            );
                }

                DebugLogger.LogGridRows("Rooms Grid", dgvRooms.Rows.Count);
            }
            catch (Exception ex)
            {
                DebugLogger.Error("Error refreshing rooms grid", ex);
            }
        }

        private void RefreshServicesGrid()
        {
            try
            {
                if (dgvServices == null) return;

                dgvServices.Rows.Clear();
                int stt = 1;

                foreach (var service in _serviceDetails)
                {
                    int total = service.Price * service.Quantity;

                    dgvServices.Rows.Add(
               stt++,
        service.ServiceId,
              service.Quantity,
                service.Price.ToString("N0"),
            total.ToString("N0")
              );
                }

                DebugLogger.LogGridRows("Services Grid", dgvServices.Rows.Count);
            }
            catch (Exception ex)
            {
                DebugLogger.Error("Error refreshing services grid", ex);
            }
        }

        private void CalculateTotals()
        {
            try
            {
                int totalRoomCost = _roomDetails.Sum(r =>
               {
                   int nights = Math.Max(1, (int)(r.ReturnDate - r.RentalDate).TotalDays);
                   return r.RentalPrice * nights;
               });

                int totalServiceCost = _serviceDetails.Sum(s => s.Price * s.Quantity);
                int total = totalRoomCost + totalServiceCost;

                if (txtRoomCost != null) txtRoomCost.Text = totalRoomCost.ToString("N0") + " VNĐ";
                if (txtServiceCost != null) txtServiceCost.Text = totalServiceCost.ToString("N0") + " VNĐ";
                if (lblTotalAmount != null) lblTotalAmount.Text = total.ToString("N0") + " VNĐ";

                DebugLogger.LogState(_roomDetails.Count, _serviceDetails.Count, totalRoomCost, totalServiceCost, total);
            }
            catch (Exception ex)
            {
                DebugLogger.Error("Error calculating totals", ex);
            }
        }

        private string GetStatusName(int status)
        {
            return status switch
            {
                0 => "Đang Xử Lý",
                1 => "Đã Xác Nhận",
                2 => "Đã Hủy",
                _ => "Không Xác Định"
            };
        }

