        private void BtnAddRoom_Click(object sender, EventArgs e)
        {
            try
            {
                DebugLogger.Info("=== 🏨 BUTTON: ADD ROOM CLICKED ===");
                DebugLogger.Info($"Current RentalDetailId: {_rentalDetailId}");

                var dialog = new AddRoomDialog(_roomService, _roomRentalDetailService);
                DebugLogger.Info("✓ AddRoomDialog instance created");

                if (dialog.ShowDialog() == DialogResult.OK)
                {
                    DebugLogger.Info("✓ Dialog returned OK");
                    DebugLogger.LogAddRoom(_rentalDetailId, dialog.SelectedRoomId,
                dialog.RentalDate, dialog.ReturnDate, dialog.RentalPrice);

                    var newRoom = new RoomRentalDetail
                    {
                        RentalDetailId = _rentalDetailId,
                        RoomId = dialog.SelectedRoomId,
                        RentalDate = dialog.RentalDate,
                        ReturnDate = dialog.ReturnDate,
                        CheckoutDate = dialog.ReturnDate,  // ✅ Set CheckoutDate = ReturnDate
                        RentalPrice = dialog.RentalPrice,
                        RentalType = 0,  // ✅ Set RentalType (0 = daily, 1 = hourly, etc.)
                        Status = 0
                    };

                    DebugLogger.Info($"✓ RoomRentalDetail object created with RoomId: {newRoom.RoomId}");
                    DebugLogger.Info($"  - RentalDate: {newRoom.RentalDate}");
                    DebugLogger.Info($"  - ReturnDate: {newRoom.ReturnDate}");
                    DebugLogger.Info($"  - CheckoutDate: {newRoom.CheckoutDate}");
                    DebugLogger.Info($"  - RentalPrice: {newRoom.RentalPrice}");

                    _roomDetails.Add(newRoom);
                    DebugLogger.Info($"✓ Room added to _roomDetails. Count: {_roomDetails.Count}");

                    RefreshUI();
                    CalculateTotals();

                    DebugLogger.Success("✓ BtnAddRoom_Click completed successfully");
                    MessageBox.Show("✓ Thêm phòng thành công", "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
                else
                {
                    DebugLogger.Warning("Dialog was cancelled");
                }
            }
            catch (Exception ex)
            {
                DebugLogger.Error("❌ ERROR in BtnAddRoom_Click", ex);
                MessageBox.Show($"Lỗi khi thêm phòng: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

