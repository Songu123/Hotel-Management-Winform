            }
        }

        /// <summary>
        /// Get parent form
        /// </summary>
        private Form GetParentForm()
        {
            Control current = this;
            while (current != null)
            {
                if (current is Form form)
                    return form;
                current = current.Parent;
            }
            return null;
        }

        /// <summary>
        /// Edit status dialog
        /// </summary>
        private async void EditStatusAsync(string rentalDetailId)
        {
            try
            {
                var rental = await _rentalDetailService.GetRentalDetailAsync(rentalDetailId);
                if (rental == null) return;

                var form = new Form
                {
                    Text = "Cập Nhật Tình Trạng",
                    Width = 350,
                    Height = 200,
                    StartPosition = FormStartPosition.CenterParent,
                    FormBorderStyle = FormBorderStyle.FixedDialog,
                    MaximizeBox = false,
                    MinimizeBox = false
                };

                var lbl = new Label { Text = "Tình Trạng:", Location = new Point(20, 30), AutoSize = true };
                var cbo = new ComboBox
                {
                    Location = new Point(100, 25),
                    Width = 200,
                    DropDownStyle = ComboBoxStyle.DropDownList
                };
                cbo.Items.AddRange(new[] { "Đang Xử Lý", "Đã Xác Nhận", "Đã Hủy" });
                cbo.SelectedIndex = rental.ProcessingStatus;

                var btnOk = new Button
                {
                    Text = "Lưu",
                    DialogResult = DialogResult.OK,
                    Location = new Point(100, 80),
                    Width = 80,
                    BackColor = Color.FromArgb(34, 197, 94),
                    ForeColor = Color.White
                };

                var btnCancel = new Button
                {
                    Text = "Hủy",
                    DialogResult = DialogResult.Cancel,
                    Location = new Point(200, 80),
                    Width = 80,
                    BackColor = Color.FromArgb(107, 114, 128),
                    ForeColor = Color.White
                };

                form.Controls.Add(lbl);
                form.Controls.Add(cbo);
                form.Controls.Add(btnOk);
                form.Controls.Add(btnCancel);

                if (form.ShowDialog() == DialogResult.OK)
                {
                    rental.ProcessingStatus = cbo.SelectedIndex;
                    await _rentalDetailService.UpdateRentalDetailAsync(rental);
                    MessageBox.Show("✓ Cập nhật thành công", "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    await LoadRentalDetailsAsync();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

