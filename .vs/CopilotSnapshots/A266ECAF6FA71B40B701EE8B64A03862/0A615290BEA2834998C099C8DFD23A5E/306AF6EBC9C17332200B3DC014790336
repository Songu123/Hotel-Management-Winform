        /// <summary>
        /// Apply filters to rental details using LINQ
        /// Optimized with fluent LINQ chains
        /// </summary>
        private List<RentalDetail> ApplyFilters(List<RentalDetail> rentalDetails)
        {
            var filtered = rentalDetails
          .Where(r => string.IsNullOrWhiteSpace(txtMaChiTiet.Text) ||
                  r.RentalDetailId.Contains(txtMaChiTiet.Text, StringComparison.OrdinalIgnoreCase))
             .Where(r => cboKhachHang.SelectedIndex < 0 ||
                 r.CustomerId == cboKhachHang.SelectedValue?.ToString())
          .Where(r => cboNhanVien.SelectedIndex < 0 ||
           r.EmployeeId == cboNhanVien.SelectedValue?.ToString())
                     .Where(r => cboTrangThai.SelectedIndex < 0 ||
             r.ProcessingStatus == cboTrangThai.SelectedIndex)
                .Where(r =>
             {
                 var startDate = dtpNgayThue.Value.Date;
                 var endDate = dtpNgayTra.Value.Date;
                 return startDate <= endDate &&
            r.CreatedDate.Date >= startDate &&
          r.CreatedDate.Date <= endDate;
             })
             .ToList();

            return filtered;
        }

        /// <summary>
        /// Get status names using Dictionary for faster lookup
        /// </summary>
        private static readonly Dictionary<int, string> StatusMap = new()
        {
      { 0, "Đang Xử Lý" },
            { 1, "Đã Xác Nhận" },
    { 2, "Đã Hủy" }
        };

        /// <summary>
        /// Convert status code to text
        /// </summary>
        private string GetProcessingStatusName(int status)
        {
            return StatusMap.TryGetValue(status, out var statusName)
                 ? statusName
                : "Không Xác Định";
        }

