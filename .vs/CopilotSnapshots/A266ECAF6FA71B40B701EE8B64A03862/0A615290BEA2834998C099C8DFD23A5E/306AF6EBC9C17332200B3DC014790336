        /// <summary>
        /// Load filter data (customers, employees)
        /// Optimized with LINQ Select
        /// ✅ FIX: Changed from async void to async Task
        /// ✅ FIX: Added null checks and empty data handling
        /// </summary>
        private async Task LoadFiltersAsync()
        {
            try
            {
                var customers = await _customerService.GetAllCustomersAsync();
                var customerList = customers?.ToList() ?? new List<Customer>();

                var activeCustomers = customerList
            .Where(c => c.IsDeleted == 0)
         .Select(c => new { DisplayText = $"{c.CustomerId} - {c.Name}", c.CustomerId })
        .ToList();

                cboKhachHang.DataSource = activeCustomers;
                cboKhachHang.DisplayMember = "DisplayText";
                cboKhachHang.ValueMember = "CustomerId";
                cboKhachHang.SelectedIndex = -1;

                var employees = await _employeeService.GetAllEmployeesAsync();
                var employeeList = employees?.ToList() ?? new List<Employee>();

                var activeEmployees = employeeList
          .Where(e => e.IsDeleted == 0)
         .Select(e => new { DisplayText = $"{e.EmployeeId} - {e.Name}", e.EmployeeId })
       .ToList();

                cboNhanVien.DataSource = activeEmployees;
                cboNhanVien.DisplayMember = "DisplayText";
                cboNhanVien.ValueMember = "EmployeeId";
                cboNhanVien.SelectedIndex = -1;

                cboTrangThai.Items.Clear();
                foreach (var item in new[] { "Đang Xử Lý", "Đã Xác Nhận", "Đã Hủy" })
                    cboTrangThai.Items.Add(item);
                cboTrangThai.SelectedIndex = -1;

                cboLoaiThue.Items.Clear();
                foreach (var item in new[] { "Theo Ngày", "Theo Giờ", "Khác" })
                    cboLoaiThue.Items.Add(item);
                cboLoaiThue.SelectedIndex = -1;
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi tải bộ lọc: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        /// <summary>
        /// Load rental details from database
        /// ✅ FIX: Changed from async void to async Task
        /// </summary>
        private async Task LoadRentalDetailsAsync()
        {
            try
            {
                var rentalDetails = await _rentalDetailService.GetAllRentalDetailsAsync();
                _allRentalDetails = rentalDetails.ToList();

                if (_allRentalDetails.Count == 0)
                    MessageBox.Show("Không có chi tiết thuê nào", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);

                await DisplayRentalDetailsAsync(_allRentalDetails);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi tải dữ liệu: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        /// <summary>
        /// Display rental details in DataGridView
        /// ✅ FIX: Properly populate customer and employee names with correct binding
        /// </summary>
        private async Task DisplayRentalDetailsAsync(List<RentalDetail> rentalDetails)
        {
            try
            {
                dgvChiTietThue.DataSource = null;

                var customersData = await _customerService.GetAllCustomersAsync();
                var employeesData = await _employeeService.GetAllEmployeesAsync();

                var allCustomers = customersData?.ToList() ?? new List<Customer>();
                var allEmployees = employeesData?.ToList() ?? new List<Employee>();

                var customerDict = allCustomers
                    .Where(c => c.IsDeleted == 0)
                   .GroupBy(c => c.CustomerId)
                        .ToDictionary(g => g.Key, g => g.FirstOrDefault());

                var employeeDict = allEmployees
                 .Where(e => e.IsDeleted == 0)
              .GroupBy(e => e.EmployeeId)
             .ToDictionary(g => g.Key, g => g.FirstOrDefault());

                var displayList = new List<DisplayRentalDetailDto>();

                foreach (var rental in rentalDetails)
                {
                    customerDict.TryGetValue(rental.CustomerId, out var customer);
                    employeeDict.TryGetValue(rental.EmployeeId, out var employee);

                    var totalPrice = await _roomRentalDetailService.CalculateTotalPriceAsync(rental.RentalDetailId);

                    displayList.Add(new DisplayRentalDetailDto
                    {
                        RentalDetailId = rental.RentalDetailId,
                        CustomerId = rental.CustomerId,
                        CustomerName = customer?.Name ?? "N/A",
                        EmployeeId = rental.EmployeeId,
                        EmployeeName = employee?.Name ?? "N/A",
                        CreatedDate = rental.CreatedDate.ToString("dd/MM/yyyy HH:mm"),
                        DepositAmount = rental.DepositAmount,
                        ProcessingStatus = GetProcessingStatusName(rental.ProcessingStatus),
                        TotalPrice = (int)totalPrice,
                        OriginalRental = rental
                    });

                    System.Diagnostics.Debug.WriteLine(
                $"✅ Row: {rental.RentalDetailId} | KH: {customer?.Name} | NV: {employee?.Name}");
                }

                if (displayList.Count > 0)
                {
                    dgvChiTietThue.DataSource = displayList;
                    System.Diagnostics.Debug.WriteLine($"✅ Displayed {displayList.Count} rows");
                }
                else
                {
                    System.Diagnostics.Debug.WriteLine("⚠️ No rental details to display");
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"❌ Error: {ex.Message}\n{ex.StackTrace}");
                MessageBox.Show($"Lỗi hiển thị dữ liệu: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        /// <summary>
        /// DataGridView cell click handler
        /// </summary>
        private void DgvChiTietThue_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0) return;

            var columnName = dgvChiTietThue.Columns[e.ColumnIndex].Name;
            var rentalDetailId = dgvChiTietThue.Rows[e.RowIndex].Cells["RentalDetailId"].Value?.ToString();

            if (string.IsNullOrEmpty(rentalDetailId)) return;

            switch (columnName)
            {
                case "btnView":
                    ViewDetailsAsync(rentalDetailId);
                    break;
                case "btnEdit":
                    EditStatusAsync(rentalDetailId);
                    break;
            }
        }

        /// <summary>
