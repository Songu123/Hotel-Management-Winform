using System;
using System.Collections.Generic;
using System.Drawing;
using System.Linq;
using System.Threading.Tasks;
using System.Windows.Forms;
using QuanLyKhachSan.Models;
using QuanLyKhachSan.Services.Interfaces;

namespace QuanLyKhachSan.UI.BookingUI
{
    /// <summary>
    /// 🏨 Dialog để thêm phòng vào đơn đặt phòng
    /// - Chọn phòng
 /// - Chọn ngày nhận/trả
    /// - Xem giá phòng
    /// </summary>
    public class AddRoomDialog : Form
    {
        #region ==================== FIELDS ====================

        private IRoomService _roomService;
        private IRoomRentalDetailService _roomRentalDetailService;

      // Public properties
        public string SelectedRoomId { get; set; } = string.Empty;
        public DateTime RentalDate { get; set; } = DateTime.Now;
        public DateTime ReturnDate { get; set; } = DateTime.Now.AddDays(1);
 public int RentalPrice { get; set; } = 0;

        // UI Controls
        private ComboBox cboRoom;
    private DateTimePicker dtpRentalDate;
        private DateTimePicker dtpReturnDate;
private Label lblPrice;
     private Label lblNights;
   private Label lblTotal;
     private Button btnAdd;
        private Button btnCancel;

        #endregion

        #region ==================== CONSTRUCTOR ====================

        public AddRoomDialog(IRoomService roomService, IRoomRentalDetailService roomRentalDetailService)
        {
       _roomService = roomService ?? throw new ArgumentNullException(nameof(roomService));
            _roomRentalDetailService = roomRentalDetailService ?? throw new ArgumentNullException(nameof(roomRentalDetailService));

          InitializeComponent();
            SetupForm();
   }

        #endregion

        #region ==================== SETUP ====================

        private void SetupForm()
        {
       this.Text = "➕ Thêm Phòng";
       this.Width = 450;
            this.Height = 350;
            this.StartPosition = FormStartPosition.CenterParent;
            this.FormBorderStyle = FormBorderStyle.FixedDialog;
            this.MaximizeBox = false;
  this.MinimizeBox = false;
        this.BackColor = Color.FromArgb(249, 250, 251);
  this.Font = new Font("Segoe UI", 10);

            CreateControls();
    LoadRooms();
        }

private void CreateControls()
     {
     // Title
        var lblTitle = new Label
  {
          Text = "Chọn Phòng",
    Font = new Font("Segoe UI", 11, FontStyle.Bold),
    ForeColor = Color.FromArgb(59, 130, 246),
       Location = new Point(20, 20),
         AutoSize = true
         };
            this.Controls.Add(lblTitle);

     // Room selector
       cboRoom = new ComboBox
 {
   Location = new Point(20, 50),
 Width = 400,
      DropDownStyle = ComboBoxStyle.DropDownList,
                Font = new Font("Segoe UI", 10)
    };
            cboRoom.SelectedIndexChanged += CboRoom_SelectedIndexChanged;
   this.Controls.Add(cboRoom);

            // Rental date
            var lblRentalDate = new Label
          {
         Text = "Ngày Nhận:",
       Font = new Font("Segoe UI", 9),
                Location = new Point(20, 90),
   AutoSize = true
    };
            this.Controls.Add(lblRentalDate);

     dtpRentalDate = new DateTimePicker
            {
       Location = new Point(130, 85),
     Width = 290,
   Value = DateTime.Now,
      Format = DateTimePickerFormat.Short
            };
       dtpRentalDate.ValueChanged += DatePicker_ValueChanged;
            this.Controls.Add(dtpRentalDate);

      // Return date
     var lblReturnDate = new Label
            {
    Text = "Ngày Trả:",
                Font = new Font("Segoe UI", 9),
         Location = new Point(20, 130),
     AutoSize = true
            };
    this.Controls.Add(lblReturnDate);

  dtpReturnDate = new DateTimePicker
       {
        Location = new Point(130, 125),
  Width = 290,
      Value = DateTime.Now.AddDays(1),
           Format = DateTimePickerFormat.Short
      };
            dtpReturnDate.ValueChanged += DatePicker_ValueChanged;
            this.Controls.Add(dtpReturnDate);

    // Info panel
 var panelInfo = new Panel
     {
       Location = new Point(20, 170),
      Width = 400,
                Height = 80,
      BackColor = Color.White,
        BorderStyle = BorderStyle.FixedSingle
     };

            // Nights
            var lblNightsLabel = new Label
       {
      Text = "Số Đêm:",
          Font = new Font("Segoe UI", 9),
    Location = new Point(10, 10),
       AutoSize = true
            };
            panelInfo.Controls.Add(lblNightsLabel);

    lblNights = new Label
 {
        Text = "1",
        Font = new Font("Segoe UI", 10, FontStyle.Bold),
      Location = new Point(100, 10),
          AutoSize = true
            };
    panelInfo.Controls.Add(lblNights);

            // Price
       var lblPriceLabel = new Label
{
         Text = "Giá/Đêm:",
     Font = new Font("Segoe UI", 9),
        Location = new Point(10, 35),
    AutoSize = true
            };
     panelInfo.Controls.Add(lblPriceLabel);

  lblPrice = new Label
            {
                Text = "0 VNĐ",
             Font = new Font("Segoe UI", 10, FontStyle.Bold),
                Location = new Point(100, 35),
         AutoSize = true
       };
          panelInfo.Controls.Add(lblPrice);

  // Total
            var lblTotalLabel = new Label
        {
   Text = "Tổng Cộng:",
           Font = new Font("Segoe UI", 9, FontStyle.Bold),
         ForeColor = Color.FromArgb(220, 20, 60),
        Location = new Point(10, 60),
   AutoSize = true
         };
 panelInfo.Controls.Add(lblTotalLabel);

     lblTotal = new Label
            {
    Text = "0 VNĐ",
   Font = new Font("Segoe UI", 11, FontStyle.Bold),
           ForeColor = Color.FromArgb(220, 20, 60),
    Location = new Point(100, 58),
AutoSize = true
        };
            panelInfo.Controls.Add(lblTotal);

   this.Controls.Add(panelInfo);

    // Buttons
        btnAdd = new Button
            {
  Text = "✓ Thêm",
            Width = 100,
        Height = 35,
         Location = new Point(150, 270),
     BackColor = Color.FromArgb(34, 197, 94),
   ForeColor = Color.White,
       Font = new Font("Segoe UI", 10, FontStyle.Bold),
        FlatStyle = FlatStyle.Flat
    };
            btnAdd.Click += BtnAdd_Click;
            this.Controls.Add(btnAdd);

            btnCancel = new Button
            {
    Text = "✕ Hủy",
    Width = 100,
            Height = 35,
       Location = new Point(260, 270),
 BackColor = Color.FromArgb(107, 114, 128),
            ForeColor = Color.White,
           Font = new Font("Segoe UI", 10, FontStyle.Bold),
   FlatStyle = FlatStyle.Flat,
     DialogResult = DialogResult.Cancel
          };
         this.Controls.Add(btnCancel);

          this.CancelButton = btnCancel;
        }

     #endregion

   #region ==================== METHODS ====================

      private async void LoadRooms()
   {
        try
   {
     var rooms = await _roomService.GetAvailableRoomsAsync();
        var roomList = rooms.ToList();

   cboRoom.DataSource = roomList.Select(r => new
      {
         DisplayText = $"{r.RoomId} - {r.RoomName} ({r.RoomType})",
   r.RoomId,
          r.RoomPrice
    }).ToList();

       cboRoom.DisplayMember = "DisplayText";
     cboRoom.ValueMember = "RoomId";
            }
 catch (Exception ex)
       {
                MessageBox.Show($"Lỗi tải danh sách phòng: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
          }
   }

        private void CboRoom_SelectedIndexChanged(object sender, EventArgs e)
  {
            if (cboRoom.SelectedItem is not null)
        {
           var selectedRoom = cboRoom.SelectedItem;
                var roomPrice = (int)selectedRoom.GetType().GetProperty("RoomPrice").GetValue(selectedRoom);
                var roomId = (string)selectedRoom.GetType().GetProperty("RoomId").GetValue(selectedRoom);

       SelectedRoomId = roomId;
        RentalPrice = roomPrice;
   UpdateCalculation();
       }
        }

private void DatePicker_ValueChanged(object sender, EventArgs e)
        {
   RentalDate = dtpRentalDate.Value;
            ReturnDate = dtpReturnDate.Value;

if (ReturnDate <= RentalDate)
    {
         ReturnDate = RentalDate.AddDays(1);
      dtpReturnDate.Value = ReturnDate;
            }

 UpdateCalculation();
        }

        private void UpdateCalculation()
        {
      int nights = (int)(ReturnDate.Date - RentalDate.Date).TotalDays;
            if (nights < 1) nights = 1;

      int total = RentalPrice * nights;

            lblNights.Text = nights.ToString();
  lblPrice.Text = RentalPrice.ToString("N0") + " VNĐ";
 lblTotal.Text = total.ToString("N0") + " VNĐ";
        }

        private void BtnAdd_Click(object sender, EventArgs e)
        {
    if (string.IsNullOrEmpty(SelectedRoomId))
            {
          MessageBox.Show("Vui lòng chọn phòng", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
       return;
         }

        if (ReturnDate <= RentalDate)
      {
        MessageBox.Show("Ngày trả phải sau ngày nhận", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
        return;
   }

            this.DialogResult = DialogResult.OK;
            this.Close();
      }

      #endregion
    }
}
