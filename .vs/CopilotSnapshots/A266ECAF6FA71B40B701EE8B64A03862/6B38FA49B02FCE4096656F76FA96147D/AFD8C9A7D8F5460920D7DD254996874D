        public async void LoadRentalDetail(string rentalDetailId)
        {
try
     {
    _rentalDetailId = rentalDetailId;

           if (_rentalDetailService == null)
    {
MessageBox.Show("Dịch vụ không khả dụng", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            return;
                }

                // Load rental detail
      _currentRental = await _rentalDetailService.GetRentalDetailAsync(rentalDetailId);

 if (_currentRental == null)
    {
           MessageBox.Show("Không tìm thấy chi tiết thuê", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
     return;
         }

   // Load customer info
if (!string.IsNullOrEmpty(_currentRental.CustomerId))
  {
      _currentCustomer = await _customerService.GetCustomerAsync(_currentRental.CustomerId);
       }

         // Load room details
     _roomDetails = (await _roomRentalDetailService.GetRoomRentalDetailsByRentalDetailIdAsync(rentalDetailId))?.ToList() ?? new List<RoomRentalDetail>();

        // Load service details
    // _serviceDetails = await _serviceService.GetServicesByRentalDetailAsync(rentalDetailId);

// Populate UI
        PopulateUI();
      RefreshDataGridViews();
             CalculateTotals();
            }
     catch (Exception ex)
         {
    MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
    }

#endregion

