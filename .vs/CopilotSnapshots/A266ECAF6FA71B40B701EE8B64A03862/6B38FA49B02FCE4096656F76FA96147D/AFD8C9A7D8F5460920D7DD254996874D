     private void PopulateUI()
        {
      try
     {
    // Rental info
     var txtRentalId = this.Controls.Find("txtRentalId", true).FirstOrDefault() as TextBox;
     if (txtRentalId != null) txtRentalId.Text = _currentRental?.RentalDetailId ?? "";

     var txtCustomerName = this.Controls.Find("txtCustomerName", true).FirstOrDefault() as TextBox;
          if (txtCustomerName != null) txtCustomerName.Text = _currentCustomer?.Name ?? "";

        var txtIdNumber = this.Controls.Find("txtIdNumber", true).FirstOrDefault() as TextBox;
      if (txtIdNumber != null) txtIdNumber.Text = _currentCustomer?.IdNumber ?? "";

                var txtPhone = this.Controls.Find("txtPhone", true).FirstOrDefault() as TextBox;
  if (txtPhone != null) txtPhone.Text = _currentCustomer?.PhoneNumber ?? "";

    var txtBookingDate = this.Controls.Find("txtBookingDate", true).FirstOrDefault() as TextBox;
     if (txtBookingDate != null) txtBookingDate.Text = _currentRental?.CreatedDate.ToString("dd/MM/yyyy HH:mm") ?? "";

          var txtDeposit = this.Controls.Find("txtDeposit", true).FirstOrDefault() as TextBox;
     if (txtDeposit != null) txtDeposit.Text = (_currentRental?.DepositAmount ?? 0).ToString("N0") + " VNĐ";
            }
    catch (Exception ex)
  {
    System.Diagnostics.Debug.WriteLine($"[BookingDetail] PopulateUI Error: {ex.Message}");
        }
        }

        private void RefreshDataGridViews()
     {
try
{
   RefreshRoomsGrid();
        RefreshServicesGrid();
            }
            catch (Exception ex)
            {
     MessageBox.Show($"Lỗi làm mới danh sách: {ex.Message}", "Lỗi");
            }
        }

        private void RefreshRoomsGrid()
        {
  var dgvRooms = this.Controls.Find("dgvRooms", true).FirstOrDefault() as DataGridView;
            if (dgvRooms == null) return;

     dgvRooms.Rows.Clear();

   int stt = 1;
 foreach (var room in _roomDetails)
      {
         int nights = (int)(room.ReturnDate - room.RentalDate).TotalDays;
          if (nights <= 0) nights = 1;

         int total = room.RentalPrice * nights;

              dgvRooms.Rows.Add(
  stt++,
          room.RoomId,
  room.RentalDate.ToString("dd/MM/yyyy"),
                 room.ReturnDate.ToString("dd/MM/yyyy"),
      room.RentalPrice.ToString("N0"),
        nights,
        total.ToString("N0")
          );
   }
    }

        private void RefreshServicesGrid()
    {
            var dgvServices = this.Controls.Find("dgvServices", true).FirstOrDefault() as DataGridView;
   if (dgvServices == null) return;

   dgvServices.Rows.Clear();

   int stt = 1;
   foreach (var service in _serviceDetails)
       {
           dgvServices.Rows.Add(
     stt++,
                    service.ServiceId,
     "Service Name",  // TODO: Load actual service name
    service.UsageDate.ToString("dd/MM/yyyy"),
          "1",
      service.Price.ToString("N0"),
          service.Price.ToString("N0")
         );
            }
 }

      private void CalculateTotals()
        {
   try
   {
      // Calculate room total
    _totalRoomCost = _roomDetails.Sum(r =>
              {
      int nights = Math.Max(1, (int)(r.ReturnDate - r.RentalDate).TotalDays);
     return r.RentalPrice * nights;
             });

     // Calculate service total
    _totalServiceCost = _serviceDetails.Sum(s => s.Price);

      // Total cost
 _totalCost = _totalRoomCost + _totalServiceCost;

          // Update UI
     var txtServiceTotal = this.Controls.Find("txtServiceTotal", true).FirstOrDefault() as TextBox;
        if (txtServiceTotal != null)
          {
              txtServiceTotal.Text = _totalServiceCost.ToString("N0") + " VNĐ";
    }
            }
   catch (Exception ex)
            {
  System.Diagnostics.Debug.WriteLine($"[BookingDetail] CalculateTotals Error: {ex.Message}");
  }
        }

