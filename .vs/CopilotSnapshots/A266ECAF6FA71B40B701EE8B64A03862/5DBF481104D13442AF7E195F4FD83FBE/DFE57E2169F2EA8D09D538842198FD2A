   public async Task LoadBookingDetailAsync(string rentalDetailId)
        {
   try
   {
    if (string.IsNullOrWhiteSpace(rentalDetailId) || _rentalDetailService == null)
        return;

    // Load rental detail
  _currentRental = await _rentalDetailService.GetRentalDetailAsync(rentalDetailId);
       if (_currentRental == null)
 {
  MessageBox.Show("Không tìm thấy thông tin chi tiết thuê", "Thông báo");
     return;
  }

 // Load customer
   _currentCustomer = await _customerService.GetCustomerAsync(_currentRental.CustomerId);

       // Load room details - use correct method name
 if (_roomRentalDetailService != null)
            {
 _roomDetails = (await _roomRentalDetailService.GetRoomRentalDetailsByRentalDetailIdAsync(rentalDetailId))?.ToList() ?? new();
  }

    // Load service details - TODO: Need IServiceRentalDetailService
   _serviceDetails = new(); // Placeholder - service details loading needs to be implemented

          // Update UI
    UpdateUI();
        }
   catch (Exception ex)
     {
  MessageBox.Show($"Lỗi tải dữ liệu: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
     }

        private void UpdateUI()
        {
       if (_currentRental == null || _currentCustomer == null)
           return;

    // Update left info panel
      UpdateLeftPanel();

       // Update room list
     UpdateRoomList();

            // Update service list
            UpdateServiceList();

 // Update payment info
            UpdatePaymentInfo();
        }

        private void UpdateLeftPanel()
        {
            var txtRentalId = this.Controls.Find("txtRentalId", true).FirstOrDefault() as TextBox;
            var txtCustomerName = this.Controls.Find("txtCustomerName", true).FirstOrDefault() as TextBox;
    var txtIdNumber = this.Controls.Find("txtIdNumber", true).FirstOrDefault() as TextBox;
      var txtPhoneNumber = this.Controls.Find("txtPhoneNumber", true).FirstOrDefault() as TextBox;
var txtEmployeeName = this.Controls.Find("txtEmployeeName", true).FirstOrDefault() as TextBox;
            var txtCreatedDate = this.Controls.Find("txtCreatedDate", true).FirstOrDefault() as TextBox;

if (txtRentalId != null) txtRentalId.Text = _currentRental.RentalDetailId;
    if (txtCustomerName != null) txtCustomerName.Text = _currentCustomer.Name;
    if (txtIdNumber != null) txtIdNumber.Text = _currentCustomer.IdNumber;
          if (txtPhoneNumber != null) txtPhoneNumber.Text = _currentCustomer.PhoneNumber;
   if (txtEmployeeName != null) txtEmployeeName.Text = _currentRental.EmployeeId; // Should load employee name from DB
  if (txtCreatedDate != null) txtCreatedDate.Text = _currentRental.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss");
        }

      private void UpdateRoomList()
        {
  if (dgvRooms == null || _roomDetails == null)
     return;

     dgvRooms.Rows.Clear();

      int stt = 1;
    int totalPrice = 0;

          foreach (var room in _roomDetails)
    {
      int nights = (int)(room.ReturnDate - room.RentalDate).TotalDays;
          if (nights <= 0) nights = 1;
          int roomTotal = room.RentalPrice * nights;
       totalPrice += roomTotal;

             dgvRooms.Rows.Add(
              stt++,
    room.RoomId,
      "Phòng", // Should load actual room name
      GetRoomStatus(room.Status),
         GetRentalTypeName(room.RentalType),
     room.RentalDate.ToString("dd/MM/yyyy HH:mm"),
           room.ReturnDate.ToString("dd/MM/yyyy HH:mm"),
   room.RentalPrice.ToString("N0"),
     room.CheckoutDate.ToString("dd/MM/yyyy HH:mm")
        );
            }
        }

        private void UpdateServiceList()
  {
     if (dgvServices == null || _serviceDetails == null)
        return;

         dgvServices.Rows.Clear();

       int stt = 1;
       foreach (var service in _serviceDetails)
 {
              int totalPrice = service.Price * service.Quantity;

        var rowIndex = dgvServices.Rows.Add(
         stt++,
      service.ServiceId,
           "Tên Dịch Vụ", // Should load service name
         service.UsageDate.ToString("dd/MM/yyyy"),
 service.Quantity,
           service.Price.ToString("N0"),
   totalPrice.ToString("N0"),
     "✏️",
          "❌"
                );

     // Style delete button
                dgvServices.Rows[rowIndex].Cells["Delete"].Style.BackColor = Color.FromArgb(220, 53, 69);
          dgvServices.Rows[rowIndex].Cells["Delete"].Style.ForeColor = Color.White;
                dgvServices.Rows[rowIndex].Cells["Edit"].Style.BackColor = Color.FromArgb(0, 102, 204);
         dgvServices.Rows[rowIndex].Cells["Edit"].Style.ForeColor = Color.White;
            }
     }

        private void UpdatePaymentInfo()
{
     int totalRoomPrice = _roomDetails.Sum(r => r.RentalPrice * (int)(r.ReturnDate - r.RentalDate).TotalDays);
            int totalServicePrice = _serviceDetails.Sum(s => s.Price * s.Quantity);
int totalPrice = totalRoomPrice + totalServicePrice;
            int remaining = totalPrice - _currentRental.DepositAmount;

   if (lblTotalAmount != null)
   lblTotalAmount.Text = $"{totalPrice:N0} VNĐ";
      if (lblDepositAmount != null)
       lblDepositAmount.Text = $"{_currentRental.DepositAmount:N0} VNĐ";
    if (lblRemainingAmount != null)
                lblRemainingAmount.Text = $"{remaining:N0} VNĐ";
        }

