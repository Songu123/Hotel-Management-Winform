        private string GetRoomStatus(int status)
        {
          return status switch
            {
0 => "Trống",
    1 => "Đã có khách",
     2 => "Đang dọn dẹp",
    3 => "Đang bảo trì",
             _ => "Không xác định"
            };
        }

 private string GetRentalTypeName(int type)
        {
  return type switch
            {
  0 => "Theo Ngày",
        1 => "Theo Giờ",
     2 => "Theo Tháng",
     _ => "Không xác định"
      };
        }

        private void ApplyModernStyling()
        {
    // Apply modern styling to all controls
            foreach (Control ctrl in GetAllControls(this))
    {
        if (ctrl is TextBox txt)
   {
            txt.Font = new Font("Segoe UI", 9);
         txt.BorderStyle = BorderStyle.FixedSingle;
       }
                else if (ctrl is Label lbl)
          {
          lbl.Font = new Font("Segoe UI", 9);
        lbl.ForeColor = Color.FromArgb(60, 60, 60);
                }
          else if (ctrl is DataGridView dgv)
   {
    dgv.Font = new Font("Segoe UI", 9);
      dgv.EnableHeadersVisualStyles = false;
        dgv.ColumnHeadersDefaultCellStyle.BackColor = Color.FromArgb(0, 102, 204);
      dgv.ColumnHeadersDefaultCellStyle.ForeColor = Color.White;
               dgv.ColumnHeadersDefaultCellStyle.Font = new Font("Segoe UI", 9, FontStyle.Bold);
     }
            }
      }

        private IEnumerable<Control> GetAllControls(Control container)
    {
            foreach (Control ctrl in container.Controls)
 {
                yield return ctrl;
     foreach (var child in GetAllControls(ctrl))
       {
                 yield return child;
          }
            }
     }

