        private void BtnAddRoom_Click(object sender, EventArgs e)
    {
  try
      {
                var dialog = new AddRoomDialog(_roomService, _roomRentalDetailService);
          if (dialog.ShowDialog() == DialogResult.OK)
            {
      // Create new room rental detail
var newRoom = new RoomRentalDetail
        {
       RentalDetailId = _rentalDetailId,
   RoomId = dialog.SelectedRoomId,
        RentalDate = dialog.RentalDate,
         ReturnDate = dialog.ReturnDate,
          RentalPrice = dialog.RentalPrice,
    Status = 0
         };

         // Add to local list and update UI
          _roomDetails.Add(newRoom);
     RefreshRoomsGrid();
    CalculateTotals();

        MessageBox.Show("✓ Thêm phòng thành công", "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
       }
    }
         catch (Exception ex)
            {
    MessageBox.Show($"Lỗi khi thêm phòng: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
     }
        }

