        public async Task LoadBookingDetailAsync(string rentalDetailId)
 {
        try
        {
        _rentalDetailId = rentalDetailId;

   _currentRental = await _rentalDetailService.GetRentalDetailAsync(rentalDetailId);
  if (_currentRental == null)
       {
           MessageBox.Show("Không tìm thấy chi tiết đặt phòng", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
         return;
   }

 if (!string.IsNullOrEmpty(_currentRental.CustomerId))
           {
         _currentCustomer = await _customerService.GetCustomerAsync(_currentRental.CustomerId);
     }

      _roomDetails = (await _roomRentalDetailService.GetRoomRentalDetailsByRentalDetailIdAsync(rentalDetailId))?.ToList() ?? new List<RoomRentalDetail>();

           PopulateUI();
           RefreshRoomsGrid();
                RefreshServicesGrid();
        CalculateTotals();
       }
            catch (Exception ex)
  {
     MessageBox.Show($"Lỗi tải dữ liệu: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
         }
  }

   #endregion

        #region ==================== PRIVATE METHODS ====================

     private void PopulateUI()
        {
       try
         {
           SetTextBoxValue("txtRentalId", _currentRental?.RentalDetailId ?? "N/A");
          SetTextBoxValue("txtCreatedDate", _currentRental?.CreatedDate.ToString("dd/MM/yyyy HH:mm") ?? "N/A");
     SetTextBoxValue("txtDeposit", (_currentRental?.DepositAmount ?? 0).ToString("N0") + " VNĐ");
                SetTextBoxValue("txtStatus", GetStatusName(_currentRental?.ProcessingStatus ?? 0));

                SetTextBoxValue("txtCustomerName", _currentCustomer?.Name ?? "N/A");
                SetTextBoxValue("txtIdNumber", _currentCustomer?.IdNumber ?? "N/A");
   SetTextBoxValue("txtPhone", _currentCustomer?.PhoneNumber ?? "N/A");
        SetTextBoxValue("txtAddress", _currentCustomer?.Address ?? "N/A");
    }
            catch (Exception ex)
       {
  System.Diagnostics.Debug.WriteLine($"Error populating UI: {ex.Message}");
          }
 }

        private void SetTextBoxValue(string controlName, string value)
        {
  var control = this.Controls.Find(controlName, true).FirstOrDefault() as TextBox;
            if (control != null)
            {
  control.Text = value;
        }
        }

        private void RefreshRoomsGrid()
        {
         try
    {
  dgvRooms.Rows.Clear();

  int stt = 1;
            foreach (var room in _roomDetails)
     {
      int nights = Math.Max(1, (int)(room.ReturnDate - room.RentalDate).TotalDays);
        int total = room.RentalPrice * nights;

              dgvRooms.Rows.Add(
        stt++,
      room.RoomId,
      "Standard",
         room.RentalDate.ToString("dd/MM"),
      room.ReturnDate.ToString("dd/MM"),
         nights,
  room.RentalPrice.ToString("N0"),
            total.ToString("N0")
  );
    }
          }
            catch (Exception ex)
          {
     System.Diagnostics.Debug.WriteLine($"Error refreshing rooms: {ex.Message}");
    }
        }

        private void RefreshServicesGrid()
        {
      try
            {
   dgvServices.Rows.Clear();

              int stt = 1;
       foreach (var service in _serviceDetails)
  {
      int total = service.Price * service.Quantity;

 dgvServices.Rows.Add(
            stt++,
          service.ServiceId,
 service.Quantity,
     service.Price.ToString("N0"),
         total.ToString("N0")
   );
                }
       }
            catch (Exception ex)
        {
              System.Diagnostics.Debug.WriteLine($"Error refreshing services: {ex.Message}");
        }
   }

        private void CalculateTotals()
     {
   try
            {
      int totalRoomCost = _roomDetails.Sum(r =>
{
                 int nights = Math.Max(1, (int)(r.ReturnDate - r.RentalDate).TotalDays);
        return r.RentalPrice * nights;
      });

    int totalServiceCost = _serviceDetails.Sum(s => s.Price * s.Quantity);
    int total = totalRoomCost + totalServiceCost;

     SetTextBoxValue("txtRoomCost", totalRoomCost.ToString("N0") + " VNĐ");
            SetTextBoxValue("txtServiceCost", totalServiceCost.ToString("N0") + " VNĐ");
   lblTotalAmount.Text = total.ToString("N0") + " VNĐ";
 }
            catch (Exception ex)
            {
    System.Diagnostics.Debug.WriteLine($"Error calculating totals: {ex.Message}");
        }
        }

     private string GetStatusName(int status)
        {
            return status switch
     {
         0 => "Đang Xử Lý",
        1 => "Đã Xác Nhận",
     2 => "Đã Hủy",
_ => "Không Xác Định"
            };
        }

