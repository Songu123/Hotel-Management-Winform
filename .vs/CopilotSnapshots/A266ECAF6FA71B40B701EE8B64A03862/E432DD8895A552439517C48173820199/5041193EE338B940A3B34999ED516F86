   {
      BtnEdit_Click(null, null);
        }
      }

        /// <summary>
        /// Update status label
        /// </summary>
     private void UpdateStatusLabel(string? text = null)
        {
if (text != null)
    {
            lblStatus.Text = text;
 }
        else
       {
     lblStatus.Text = _selectedService != null ? $"Đã chọn: {_selectedService.Name}" : "Chọn dịch vụ để sửa hoặc xóa";
            }
        }
