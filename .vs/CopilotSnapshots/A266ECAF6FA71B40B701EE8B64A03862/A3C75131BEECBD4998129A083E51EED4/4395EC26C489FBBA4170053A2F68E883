        private static void AddLabeledCell(TableLayoutPanel table, int col, int row, string label, Control control)
        {
            var labelPanel = new Panel { Dock = DockStyle.Fill };
            var lbl = new Label
            {
                Text = label,
                AutoSize = true,
                Location = new Point(0, 8),
                Font = new Font("Segoe UI", 9)
            };
            labelPanel.Controls.Add(lbl);
            table.Controls.Add(labelPanel, col, row);
            table.Controls.Add(control, col + 1, row);
        }

        private async Task LoadInvoicesAsync()
        {
            _allRows.Clear();
            var invoices = (await _invoiceService.GetAllInvoicesAsync()).OrderByDescending(x => x.PaymentDate).ToList();

            foreach (var invoice in invoices)
            {
                var rental = await _rentalDetailService.GetRentalDetailAsync(invoice.RentalDetailId);
                var employeeName = rental?.EmployeeId ?? string.Empty;
                if (!string.IsNullOrWhiteSpace(rental?.EmployeeId))
                {
                    var employee = await _employeeService.GetEmployeeAsync(rental.EmployeeId);
                    if (employee != null) employeeName = employee.Name;
                }

                var roomDetails = await _roomRentalDetailService.GetRoomRentalDetailsByRentalDetailIdAsync(invoice.RentalDetailId);
                
                // ✅ FIX: Calculate room total correctly = RentalPrice × Number of nights
                int roomTotal = 0;
                foreach (var room in roomDetails)
                {
                    int nights = Math.Max(1, (int)(room.ReturnDate - room.RentalDate).TotalDays);
                    int roomPrice = room.RentalPrice * nights;
                    roomTotal += roomPrice;
        
              System.Diagnostics.Debug.WriteLine(
$"📌 Invoice {invoice.InvoiceId} - Room {room.RoomId}: {room.RentalPrice:N0} × {nights} nights = {roomPrice:N0} VNĐ");
     }
    
      // ✅ FIX: Calculate service total correctly = Price × Quantity
           var serviceTotal = await _dbContext.ServiceRentalDetails
             .Where(x => x.RentalDetailId == invoice.RentalDetailId)
          .SumAsync(x => (int?)x.Price * x.Quantity) ?? 0;

           System.Diagnostics.Debug.WriteLine(
         $"📌 Invoice {invoice.InvoiceId}: Room Total = {roomTotal:N0} VNĐ, Service Total = {serviceTotal:N0} VNĐ");

       // ✅ Calculate final total: Room + Service - Discount + Surcharge
      var total = roomTotal + serviceTotal - invoice.Discount + invoice.Surcharge;

        System.Diagnostics.Debug.WriteLine(
            $"✅ Invoice {invoice.InvoiceId}: {roomTotal:N0} + {serviceTotal:N0} - {invoice.Discount:N0} + {invoice.Surcharge:N0} = {total:N0} VNĐ");

                _allRows.Add(new InvoiceRowVm
                {
    InvoiceId = invoice.InvoiceId,
     RentalDetailId = invoice.RentalDetailId,
            EmployeeName = employeeName,
         RoomTotal = roomTotal,
           ServiceTotal = serviceTotal,
          Discount = invoice.Discount,
     Surcharge = invoice.Surcharge,
          Total = total,
 PaymentDate = invoice.PaymentDate,
         PaymentMethod = invoice.PaymentMethod
 });
}

     BindGrid(_allRows);
        }
      private void ApplyFilter()
        {
    var query = _allRows.AsEnumerable();

     if (!string.IsNullOrWhiteSpace(_txtInvoiceId.Text))
                query = query.Where(x => x.InvoiceId.Contains(_txtInvoiceId.Text.Trim(), StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(_txtRentalId.Text))
      query = query.Where(x => x.RentalDetailId.Contains(_txtRentalId.Text.Trim(), StringComparison.OrdinalIgnoreCase));

          if (_dtFrom.Checked)
            query = query.Where(x => x.PaymentDate.Date >= _dtFrom.Value.Date);

    if (_dtTo.Checked)
             query = query.Where(x => x.PaymentDate.Date <= _dtTo.Value.Date);

         if (!string.IsNullOrWhiteSpace(_txtEmployeeName.Text))
    query = query.Where(x => x.EmployeeName.Contains(_txtEmployeeName.Text.Trim(), StringComparison.OrdinalIgnoreCase));

            if (int.TryParse(_txtDiscount.Text.Replace(",", ""), out var discount))
        query = query.Where(x => x.Discount == discount);

            if (int.TryParse(_txtSurcharge.Text.Replace(",", ""), out var surcharge))
     query = query.Where(x => x.Surcharge == surcharge);

 if (!string.IsNullOrWhiteSpace(_txtTotal.Text) && int.TryParse(_txtTotal.Text.Replace(",", ""), out var total))
    query = query.Where(x => x.Total == total);

            if (!string.IsNullOrWhiteSpace(_txtRoomTotal.Text) && int.TryParse(_txtRoomTotal.Text.Replace(",", ""), out var roomTotal))
      query = query.Where(x => x.RoomTotal == roomTotal);

    if (!string.IsNullOrWhiteSpace(_txtServiceTotal.Text) && int.TryParse(_txtServiceTotal.Text.Replace(",", ""), out var serviceTotal))
  query = query.Where(x => x.ServiceTotal == serviceTotal);

     if (_cboPaymentMethod.SelectedIndex > 0)
      query = query.Where(x => GetPaymentMethodText(x.PaymentMethod) == _cboPaymentMethod.Text);

BindGrid(query);
      }

        private async Task RefreshAsync()
    {
            _txtInvoiceId.Clear();
    _txtRentalId.Clear();
       _txtEmployeeName.Clear();
            _txtDiscount.Clear();
  _txtSurcharge.Clear();
            _txtTotal.Clear();
            _txtRoomTotal.Clear();
    _txtServiceTotal.Clear();
         _cboPaymentMethod.SelectedIndex = 0;
            _dtFrom.Checked = false;
    _dtTo.Checked = false;

            await LoadInvoicesAsync();
        }

        private void DgvInvoices_CellClick(object? sender, DataGridViewCellEventArgs e)
    {
   if (e.RowIndex < 0 || e.RowIndex >= _dgvInvoices.Rows.Count) return;
   var invoiceId = _dgvInvoices.Rows[e.RowIndex].Cells[1].Value?.ToString();
    if (string.IsNullOrWhiteSpace(invoiceId)) return;

   var selected = _allRows.FirstOrDefault(x => x.InvoiceId == invoiceId);
        if (selected == null) return;

     _txtInvoiceId.Text = selected.InvoiceId;
_txtRentalId.Text = selected.RentalDetailId;
  _txtEmployeeName.Text = selected.EmployeeName;
         _txtDiscount.Text = selected.Discount.ToString("N0");
    _txtSurcharge.Text = selected.Surcharge.ToString("N0");
        _txtTotal.Text = selected.Total.ToString("N0");
   _txtRoomTotal.Text = selected.RoomTotal.ToString("N0");
          _txtServiceTotal.Text = selected.ServiceTotal.ToString("N0");
          _cboPaymentMethod.Text = GetPaymentMethodText(selected.PaymentMethod);
            _dtFrom.Value = selected.PaymentDate;
    _dtFrom.Checked = true;
    _dtTo.Value = selected.PaymentDate;
   _dtTo.Checked = true;
    
            // ✅ NEW: Open Professional Invoice Form
    OpenProfessionalInvoiceAsync(invoiceId);
     }
        
        // ✅ NEW: Open Professional Invoice Form
   private async void OpenProfessionalInvoiceAsync(string invoiceId)
 {
        try
      {
      var invoice = await _invoiceService.GetInvoiceAsync(invoiceId);
                if (invoice == null)
  {
               MessageBox.Show("Không tìm thấy hoá đơn", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
   return;
          }
          
          var rentalDetail = await _rentalDetailService.GetRentalDetailWithDetailsAsync(invoice.RentalDetailId);
  if (rentalDetail == null)
          {
    MessageBox.Show("Không tìm thấy chi tiết thuê phòng", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
      return;
              }

            // Open Professional Invoice Form
            var invoiceForm = new ProfessionalInvoiceForm(
          invoice,
   rentalDetail,
   _rentalDetailService,
     _roomRentalDetailService,
   _employeeService,
   _dbContext
   );
                
    await invoiceForm.LoadInvoiceDataAsync();
    invoiceForm.ShowDialog();
}
          catch (Exception ex)
     {
      MessageBox.Show($"Lỗi mở hoá đơn: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
  }

