        private void BindGrid(IEnumerable<InvoiceRowVm> rows)
     {
        _dgvInvoices.Rows.Clear();
  var i = 1;
      foreach (var row in rows)
            {
       _dgvInvoices.Rows.Add(
i++,
              row.InvoiceId,
      row.RentalDetailId,
            row.EmployeeName,
        $"{row.RoomTotal:N0} VNĐ",
            $"{row.ServiceTotal:N0} VNĐ",
           $"{row.Discount:N0}",
           $"{row.Surcharge:N0}",
   $"{row.Total:N0} VNĐ",
         row.PaymentDate.ToString("dd/MM/yyyy")
    );
          }
}

    private static string GetPaymentMethodText(int value)
        {
      return value switch
            {
        0 => "Tiền mặt",
   1 => "Thẻ",
     2 => "Ví điện tử",
   3 => "Chuyển khoản",
    _ => "Khác"
    };
        }

