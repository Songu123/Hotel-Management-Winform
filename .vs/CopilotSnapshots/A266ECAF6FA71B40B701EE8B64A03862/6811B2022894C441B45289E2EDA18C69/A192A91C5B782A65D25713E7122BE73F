        /// <summary>
        /// Create styled TextBox
        /// </summary>
        private TextBox CreateStyledTextBox(int x, int y, int width, int height)
        {
            var txt = new TextBox
            {
       Location = new Point(x, y),
      Width = width,
                Height = height,
         Font = new Font("Segoe UI", 11),
BorderStyle = BorderStyle.FixedSingle,
     BackColor = Color.White,
           ForeColor = Color.FromArgb(31, 41, 55)
            };

            // Hover effect
        txt.MouseEnter += (s, e) =>
     {
          ((TextBox)s).BackColor = Color.FromArgb(249, 250, 251);
       };

            txt.MouseLeave += (s, e) =>
            {
       if (!((TextBox)s).Focused)
      ((TextBox)s).BackColor = Color.White;
     };

            // Focus effect
            txt.GotFocus += (s, e) =>
            {
            ((TextBox)s).BackColor = Color.FromArgb(240, 253, 250);
   ((TextBox)s).BorderStyle = BorderStyle.FixedSingle;
       };

    txt.LostFocus += (s, e) =>
  {
                ((TextBox)s).BackColor = Color.White;
    };

            // Allow Enter key
    txt.KeyDown += (s, e) =>
  {
                if (e.KeyCode == Keys.Return)
      {
                e.SuppressKeyPress = true;
        BtnLogin_Click(null, null);
         }
          };

            return txt;
        }

        /// <summary>
        /// Create styled Button
        /// </summary>
        private Button CreateStyledButton(int x, int y, int width, int height, string text, Color color)
        {
            var btn = new Button
            {
     Location = new Point(x, y),
             Width = width,
        Height = height,
     Text = text,
       Font = new Font("Segoe UI", 11, FontStyle.Bold),
      BackColor = color,
           ForeColor = Color.White,
         FlatStyle = FlatStyle.Flat,
Cursor = Cursors.Hand
            };

            btn.FlatAppearance.BorderSize = 0;

         // Hover effect
          btn.MouseEnter += (s, e) =>
            {
         var button = (Button)s;
           button.BackColor = DarkenColor(button.BackColor, 20);
     };

     btn.MouseLeave += (s, e) =>
         {
          var button = (Button)s;
         button.BackColor = color;
            };

      return btn;
        }

     /// <summary>
   /// Darken color for hover effect
        /// </summary>
  private Color DarkenColor(Color color, int amount)
        {
            int r = Math.Max(0, color.R - amount);
     int g = Math.Max(0, color.G - amount);
            int b = Math.Max(0, color.B - amount);
return Color.FromArgb(r, g, b);
}

