        private void LoadCustomers()
        {
            try
            {
                if (_dgvCustomers == null) return;

                _dgvCustomers.Rows.Clear();
                foreach (var customer in _allCustomers)
                {
                    _dgvCustomers.Rows.Add(
                                customer.CustomerId,
                        customer.Name,
                    customer.PhoneNumber,
                       customer.IdNumber
                    );
                }
            }
            catch (Exception ex)
            {
                ShowError("Lỗi tải khách hàng", ex);
            }
        }

        private void LoadRoomDetails()
        {
            try
            {
                if (_dgvRooms == null) return;

                _dgvRooms.Rows.Clear();

                int stt = 1;
                foreach (var room in _selectedRooms)
                {
                    int roomNights = (int)(room.ReturnDate - room.RentalDate).TotalDays;
                    if (roomNights <= 0) roomNights = 1;
                    int roomTotal = room.RentalPrice * roomNights;

                    _dgvRooms.Rows.Add(
                  stt++,
                   room.RoomId,
                      _selectedRoom?.Name ?? room.RoomId,
                  room.RentalPrice.ToString("N0"),
                     roomTotal.ToString("N0")
                     );
                }
            }
            catch (Exception ex)
            {
                ShowError("Lỗi tải thông tin phòng", ex);
            }
        }

