        private void BtnNewCustomer_Click(object sender, EventArgs e)
        {
            ShowMessage("Tính năng tạo khách hàng mới sẽ được phát triển", "Thông báo");
        }

        private void SearchCustomers(string searchTerm)
        {
            try
            {
                if (_dgvCustomers == null) return;

                _dgvCustomers.Rows.Clear();

                if (string.IsNullOrWhiteSpace(searchTerm))
                {
                    LoadCustomers();
                    return;
                }

                string term = searchTerm.ToLower();
                var filtered = _allCustomers.Where(c =>
           c.Name.ToLower().Contains(term) ||
                 c.PhoneNumber.Contains(term) ||
                  c.IdNumber.Contains(term)
             ).ToList();

                foreach (var customer in filtered)
                {
                    _dgvCustomers.Rows.Add(
                                customer.CustomerId,
                          customer.Name,
                       customer.PhoneNumber,
                           customer.IdNumber
                            );
                }

                if (filtered.Count == 0)
                    ShowMessage($"Không tìm thấy khách hàng phù hợp với '{searchTerm}'", "Thông báo");
            }
            catch (Exception ex)
            {
                ShowError("Lỗi tìm kiếm khách hàng", ex);
            }
        }

        private void DgvCustomers_CellDoubleClick(object sender, DataGridViewCellEventArgs e)
        {
            try
            {
                if (e.RowIndex < 0) return;

                string customerId = _dgvCustomers.Rows[e.RowIndex].Cells[0].Value?.ToString();
                _selectedCustomer = _allCustomers.FirstOrDefault(c => c.CustomerId == customerId);

                if (_selectedCustomer != null)
                {
                    _lblSelectedCustomer.Text = $"✅ Đã chọn: {_selectedCustomer.Name} | SĐT: {_selectedCustomer.PhoneNumber}";
                    _lblSelectedCustomer.ForeColor = Color.FromArgb(34, 177, 76);
                    ShowMessage($"✅ Khách hàng: {_selectedCustomer.Name}", "Chọn thành công");
                }
            }
            catch (Exception ex)
            {
                ShowError("Lỗi chọn khách hàng", ex);
            }
        }

