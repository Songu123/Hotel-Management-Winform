      private bool ValidateInputs()
        {
        var tenKH = GetControlValue("txtTenKH");
      var sdt = GetControlValue("txtSDT");
            var cmnd = GetControlValue("txtCMND");

      if (string.IsNullOrWhiteSpace(tenKH))
            {
                ShowWarning("Vui lòng nhập họ tên khách hàng");
     return false;
            }

            if (string.IsNullOrWhiteSpace(sdt))
            {
  ShowWarning("Vui lòng nhập số điện thoại");
      return false;
   }

   // Validate phone number format
            if (!System.Text.RegularExpressions.Regex.IsMatch(sdt, @"^0\d{9}$"))
     {
        ShowWarning("Số điện thoại phải bắt đầu bằng 0 và có 10 chữ số");
  return false;
            }

      if (string.IsNullOrWhiteSpace(cmnd))
      {
         ShowWarning("Vui lòng nhập CMND/CCCD");
       return false;
            }

            return true;
        }

