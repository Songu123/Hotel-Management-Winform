        #region ==================== HELPERS ====================

     private string GenerateCustomerId()
    {
    // Format: KH + yyyyMMddHHmmss + milliseconds
    return $"KH{DateTime.Now:yyyyMMddHHmmss}{DateTime.Now.Millisecond:D3}";
        }

private void PopulateCustomerId()
        {
         var txtMaKH = this.Controls.Find("txtMaKH", true).FirstOrDefault() as TextBox;
            if (txtMaKH != null)
        {
       txtMaKH.Text = _customerId;
     }
        }

        private string GetControlValue(string controlName)
     {
     var ctrl = this.Controls.Find(controlName, true).FirstOrDefault() as TextBox;
            return ctrl?.Text ?? string.Empty;
        }

     private void ApplyModernStyling()
   {
       // Apply modern styling to all controls
      foreach (Control ctrl in GetAllControls(this))
     {
                if (ctrl is TextBox txt)
          {
          txt.Font = new Font("Segoe UI", 9);
   txt.BorderStyle = BorderStyle.FixedSingle;
    }
        else if (ctrl is Label lbl)
      {
          lbl.Font = new Font("Segoe UI", 9);
        lbl.ForeColor = Color.FromArgb(60, 60, 60);
    }
        else if (ctrl is Button btn)
          {
            btn.Font = new Font("Segoe UI", 9, FontStyle.Bold);
              btn.FlatStyle = FlatStyle.Flat;
    }
      else if (ctrl is DateTimePicker dtp)
   {
 dtp.Font = new Font("Segoe UI", 9);
        }
   else if (ctrl is RadioButton rb)
{
         rb.Font = new Font("Segoe UI", 9);
                }
            }
   }

        private IEnumerable<Control> GetAllControls(Control container)
        {
     foreach (Control ctrl in container.Controls)
            {
    yield return ctrl;
  foreach (var child in GetAllControls(ctrl))
          {
     yield return child;
     }
            }
 }

