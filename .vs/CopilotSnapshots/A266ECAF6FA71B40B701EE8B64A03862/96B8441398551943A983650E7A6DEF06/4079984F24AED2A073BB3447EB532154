  private async void BtnLuu_Click(object sender, EventArgs e)
     {
        try
  {
       // Validation
     if (!ValidateInputs())
 return;

 if (_customerService == null)
           {
    ShowError("Dịch vụ khách hàng không khả dụng");
               return;
     }

            // Get input values
   var tenKH = GetControlValue("txtTenKH");
             var sdt = GetControlValue("txtSDT");
        var cmnd = GetControlValue("txtCMND");
            var dtpNgaySinh = this.Controls.Find("dtpNgaySinh", true).FirstOrDefault() as DateTimePicker;
                var rbNam = this.Controls.Find("rbNam", true).FirstOrDefault() as RadioButton;
    var txtDuong = GetControlValue("txtDuong");
 var txtPhuongThon = GetControlValue("txtPhuongThon");
   var txtQuanHuyen = GetControlValue("txtQuanHuyen");
  var txtTinhThanh = GetControlValue("txtTinhThanh");
     var txtQuocTich = GetControlValue("txtQuocTich");

     // Build address
   var address = $"{txtDuong}, {txtPhuongThon}, {txtQuanHuyen}, {txtTinhThanh}";

    // Create customer request
      var customerRequest = new CustomerCreateRequest
         {
        CustomerId = _customerId,
  Name = tenKH,
         PhoneNumber = sdt,
      IdNumber = cmnd,
      Gender = rbNam?.Checked == true ? 1 : 0,
     DateOfBirth = dtpNgaySinh?.Value ?? DateTime.Now,
         Address = address.TrimEnd(','),
     Nationality = txtQuocTich
   };

System.Diagnostics.Debug.WriteLine($"[CreateCustomer] Creating customer: {customerRequest.Name}");

      // Create customer via service
     var result = await _customerService.CreateCustomerAsync(customerRequest);

                if (result != null)
      {
     _createdCustomer = new Customer
    {
       CustomerId = result.CustomerId,
        Name = result.Name,
     PhoneNumber = result.PhoneNumber,
           IdNumber = result.IdNumber,
     Gender = result.Gender,
            DateOfBirth = result.DateOfBirth,
        Address = result.Address,
          Nationality = result.Nationality,
      IsDeleted = 0
         };

  ShowSuccess($"✅ Khách hàng {tenKH} đã được tạo thành công!\n\nMã khách: {_customerId}");
      this.DialogResult = DialogResult.OK;
            this.Close();
      }
 else
        {
  ShowError("Không thể tạo khách hàng. Vui lòng thử lại.");
    }
            }
 catch (Exception ex)
            {
   System.Diagnostics.Debug.WriteLine($"[CreateCustomer] Error: {ex.Message}");
       ShowError("Lỗi tạo khách hàng", ex);
      }
     }

