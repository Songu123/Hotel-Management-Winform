        /// <summary>
   /// Load existing room data for edit
        /// </summary>
    private void LoadRoomData()
        {
         if (_editingRoom == null) return;

      TextBox tbxRoomNo = this.Controls.Find("tbxRoomNo", true).FirstOrDefault() as TextBox;
      TextBox tbxPrice = this.Controls.Find("tbxPrice", true).FirstOrDefault() as TextBox;
       TextBox tbxNotes = this.Controls.Find("tbxNotes", true).FirstOrDefault() as TextBox;
       ComboBox cbxRoomType = this.Controls.Find("cbxRoomType", true).FirstOrDefault() as ComboBox;
 ComboBox cbxFloor = this.Controls.Find("cbxFloor", true).FirstOrDefault() as ComboBox;
       ComboBox cbxStatus = this.Controls.Find("cbxStatus", true).FirstOrDefault() as ComboBox;

     if (tbxRoomNo != null) tbxRoomNo.Text = _editingRoom.RoomNumber;
     if (tbxPrice != null) tbxPrice.Text = _editingRoom.Price.ToString();
          if (tbxNotes != null) tbxNotes.Text = "";

   if (cbxRoomType != null) cbxRoomType.SelectedItem = _editingRoom.Type;
 if (cbxFloor != null) cbxFloor.SelectedIndex = _editingRoom.Floor - 1;

          if (cbxStatus != null)
       {
         var statusStr = _editingRoom.Status switch
     {
     UCRooms.RoomStatus.Available => "Available",
     UCRooms.RoomStatus.Occupied => "Occupied",
 UCRooms.RoomStatus.Reserved => "Reserved",
  UCRooms.RoomStatus.Maintenance => "Maintenance",
        _ => "Available"
     };
  cbxStatus.SelectedItem = statusStr;
 }
        }

    /// <summary>
        /// Handle Save button click
  /// </summary>
private async void BtnSave_Click(object sender, EventArgs e)
        {
  try
     {
       // Validate inputs
    TextBox tbxRoomNo = this.Controls.Find("tbxRoomNo", true).FirstOrDefault() as TextBox;
       TextBox tbxPrice = this.Controls.Find("tbxPrice", true).FirstOrDefault() as TextBox;
   ComboBox cbxRoomType = this.Controls.Find("cbxRoomType", true).FirstOrDefault() as ComboBox;
      ComboBox cbxFloor = this.Controls.Find("cbxFloor", true).FirstOrDefault() as ComboBox;

    if (string.IsNullOrWhiteSpace(tbxRoomNo?.Text))
            {
       MessageBox.Show("Room Number is required!", "Validation Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
     return;
           }

     if (!decimal.TryParse(tbxPrice?.Text, out var price))
          {
     MessageBox.Show("Price must be a valid number!", "Validation Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
         return;
  }

    if (cbxRoomType?.SelectedItem == null)
            {
 MessageBox.Show("Room Type is required!", "Validation Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
        return;
 }

       if (cbxFloor?.SelectedItem == null)
           {
         MessageBox.Show("Floor is required!", "Validation Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
    return;
   }

        if (_roomService == null)
              {
MessageBox.Show("Room Service not available!", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
   return;
          }

      var selectedFloor = cbxFloor.SelectedIndex + 1;

       if (_isEditMode && _editingRoom != null)
          {
  // Update existing room
           var roomToUpdate = new Room
        {
        RoomId = _editingRoom.RoomId,
     RoomNumber = tbxRoomNo.Text,
     RoomTypeId = _roomTypes.FirstOrDefault(rt => rt.Name == cbxRoomType.SelectedItem?.ToString())?.RoomTypeId ?? 1,
    FloorId = selectedFloor,
             Status = GetStatusFromString(this.Controls.Find("cbxStatus", true).FirstOrDefault() as ComboBox),
     Notes = (this.Controls.Find("tbxNotes", true).FirstOrDefault() as TextBox)?.Text ?? ""
   };

     bool updated = await _roomService.UpdateRoomAsync(roomToUpdate);
        if (updated)
              {
           this.DialogResult = DialogResult.OK;
           this.Close();
     }
       else
          {
MessageBox.Show("Failed to update room!", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
     }
    }
      else
            {
      // Add new room
      var newRoom = new Room
     {
      RoomNumber = tbxRoomNo.Text,
      RoomTypeId = _roomTypes.FirstOrDefault(rt => rt.Name == cbxRoomType.SelectedItem?.ToString())?.RoomTypeId ?? 1,
     FloorId = selectedFloor,
        Status = RoomStatus.Available,
        Notes = (this.Controls.Find("tbxNotes", true).FirstOrDefault() as TextBox)?.Text ?? ""
       };

     var created = await _roomService.CreateRoomAsync(newRoom);
  if (created != null)
         {
            this.DialogResult = DialogResult.OK;
          this.Close();
  }
      else
       {
  MessageBox.Show("Failed to add room!", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
   }
          }
   }
        catch (Exception ex)
          {
      MessageBox.Show($"Error: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
    }
        }

      /// <summary>
      /// Convert status string to enum
        /// </summary>
     private RoomStatus GetStatusFromString(ComboBox cbxStatus)
        {
var selectedStatus = cbxStatus?.SelectedItem?.ToString() ?? "Available";
        return selectedStatus switch
    {
        "Occupied" => RoomStatus.Occupied,
         "Reserved" => RoomStatus.Reserved,
   "Maintenance" => RoomStatus.Maintenance,
            _ => RoomStatus.Available
   };
        }
    }
