          try
            {
                await LoadRoomDataFromDatabaseAsync();
    LoadRoomsToGrid();
                TextBox tbxSearch = this.Controls.Find("tbxSearchRoom", true).FirstOrDefault() as TextBox;
ComboBox cbxType = this.Controls.Find("cbxRoomType", true).FirstOrDefault() as ComboBox;
