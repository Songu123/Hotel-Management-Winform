       InitializeComboBoxes();
    LoadRoomsToGrid();
          AttachEventHandlers();
    }
        }

   /// <summary>
  /// Load room data from database
 /// </summary>
   private async Task LoadRoomDataFromDatabaseAsync()
 {
  try
    {
     allRooms.Clear();

   if (_roomService == null)
    {
        InitializeRoomData();
   return;
     }

         var dbRooms = await _roomService.GetAllRoomsAsync();
      var roomTypes = (await _roomService.GetAllRoomTypesAsync()).ToList();
 _roomTypes = roomTypes;

      foreach (var dbRoom in dbRooms)
     {
      var roomInfo = new RoomInfo
        {
   RoomId = dbRoom.RoomId,
     RoomNumber = dbRoom.RoomNumber,
          Type = dbRoom.RoomType?.Name ?? "Unknown",
       Floor = dbRoom.Floor?.FloorNumber ?? ExtractFloorFromRoomNumber(dbRoom.RoomNumber),
     Status = GetRoomStatus(dbRoom.Status),
    Price = (double)(dbRoom.RoomType?.PricePerNight ?? 0),
         Guest = "-",
  CheckIn = "-",
         CheckOut = "-",
  RoomTypeId = dbRoom.RoomTypeId,
       FloorId = dbRoom.FloorId,
 DbStatus = dbRoom.Status
         };

  allRooms.Add(roomInfo);
      }
      }
  catch (Exception ex)
 {
        MessageBox.Show($"Error loading from database: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
     InitializeRoomData();
  }
        }

        /// <summary>
        /// Convert RoomStatus enum to display string
        /// </summary>
        private RoomStatus GetRoomStatus(Models.RoomStatus dbStatus)
        {
         return dbStatus switch
            {
              Models.RoomStatus.Available => RoomStatus.Available,
          Models.RoomStatus.Occupied => RoomStatus.Occupied,
       Models.RoomStatus.Reserved => RoomStatus.Reserved,
     Models.RoomStatus.Maintenance => RoomStatus.Maintenance,
       _ => RoomStatus.Available
            };
        }

     /// <summary>
        /// Extract floor number from room number
        /// </summary>
     private int ExtractFloorFromRoomNumber(string roomNumber)
     {
        if (string.IsNullOrEmpty(roomNumber) || roomNumber.Length < 1)
          return 1;

if (int.TryParse(roomNumber[0].ToString(), out var floor))
       return floor;

      return 1;
        }

