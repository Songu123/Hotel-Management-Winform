          new RoomInfo { RoomNumber = "102", Type = "Double", Floor = 1, Status = RoomStatus.Occupied, Price = 80, Guest = "Nguyễn Văn A", CheckIn = "2024-01-15", CheckOut = "2024-01-18" },
                new RoomInfo { RoomNumber = "103", Type = "Suite", Floor = 1, Status = RoomStatus.Available, Price = 150, Guest = "-", CheckIn = "-", CheckOut = "-" },
