namespace QuanLyKhachSan.UI
{
    public partial class UCRooms : UserControl
    {
        // Room data model
 private List<RoomInfo> allRooms = new List<RoomInfo>();

        public UCRooms()
        {
      InitializeComponent();
        }

     private void UCRooms_Load(object sender, EventArgs e)
        {
 InitializeRoomData();
         LoadRoomsToGrid();
      AttachEventHandlers();
        }

