using QuanLyKhachSan.Models;

namespace QuanLyKhachSan.Repositories.Interfaces
{
    /// <summary>
    /// Repository interface cho Invoice entity
    /// </summary>
    public interface IInvoiceRepository : IRepository<Invoice>
    {
     /// <summary>
        /// Lấy hóa đơn theo số hóa đơn
        /// </summary>
        Task<Invoice?> GetByInvoiceNumberAsync(string invoiceNumber);

/// <summary>
        /// Lấy hóa đơn theo trạng thái
        /// </summary>
 Task<IEnumerable<Invoice>> GetByStatusAsync(InvoiceStatus status);

        /// <summary>
      /// Lấy hóa đơn của booking
        /// </summary>
     Task<IEnumerable<Invoice>> GetByBookingAsync(int bookingId);

  /// <summary>
        /// Lấy hóa đơn của khách hàng
   /// </summary>
        Task<IEnumerable<Invoice>> GetByCustomerAsync(int customerId);

      /// <summary>
     /// Lấy hóa đơn theo khoảng ngày
    /// </summary>
        Task<IEnumerable<Invoice>> GetByDateRangeAsync(DateTime startDate, DateTime endDate);

    /// <summary>
        /// Lấy hóa đơn chưa thanh toán
  /// </summary>
        Task<IEnumerable<Invoice>> GetUnpaidInvoicesAsync();

 /// <summary>
  /// Lấy hóa đơn với chi tiết (InvoiceDetails)
  /// </summary>
      Task<Invoice?> GetInvoiceWithDetailsAsync(int invoiceId);

      /// <summary>
        /// Tính doanh thu trong khoảng ngày
 /// </summary>
   Task<decimal> GetRevenueByDateRangeAsync(DateTime startDate, DateTime endDate);

 /// <summary>
   /// Tính tổng doanh thu theo trạng thái
    /// </summary>
     Task<decimal> GetRevenueByStatusAsync(InvoiceStatus status);

 /// <summary>
     /// Tạo số hóa đơn mới
 /// </summary>
        Task<string> GenerateInvoiceNumberAsync();
    }
}
