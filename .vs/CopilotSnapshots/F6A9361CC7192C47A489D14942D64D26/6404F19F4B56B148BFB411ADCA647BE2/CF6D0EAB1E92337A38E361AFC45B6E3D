        /// <summary>
        /// Apply border and shadow effect to textbox
        /// </summary>
        private void ApplyTextBoxStyle(TextBox txt)
        {
            // Add border effect using panel
            var pnlBorder = new Panel
            {
                Location = txt.Location,
                Width = txt.Width,
                Height = txt.Height,
                BackColor = Color.White,
                BorderStyle = BorderStyle.FixedSingle
            };
            pnlBorder.Controls.Add(txt);
            txt.Location = new Point(0, 0);
            txt.Width = pnlBorder.Width - 2;
            txt.Height = pnlBorder.Height - 2;
            txt.BorderStyle = BorderStyle.None;

            // Hover effect
            txt.MouseEnter += (s, e) =>
   {
       if (!txt.Focused)
           pnlBorder.BackColor = Color.FromArgb(249, 250, 251);
   };

            txt.MouseLeave += (s, e) =>
            {
                if (!txt.Focused)
                    pnlBorder.BackColor = Color.White;
            };

            txt.GotFocus += (s, e) =>
                {
                    pnlBorder.BackColor = Color.FromArgb(240, 253, 250);
                };

            txt.LostFocus += (s, e) =>
               {
                   pnlBorder.BackColor = Color.White;
               };

            txt.KeyDown += (s, e) =>
             {
                 if (e.KeyCode == Keys.Return)
                 {
                     e.SuppressKeyPress = true;
                     BtnLogin_Click(null, null);
                 }
             };
        }

