        private async void BtnLuuPhieuThue_Click(object sender, EventArgs e)
        {
            try
            {
                // ==================== VALIDATION ====================

                // ✅ BƯỚC 1: Kiểm tra phòng TRƯỚC (đã được fix)
                if (_selectedRooms == null || _selectedRooms.Count == 0)
                {
                    MessageBox.Show("Vui lòng chọn ít nhất một phòng", "Cảnh báo",
                        MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }

                // ✅ Debug log
                System.Diagnostics.Debug.WriteLine($"Total rooms in _selectedRooms: {_selectedRooms.Count}");

                // ✅ BƯỚC 2: Validate CMND
                string cmnd = txtCMND.Text.Trim();
                if (string.IsNullOrEmpty(cmnd))
                {
                    MessageBox.Show("Vui lòng nhập CMND/CCCD", "Cảnh báo",
                       MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtCMND.Focus();
                    return;
                }

                // ✅ Kiểm tra CMND chỉ là số
                if (!long.TryParse(cmnd, out _))
                {
                    MessageBox.Show("CMND/CCCD phải là số", "Cảnh báo",
                             MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtCMND.Focus();
                    return;
                }

                // ✅ BƯỚC 3: Validate customer name
                string customerName = txtHoTenKhachHang.Text.Trim();
                if (string.IsNullOrEmpty(customerName) && _isNewCustomer)
                {
                    MessageBox.Show("Vui lòng nhập tên khách hàng", "Cảnh báo",
                        MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtHoTenKhachHang.Focus();
                    return;
                }

                // ✅ BƯỚC 4: Validate phone number
                string phoneNumber = txtSoDienThoai.Text.Trim();
                if (string.IsNullOrEmpty(phoneNumber))
                {
                    MessageBox.Show("Vui lòng nhập số điện thoại", "Cảnh báo",
                        MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtSoDienThoai.Focus();
                    return;
                }

                if (!long.TryParse(phoneNumber, out _))
                {
                    MessageBox.Show("Số điện thoại phải là số", "Cảnh báo",
                        MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtSoDienThoai.Focus();
                    return;
                }

                // ✅ BƯỚC 5: Validate age
                int age = DateTime.Now.Year - dtpNgaySinh.Value.Year;
                if (dtpNgaySinh.Value.Date > DateTime.Now.AddYears(-age))
                    age--;

                if (age < 18)
                {
                    MessageBox.Show("Khách hàng phải trên 18 tuổi", "Cảnh báo",
                        MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    dtpNgaySinh.Focus();
                    return;
                }

                // ✅ BƯỚC 6: Validate deposit amount
                if (!int.TryParse(txtTienDatCoc.Text, out int depositAmount) || depositAmount < 0)
                {
                    MessageBox.Show("Tiền đặt cọc không hợp lệ (chỉ nhập số)", "Cảnh báo",
                        MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtTienDatCoc.Focus();
                    return;
                }

                // ✅ BƯỚC 7: Validate processing status
                if (cboTinhTrangXuLy.SelectedIndex < 0)
                {
                    MessageBox.Show("Vui lòng chọn tình trạng xử lý", "Cảnh báo",
                        MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    cboTinhTrangXuLy.Focus();
                    return;
                }

                // ==================== CREATE/UPDATE CUSTOMER ====================

                string customerId = txtMaKhachHang.Text.Trim();
                Customer currentCustomer = null;

                if (_isNewCustomer)
                {
                    // Tạo khách hàng mới
                    currentCustomer = new Customer
                    {
                        CustomerId = customerId,
                        Name = customerName,
                        IdNumber = cmnd,
                        PhoneNumber = phoneNumber,
                        DateOfBirth = dtpNgaySinh.Value,
                        Gender = rdoNam.Checked ? 0 : 1,
                        Address = $"{txtDuong.Text}, {txtPhuongThon.Text}, {txtQuanHuyen.Text}, {txtTinhThanh.Text}",
                        Nationality = txtQuocTich.Text,
                        IsDeleted = 0
                    };

                    // Lưu khách hàng mới vào database
                    try
                    {
                        await _customerService.CreateCustomerAsync(currentCustomer);
                        System.Diagnostics.Debug.WriteLine($"Customer created: {customerId}");
                    }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine($"Error creating customer: {ex.Message}");
                        MessageBox.Show($"Lỗi tạo khách hàng: {ex.Message}", "Lỗi",
                            MessageBoxButtons.OK, MessageBoxIcon.Error);
                        return;
                    }
                }
                else
                {
                    // Khách hàng đã tồn tại
                    currentCustomer = _customers.FirstOrDefault(c => c.CustomerId == customerId);
                    if (currentCustomer == null)
                    {
                        MessageBox.Show("Khách hàng không tồn tại", "Lỗi",
                                MessageBoxButtons.OK, MessageBoxIcon.Error);
                        return;
                    }
                }

                // ==================== SAVE RENTAL DETAIL ====================

                var rentalDetailId = txtMaChiTietThue.Text.Trim();

                var rentalDetail = new RentalDetail
                {
                    RentalDetailId = rentalDetailId,
                    CustomerId = customerId,
                    EmployeeId = txtNhanVienLapPhieu.Text.Trim(),
                    CreatedDate = dtpNgayLapPhieu.Value,
                    DepositAmount = depositAmount,
                    ProcessingStatus = cboTinhTrangXuLy.SelectedIndex,
                    IsDeleted = 0
                };

                if (_rentalDetailService == null)
                {
                    MessageBox.Show("Lỗi: Service không khả dụng", "Lỗi",
                           MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }

                var savedRentalDetail = await _rentalDetailService.CreateRentalDetailAsync(rentalDetail);
                if (savedRentalDetail == null)
                {
                    MessageBox.Show("Không thể lưu phiếu thuê vào database", "Lỗi",
                         MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }

                // Add RentalDetailId to room details
                foreach (var room in _selectedRooms)
                {
                    room.RentalDetailId = rentalDetailId;
                }

                // Save RoomRentalDetails
                var roomsSaved = await _roomRentalDetailService.AddRoomRentalDetailsAsync(_selectedRooms);
                if (!roomsSaved)
                {
                    MessageBox.Show("Không thể lưu chi tiết phòng vào database", "Lỗi",
                        MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }

                // ==================== PRINT RECEIPT ====================

                if (_printService != null)
                {
                    try
                    {
                        await _printService.PrintRentalDetailAsync(savedRentalDetail, _selectedRooms);

                        MessageBox.Show($"✓ Phiếu thuê được tạo thành công\n" +
                              $"Mã phiếu: {rentalDetailId}\n" +
                         $"Khách hàng: {customerId}\n" +
                                   $"Tổng tiền: {lblTongCongValue.Text}\n\n" +
                                 $"Phiếu thuê đã được in",
                             "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                    catch (Exception printEx)
                    {
                        System.Diagnostics.Debug.WriteLine($"Print error: {printEx.Message}");
                        MessageBox.Show("Phiếu thuê được lưu nhưng không thể in. Vui lòng kiểm tra.", "Cảnh báo",
                                 MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    }
                }
                else
                {
                    MessageBox.Show($"✓ Phiếu thuê được tạo thành công\n" +
                       $"Mã phiếu: {rentalDetailId}\n" +
                     $"Khách hàng: {customerId}\n" +
                      $"Tổng tiền: {lblTongCongValue.Text}",
                    "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }

                IsConfirmed = true;
                this.DialogResult = DialogResult.OK;
                this.Close();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi lưu phiếu thuê: {ex.Message}\n\nStack: {ex.StackTrace}", "Lỗi",
                          MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void DgvRooms_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            try
            {
                if (e.ColumnIndex == dgvRooms.Columns["Xoa"].Index && e.RowIndex >= 0)
                {
                    var result = MessageBox.Show("Bạn có chắc chắn muốn xóa phòng này khỏi danh sách?", "Xác nhận",
                MessageBoxButtons.YesNo, MessageBoxIcon.Question);

                    if (result == DialogResult.Yes)
                    {
                        var roomId = dgvRooms.Rows[e.RowIndex].Cells["MaPhong"].Value.ToString();
                        _selectedRooms.RemoveAll(r => r.RoomId == roomId);
                        dgvRooms.Rows.RemoveAt(e.RowIndex);

                        for (int i = 0; i < dgvRooms.Rows.Count; i++)
                        {
                            dgvRooms.Rows[i].Cells["STT"].Value = i + 1;
                        }

                        UpdateTotalPrice();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi",
          MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void UpdateTotalPrice()
        {
            try
            {
                decimal totalPrice = 0;

                foreach (DataGridViewRow row in dgvRooms.Rows)
                {
                    var priceStr = row.Cells["GiaPhong"].Value?.ToString();
                    if (priceStr != null)
                    {
                        var cleanPrice = System.Text.RegularExpressions.Regex.Replace(priceStr, @"[^\d]", "");
                        if (int.TryParse(cleanPrice, out int price))
                        {
                            totalPrice += price;
                        }
                    }
                }

                lblTongCongValue.Text = $"{totalPrice:N0} VNĐ";
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error updating total price: {ex.Message}");
            }
        }

