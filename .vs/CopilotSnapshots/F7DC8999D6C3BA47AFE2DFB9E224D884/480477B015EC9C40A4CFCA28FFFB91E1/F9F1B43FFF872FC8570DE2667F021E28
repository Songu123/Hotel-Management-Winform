        /// <summary>
        /// ✅ FIX: Chỉ hiển thị phòng đã có trong _selectedRooms, không thêm nữa
        /// </summary>
        private void DisplayRentalDetails()
        {
            try
            {
                dgvRooms.Rows.Clear();

                // ✅ Kiểm tra nếu không có phòng nào trong danh sách
                if (_selectedRooms.Count == 0)
                {
                    System.Diagnostics.Debug.WriteLine("Warning: No rooms in _selectedRooms to display");
                    return;
                }

                // ✅ Hiển thị tất cả phòng trong _selectedRooms
                int rowIndex = 1;
                foreach (var roomDetail in _selectedRooms)
                {
                    var nights = (int)(roomDetail.ReturnDate - roomDetail.RentalDate).TotalDays;
                    var totalPrice = roomDetail.RentalPrice * nights;

                    // Lấy thông tin phòng từ _selectedRoom hoặc service
                    string roomName = _selectedRoom?.RoomId == roomDetail.RoomId ?
                                     _selectedRoom.Name : roomDetail.RoomId;

                    int roomStatus = _selectedRoom?.RoomId == roomDetail.RoomId ?
                                    _selectedRoom.Status : 0;

                    dgvRooms.Rows.Add(
                        rowIndex++,
                        roomDetail.RoomId,
                        roomName,
                        GetRoomStatus(roomStatus),
                        "Theo ngày",
                        roomDetail.RentalDate.ToString("dd/MM/yyyy HH:mm:ss"),
                        roomDetail.ReturnDate.ToString("dd/MM/yyyy HH:mm:ss"),
                        "",
                        $"{totalPrice:N0} VNĐ"
                    );
                }

                UpdateTotalPrice();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi hiển thị chi tiết thuê: {ex.Message}", "Lỗi",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private string GetRoomStatus(int status)
        {
            return status switch
            {
                0 => "Trống",
                1 => "Đã có khách",
                2 => "Đang dọn dẹp",
                3 => "Đang bảo trì",
                _ => "Không xác định"
            };
        }

