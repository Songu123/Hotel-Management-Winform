    /// <summary>
        /// Display rental details
     /// </summary>
        private void DisplayRentalDetails()
        {
     try
{
      if (_selectedRoom == null)
   return;

    dgvRooms.Rows.Clear();

      var rentalDetail = new RoomRentalDetail
        {
                  RoomId = _selectedRoom.RoomId,
        RentalDate = _checkInDate,
     ReturnDate = _checkOutDate,
      RentalPrice = _selectedRoom.Price,
           RentalType = 0,
           Status = 0
            };

       _selectedRooms.Add(rentalDetail);

         var nights = (int)(_checkOutDate - _checkInDate).TotalDays;
            var totalPrice = _selectedRoom.Price * nights;

      dgvRooms.Rows.Add(
           dgvRooms.Rows.Count + 1,
         _selectedRoom.RoomId,
     _selectedRoom.Name,
          GetRoomStatus(_selectedRoom.Status),
            "Theo ngày",
      _checkInDate.ToString("dd/MM/yyyy HH:mm:ss"),
          _checkOutDate.ToString("dd/MM/yyyy HH:mm:ss"),
             "",
           $"{totalPrice:N0} VNĐ"
       );

UpdateTotalPrice();
      }
         catch (Exception ex)
   {
   MessageBox.Show($"Lỗi hiển thị chi tiết thuê: {ex.Message}", "Lỗi",
                MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
        }

        /// <summary>
        /// Get room status name
        /// </summary>
        private string GetRoomStatus(int status)
        {
          return status switch
    {
       0 => "Trống",
    1 => "Đã có khách",
            2 => "Đang dọn dẹp",
    3 => "Đang bảo trì",
        _ => "Không xác định"
            };
 }

