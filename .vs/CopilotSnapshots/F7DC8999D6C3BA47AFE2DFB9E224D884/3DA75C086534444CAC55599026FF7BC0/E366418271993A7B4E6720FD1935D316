     /// <summary>
        /// Kiểm tra ngày sinh (phải ≥ 18 tuổi)
      /// </summary>
        private void DtpNgaySinh_ValueChanged(object sender, EventArgs e)
        {
            try
    {
                int age = DateTime.Now.Year - dtpNgaySinh.Value.Year;
          if (dtpNgaySinh.Value.Date > DateTime.Now.AddYears(-age))
         age--;

       if (age < 18)
     {
           MessageBox.Show("Khách hàng phải trên 18 tuổi", "Cảnh báo",
   MessageBoxButtons.OK, MessageBoxIcon.Warning);
           dtpNgaySinh.Value = DateTime.Now.AddYears(-18);
     }
   }
          catch (Exception ex)
   {
       System.Diagnostics.Debug.WriteLine($"Error checking age: {ex.Message}");
            }
        }

    /// <summary>
      /// CMND TextChanged - Tìm khách hàng trong database
  /// </summary>
        private void TxtCMND_TextChanged(object sender, EventArgs e)
 {
     try
            {
     string cmnd = txtCMND.Text.Trim();
      if (string.IsNullOrEmpty(cmnd))
     {
        ClearCustomerInfo();
     return;
      }

    // Tìm khách hàng theo CMND từ service
  var customer = _customers.FirstOrDefault(c => c.IdNumber == cmnd);
 
              if (customer != null)
      {
     // ✅ Tìm thấy - Tự động điền thông tin
     _isNewCustomer = false;
         PopulateCustomerInfo(customer);
  
            // Tự động sinh mã khách hàng từ customer đã tìm
  txtMaKhachHang.Text = customer.CustomerId;
      }
       else
            {
   // ❌ Không tìm thấy - Chuẩn bị tạo khách hàng mới
     _isNewCustomer = true;
                    ClearCustomerInfo();
      // Để người dùng nhập các thông tin khác
      }
      }
        catch (Exception ex)
       {
         System.Diagnostics.Debug.WriteLine($"Error loading customer info: {ex.Message}");
         }
        }

        /// <summary>
        /// Tự động điền thông tin khách hàng
        /// </summary>
private void PopulateCustomerInfo(Customer customer)
    {
            try
  {
       txtMaKhachHang.Text = customer.CustomerId;
         txtHoTenKhachHang.Text = customer.Name;
       txtCMND.Text = customer.IdNumber;
          txtSoDienThoai.Text = customer.PhoneNumber;
      dtpNgaySinh.Value = customer.DateOfBirth;
  
       // Parse address
       if (!string.IsNullOrEmpty(customer.Address))
       {
 var addressParts = customer.Address.Split(',');
     if (addressParts.Length > 0) txtDuong.Text = addressParts[0].Trim();
          if (addressParts.Length > 1) txtPhuongThon.Text = addressParts[1].Trim();
      if (addressParts.Length > 2) txtQuanHuyen.Text = addressParts[2].Trim();
             if (addressParts.Length > 3) txtTinhThanh.Text = addressParts[3].Trim();
       }

                txtQuocTich.Text = customer.Nationality;

     // Set gender
        if (customer.Gender == 0)
 rdoNam.Checked = true;
          else
          rdoNu.Checked = true;
         }
  catch (Exception ex)
            {
       System.Diagnostics.Debug.WriteLine($"Error populating customer info: {ex.Message}");
        }
        }

      /// <summary>
        /// Xóa thông tin khách hàng
        /// </summary>
      private void ClearCustomerInfo()
        {
            try
        {
                // Chỉ xóa info của khách, mã KH giữ lại
         txtHoTenKhachHang.Text = "";
      txtSoDienThoai.Text = "";
   txtDuong.Text = "";
              txtPhuongThon.Text = "";
      txtQuanHuyen.Text = "";
        txtTinhThanh.Text = "";
    txtQuocTich.Text = "";
        dtpNgaySinh.Value = DateTime.Now.AddYears(-18);
    rdoNam.Checked = true;
            }
   catch (Exception ex)
            {
  System.Diagnostics.Debug.WriteLine($"Error clearing customer info: {ex.Message}");
        }
        }

