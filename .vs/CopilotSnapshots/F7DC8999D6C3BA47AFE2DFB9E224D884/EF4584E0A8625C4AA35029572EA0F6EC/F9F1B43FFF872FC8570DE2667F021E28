        /// <summary>
        /// Display rental details (add the selected room)
        /// </summary>
        private void DisplayRentalDetails()
        {
            try
            {
                if (_selectedRoom == null)
                    return;

                // Clear existing rows
                dgvRooms.Rows.Clear();

                // Create rental detail for the selected room
                var rentalDetail = new RoomRentalDetail
                {
                    RoomId = _selectedRoom.RoomId,
                    RentalDate = _checkInDate,
                    ReturnDate = _checkOutDate,
                    RentalPrice = _selectedRoom.Price,
                    RentalType = 0, // 0 = Theo ngày (by day)
                    Status = 0
                };

                _selectedRooms.Add(rentalDetail);

                // Add to DataGridView
                var nights = (int)(_checkOutDate - _checkInDate).TotalDays;
                var totalPrice = _selectedRoom.Price * nights;

                dgvRooms.Rows.Add(
                   dgvRooms.Rows.Count + 1,
             _selectedRoom.RoomId,
             _selectedRoom.Name,
                  GetRoomStatus(_selectedRoom.Status),
           "Theo ngày",
               _checkInDate.ToString("dd/MM/yyyy HH:mm:ss"),
           _checkOutDate.ToString("dd/MM/yyyy HH:mm:ss"),
             "",
          $"{totalPrice:N0} VNĐ"
         );

                // Update total price
                UpdateTotalPrice();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi hiển thị chi tiết thuê: {ex.Message}", "Lỗi",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        /// <summary>
        /// Get room status name
        /// </summary>
        private string GetRoomStatus(int status)
        {
            return status switch
            {
                0 => "Trống",
                1 => "Đã có khách",
                2 => "Đang dọn dẹp",
                3 => "Đang bảo trì",
                _ => "Không xác định"
            };
        }

        /// <summary>
        /// Handle customer ID text changed
        /// </summary>
        private void TxtMaKhachHang_TextChanged(object sender, EventArgs e)
        {
            try
            {
                var customerId = txtMaKhachHang.Text.Trim();
                if (string.IsNullOrEmpty(customerId))
                    return;

                // Find customer by ID
                var customer = _customers.FirstOrDefault(c => c.CustomerId == customerId);
                if (customer != null)
                {
                    // Auto-populate customer information
                    txtHoTenKhachHang.Text = customer.Name;
                    txtCMND.Text = customer.IdNumber;
                    txtSoDienThoai.Text = customer.PhoneNumber;
                    dtpNgaySinh.Value = customer.DateOfBirth;

                    // Parse address
                    if (!string.IsNullOrEmpty(customer.Address))
                    {
                        var addressParts = customer.Address.Split(',');
                        if (addressParts.Length > 0) txtDuong.Text = addressParts[0].Trim();
                        if (addressParts.Length > 1) txtPhuongThon.Text = addressParts[1].Trim();
                        if (addressParts.Length > 2) txtQuanHuyen.Text = addressParts[2].Trim();
                        if (addressParts.Length > 3) txtTinhThanh.Text = addressParts[3].Trim();
                    }

                    txtQuocTich.Text = customer.Nationality;

                    // Set gender
                    if (customer.Gender == 0)
                        rdoNam.Checked = true;
                    else
                        rdoNu.Checked = true;
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error loading customer info: {ex.Message}");
            }
        }

