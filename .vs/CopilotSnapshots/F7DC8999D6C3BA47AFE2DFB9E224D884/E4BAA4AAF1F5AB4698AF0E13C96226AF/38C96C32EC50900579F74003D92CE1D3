        /// <summary>
        /// CMND TextChanged - Tìm khách từ CMND
        /// </summary>
        private void TxtCMND_TextChanged(object sender, EventArgs e)
        {
            try
            {
                string cmnd = txtCMND.Text.Trim();

                if (string.IsNullOrEmpty(cmnd))
                {
                    ClearCustomerInfo();
                    _isNewCustomer = true;
                    return;
                }

                // ✅ Tìm khách từ CMND
                var customer = _customers.FirstOrDefault(c => c.IdNumber == cmnd);

                if (customer != null)
                {
                    // ✅ Tìm thấy - Load thông tin
                    _isNewCustomer = false;
                    PopulateCustomerInfo(customer);
                    System.Diagnostics.Debug.WriteLine($"✅ Customer found by CMND: {customer.CustomerId}");
                }
                else
                {
                    // ❌ Không tìm thấy - Chuẩn bị tạo mới
                    _isNewCustomer = true;
                    ClearCustomerInfo();
                    System.Diagnostics.Debug.WriteLine($"❌ Customer not found by CMND: {cmnd}");
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error in TxtCMND_TextChanged: {ex.Message}");
            }
        }

        /// <summary>
        /// SĐT TextChanged - Tìm khách từ SĐT (nếu CMND không tìm thấy)
        /// </summary>
        private void TxtSoDienThoai_TextChanged(object sender, EventArgs e)
        {
            try
            {
                // Nếu đã tìm thấy khách từ CMND, không cần tìm từ SĐT
                if (!_isNewCustomer)
                    return;

                string phoneNumber = txtSoDienThoai.Text.Trim();

                if (string.IsNullOrEmpty(phoneNumber))
                    return;

                // ✅ Tìm khách từ SĐT
                var customer = _customers.FirstOrDefault(c => c.PhoneNumber == phoneNumber);

                if (customer != null)
                {
                    // ✅ Tìm thấy từ SĐT - Load thông tin
                    _isNewCustomer = false;
                    PopulateCustomerInfo(customer);
                    System.Diagnostics.Debug.WriteLine($"✅ Customer found by Phone: {customer.CustomerId}");
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error in TxtSoDienThoai_TextChanged: {ex.Message}");
            }
        }

        /// <summary>
        /// Tự động điền thông tin khách hàng
        /// </summary>
        private void PopulateCustomerInfo(Customer customer)
        {
            try
            {
                txtMaKhachHang.Text = customer.CustomerId;
                txtHoTenKhachHang.Text = customer.Name;
                txtCMND.Text = customer.IdNumber;
                txtSoDienThoai.Text = customer.PhoneNumber;
                dtpNgaySinh.Value = customer.DateOfBirth;

                if (!string.IsNullOrEmpty(customer.Address))
                {
                    var addressParts = customer.Address.Split(',');
                    if (addressParts.Length > 0) txtDuong.Text = addressParts[0].Trim();
                    if (addressParts.Length > 1) txtPhuongThon.Text = addressParts[1].Trim();
                    if (addressParts.Length > 2) txtQuanHuyen.Text = addressParts[2].Trim();
                    if (addressParts.Length > 3) txtTinhThanh.Text = addressParts[3].Trim();
                }

                txtQuocTich.Text = customer.Nationality;

                if (customer.Gender == 0)
                    rdoNam.Checked = true;
                else
                    rdoNu.Checked = true;

                System.Diagnostics.Debug.WriteLine($"✅ Customer info populated: {customer.CustomerId}");
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error in PopulateCustomerInfo: {ex.Message}");
            }
        }

