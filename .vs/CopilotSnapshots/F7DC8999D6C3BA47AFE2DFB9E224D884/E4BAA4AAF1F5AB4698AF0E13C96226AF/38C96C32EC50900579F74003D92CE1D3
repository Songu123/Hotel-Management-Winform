      /// <summary>
   /// ✅ Implementation for save logic (used by both buttons)
    /// </summary>
    private async Task BtnLuuPhieuThue_Click_Impl()
       {
     try
    {
  System.Diagnostics.Debug.WriteLine("========== TẠO PHIẾU THUÊ - BẮT ĐẦU ==========");

 // ==================== VALIDATION ====================

                // ✅ BƯỚC 1: Kiểm tra phòng
                if (_selectedRooms == null || _selectedRooms.Count == 0)
                {
                    MessageBox.Show("Vui lòng chọn ít nhất một phòng", "Cảnh báo",
                             MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    System.Diagnostics.Debug.WriteLine("❌ Validation failed: No rooms selected");
                    return;
                }
                System.Diagnostics.Debug.WriteLine($"✅ Validation 1: Rooms = {_selectedRooms.Count}");

                // ✅ BƯỚC 2: Kiểm tra CMND
                string cmnd = txtCMND.Text.Trim();
                if (string.IsNullOrEmpty(cmnd))
                {
                    MessageBox.Show("Vui lòng nhập CMND/CCCD", "Cảnh báo",
                     MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtCMND.Focus();
                    System.Diagnostics.Debug.WriteLine("❌ Validation failed: CMND empty");
                    return;
                }

                if (!long.TryParse(cmnd, out _))
                {
                    MessageBox.Show("CMND/CCCD phải là số", "Cảnh báo",
                     MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtCMND.Focus();
                    System.Diagnostics.Debug.WriteLine("❌ Validation failed: CMND not numeric");
                    return;
                }
                System.Diagnostics.Debug.WriteLine($"✅ Validation 2: CMND = {cmnd}");

                // ✅ BƯỚC 3: Kiểm tra tên khách (nếu khách mới)
                string customerName = txtHoTenKhachHang.Text.Trim();
                if (string.IsNullOrEmpty(customerName) && _isNewCustomer)
                {
                    MessageBox.Show("Vui lòng nhập tên khách hàng", "Cảnh báo",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtHoTenKhachHang.Focus();
                    System.Diagnostics.Debug.WriteLine("❌ Validation failed: Customer name empty (new customer)");
                    return;
                }
                System.Diagnostics.Debug.WriteLine($"✅ Validation 3: Customer name = {customerName}");

                // ✅ BƯỚC 4: Kiểm tra SĐT
                string phoneNumber = txtSoDienThoai.Text.Trim();
                if (string.IsNullOrEmpty(phoneNumber))
                {
                    MessageBox.Show("Vui lòng nhập số điện thoại", "Cảnh báo",
                             MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtSoDienThoai.Focus();
                    System.Diagnostics.Debug.WriteLine("❌ Validation failed: Phone empty");
                    return;
                }

                if (!long.TryParse(phoneNumber, out _))
                {
                    MessageBox.Show("Số điện thoại phải là số", "Cảnh báo",
                   MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtSoDienThoai.Focus();
                    System.Diagnostics.Debug.WriteLine("❌ Validation failed: Phone not numeric");
                    return;
                }
                System.Diagnostics.Debug.WriteLine($"✅ Validation 4: Phone = {phoneNumber}");

                // ✅ BƯỚC 5: Kiểm tra tuổi
                int age = DateTime.Now.Year - dtpNgaySinh.Value.Year;
                if (dtpNgaySinh.Value.Date > DateTime.Now.AddYears(-age))
                    age--;

                if (age < 18)
                {
                    MessageBox.Show("Khách hàng phải trên 18 tuổi", "Cảnh báo",
                       MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    dtpNgaySinh.Focus();
                    System.Diagnostics.Debug.WriteLine("❌ Validation failed: Age < 18");
                    return;
                }
                System.Diagnostics.Debug.WriteLine($"✅ Validation 5: Age = {age}");

                // ✅ BƯỚC 6: Kiểm tra tiền đặt cọc
                if (!int.TryParse(txtTienDatCoc.Text, out int depositAmount) || depositAmount < 0)
                {
                    MessageBox.Show("Tiền đặt cọc không hợp lệ (chỉ nhập số)", "Cảnh báo",
                            MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtTienDatCoc.Focus();
                    System.Diagnostics.Debug.WriteLine("❌ Validation failed: Deposit invalid");
                    return;
                }
                System.Diagnostics.Debug.WriteLine($"✅ Validation 6: Deposit = {depositAmount}");

                // ✅ BƯỚC 7: Kiểm tra tình trạng
                if (cboTinhTrangXuLy.SelectedIndex < 0)
                {
                    MessageBox.Show("Vui lòng chọn tình trạng xử lý", "Cảnh báo",
                 MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    cboTinhTrangXuLy.Focus();
                    System.Diagnostics.Debug.WriteLine("❌ Validation failed: Status not selected");
                    return;
                }
                System.Diagnostics.Debug.WriteLine($"✅ Validation 7: Status = {cboTinhTrangXuLy.SelectedIndex}");

                System.Diagnostics.Debug.WriteLine("✅ ✅ ✅ ALL VALIDATIONS PASSED ✅ ✅ ✅");

                // ==================== GET OR CREATE CUSTOMER ====================

                string customerId = txtMaKhachHang.Text.Trim();
                Customer currentCustomer = null;

                if (_isNewCustomer)
                {
                    System.Diagnostics.Debug.WriteLine("📝 Creating NEW customer...");

                    // ✅ Tạo khách hàng mới luôn (không cần validate)
                    currentCustomer = new Customer
                    {
                        CustomerId = customerId,
                        Name = customerName,
                        IdNumber = cmnd,
                        PhoneNumber = phoneNumber,
                        DateOfBirth = dtpNgaySinh.Value,
                        Gender = rdoNam.Checked ? 0 : 1,
                        Address = $"{txtDuong.Text}, {txtPhuongThon.Text}, {txtQuanHuyen.Text}, {txtTinhThanh.Text}",
                        Nationality = txtQuocTich.Text,
                        IsDeleted = 0
                    };

                    try
                    {
                        await _customerService.CreateCustomerAsync(currentCustomer);
                        System.Diagnostics.Debug.WriteLine($"✅ Customer created: {customerId}");
                    }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine($"❌ Error creating customer: {ex.Message}");
                        MessageBox.Show($"Lỗi tạo khách hàng: {ex.Message}", "Lỗi",
                           MessageBoxButtons.OK, MessageBoxIcon.Error);
                        return;
                    }
                }
                else
                {
                    System.Diagnostics.Debug.WriteLine("👤 Using EXISTING customer...");

                    // ✅ Khách hàng cũ - lấy từ danh sách (đã verify CMND tồn tại lúc nhập)
                    currentCustomer = _customers.FirstOrDefault(c => c.CustomerId == customerId);
                    System.Diagnostics.Debug.WriteLine($"✅ Customer loaded: {customerId}");
                }

                // ==================== SAVE RENTAL DETAIL ====================

                System.Diagnostics.Debug.WriteLine("💾 Saving rental detail...");

                var rentalDetailId = txtMaChiTietThue.Text.Trim();

                var rentalDetail = new RentalDetail
                {
                    RentalDetailId = rentalDetailId,
                    CustomerId = customerId,
                    EmployeeId = txtNhanVienLapPhieu.Text.Trim(),
                    CreatedDate = dtpNgayLapPhieu.Value,
                    DepositAmount = depositAmount,
                    ProcessingStatus = cboTinhTrangXuLy.SelectedIndex,
                    IsDeleted = 0
                };

                if (_rentalDetailService == null)
                {
                    MessageBox.Show("Lỗi: Service không khả dụng", "Lỗi",
            MessageBoxButtons.OK, MessageBoxIcon.Error);
                    System.Diagnostics.Debug.WriteLine("❌ RentalDetailService is null");
                    return;
                }

                var savedRentalDetail = await _rentalDetailService.CreateRentalDetailAsync(rentalDetail);
                if (savedRentalDetail == null)
                {
                    MessageBox.Show("Không thể lưu phiếu thuê vào database", "Lỗi",
                 MessageBoxButtons.OK, MessageBoxIcon.Error);
                    System.Diagnostics.Debug.WriteLine("❌ Failed to save rental detail");
                    return;
                }
                System.Diagnostics.Debug.WriteLine($"✅ Rental detail saved: {rentalDetailId}");

                // ==================== SAVE ROOM RENTAL DETAILS ====================

                System.Diagnostics.Debug.WriteLine("💾 Saving room rental details...");

                // Gán RentalDetailId cho mỗi phòng
                foreach (var room in _selectedRooms)
                {
                    room.RentalDetailId = rentalDetailId;
                }

                var roomsSaved = await _roomRentalDetailService.AddRoomRentalDetailsAsync(_selectedRooms);
                if (!roomsSaved)
                {
                    MessageBox.Show("Không thể lưu chi tiết phòng vào database", "Lỗi",
                     MessageBoxButtons.OK, MessageBoxIcon.Error);
                    System.Diagnostics.Debug.WriteLine("❌ Failed to save room rental details");
                    return;
                }
                System.Diagnostics.Debug.WriteLine($"✅ Room rental details saved");

                // ==================== PRINT RECEIPT ====================

                System.Diagnostics.Debug.WriteLine("🖨️ Printing receipt...");

                if (_printService != null)
                {
                    try
                    {
                        await _printService.PrintRentalDetailAsync(savedRentalDetail, _selectedRooms);

                        MessageBox.Show($"✓ Phiếu thuê được tạo thành công\n" +
                   $"Mã phiếu: {rentalDetailId}\n" +
                     $"Khách hàng: {customerId} - {currentCustomer.Name}\n" +
                   $"Tổng tiền: {lblTongCongValue.Text}\n\n" +
                   $"Phiếu thuê đã được in",
                                 "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                        System.Diagnostics.Debug.WriteLine($"✅ Receipt printed successfully");
                    }
                    catch (Exception printEx)
                    {
                        System.Diagnostics.Debug.WriteLine($"⚠️ Print error: {printEx.Message}");
                        MessageBox.Show("Phiếu thuê được lưu nhưng không thể in. Vui lòng kiểm tra.", "Cảnh báo",
                             MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    }
                }
                else
                {
                    MessageBox.Show($"✓ Phiếu thuê được tạo thành công\n" +
                 $"Mã phiếu: {rentalDetailId}\n" +
                   $"Khách hàng: {customerId} - {currentCustomer.Name}\n" +
                   $"Tổng tiền: {lblTongCongValue.Text}",
                    "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    System.Diagnostics.Debug.WriteLine($"✅ Success (no print service)");
                }

                System.Diagnostics.Debug.WriteLine("========== TẠO PHIẾU THUÊ - HOÀN TẤT ==========");

                IsConfirmed = true;
                this.DialogResult = DialogResult.OK;
                this.Close();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"❌ ❌ ❌ ERROR: {ex.Message}");
                MessageBox.Show($"Lỗi lưu phiếu thuê: {ex.Message}\n\nStack: {ex.StackTrace}", "Lỗi",
                         MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BtnReset_Click(object sender, EventArgs e)
        {
            try
            {
                System.Diagnostics.Debug.WriteLine("========== RESET FORM ==========");

                // Xóa tất cả thông tin trên form
                ClearCustomerInfo();
                txtMaChiTietThue.Text = _rentalDetailService?.GenerateRentalDetailId() ?? $"CTT{DateTime.Now:yyyyMMddHHmmss}";
                dtpNgayLapPhieu.Value = DateTime.Now;
                txtNhanVienLapPhieu.Text = "Admin";
                cboTinhTrangXuLy.SelectedIndex = 0;
                txtTienDatCoc.Text = "0";
                lblQuocTich.Visible = false;
                txtQuocTich.Visible = false;
                txtSearchCustomer.Clear();
                dgvCustomers.Rows.Clear();
                dgvRooms.Rows.Clear();
                _selectedRooms.Clear();
                _isNewCustomer = false;

                System.Diagnostics.Debug.WriteLine("✅ Form reset complete");
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error in BtnReset_Click: {ex.Message}");
            }
        }

        private void DgvRooms_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            try
            {
                if (e.ColumnIndex == dgvRooms.Columns["Xoa"].Index && e.RowIndex >= 0)
                {
                    var result = MessageBox.Show("Bạn có chắc chắn muốn xóa phòng này khỏi danh sách?", "Xác nhận",
                       MessageBoxButtons.YesNo, MessageBoxIcon.Question);

                    if (result == DialogResult.Yes)
                    {
                        var roomId = dgvRooms.Rows[e.RowIndex].Cells["MaPhong"].Value.ToString();
                        _selectedRooms.RemoveAll(r => r.RoomId == roomId);
                        dgvRooms.Rows.RemoveAt(e.RowIndex);

                        for (int i = 0; i < dgvRooms.Rows.Count; i++)
                        {
                            dgvRooms.Rows[i].Cells["STT"].Value = i + 1;
                        }

                        UpdateTotalPrice();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi",
                MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        public List<RoomRentalDetail> GetSelectedRooms()
        {
            return _selectedRooms;
        }

        public RentalDetail GetRentalDetail()
   {
            return new RentalDetail
            {
       RentalDetailId = txtMaChiTietThue.Text.Trim(),
      CustomerId = txtMaKhachHang.Text.Trim(),
             EmployeeId = txtNhanVienLapPhieu.Text.Trim(),
      CreatedDate = dtpNgayLapPhieu.Value,
    DepositAmount = int.TryParse(txtTienDatCoc.Text, out int deposit) ? deposit : 0,
 ProcessingStatus = cboTinhTrangXuLy.SelectedIndex,
         IsDeleted = 0
          };
        }
    }
