        #region ==================== CONFIRMATION ====================

        private async void BtnConfirm_Click(object sender, EventArgs e)
        {
            try
            {
                // ===== STEP 1: VALIDATION =====
                if (_selectedCustomer == null)
                {
                    ShowWarning("Vui lòng chọn khách hàng");
                    return;
                }

                if (_selectedRooms.Count == 0)
                {
                    ShowWarning("Chưa có phòng để đặt");
                    return;
                }

                if (_rentalDetailService == null || _roomRentalDetailService == null)
                {
                    ShowError("Dịch vụ không khả dụng");
                    return;
                }

                // ===== STEP 2: CREATE RENTAL DETAIL =====
                string rentalDetailId = _rentalDetailService.GenerateRentalDetailId();
                var employeeId = await ResolveEmployeeIdAsync();

                System.Diagnostics.Debug.WriteLine($"[BOOKING] Generated ID: {rentalDetailId}");
                System.Diagnostics.Debug.WriteLine($"[BOOKING] Customer ID: {_selectedCustomer.CustomerId}");
                System.Diagnostics.Debug.WriteLine($"[BOOKING] Employee ID: {employeeId}");
                System.Diagnostics.Debug.WriteLine($"[BOOKING] Customer Name: {_selectedCustomer.Name}");

                var rentalDetail = new RentalDetail
                {
                    RentalDetailId = rentalDetailId,
                    CustomerId = _selectedCustomer.CustomerId,
                    EmployeeId = employeeId,
                    CreatedDate = DateTime.Now,
                    DepositAmount = (int)(_nudDeposit?.Value ?? 0),
                    ProcessingStatus = 0,
                    IsDeleted = 0
                };

                System.Diagnostics.Debug.WriteLine($"[BOOKING] RentalDetail object created successfully");
                System.Diagnostics.Debug.WriteLine($"[BOOKING] Calling CreateRentalDetailAsync...");

                var savedRental = await _rentalDetailService.CreateRentalDetailAsync(rentalDetail);

                System.Diagnostics.Debug.WriteLine($"[BOOKING] CreateRentalDetailAsync completed");

                if (savedRental == null)
                {
                    ShowError("Không thể lưu phiếu thuê", null);
                    return;
                }

                System.Diagnostics.Debug.WriteLine($"[BOOKING] RentalDetail created successfully: {rentalDetailId}");

                // ===== STEP 3: SAVE ROOM DETAILS =====
                foreach (var room in _selectedRooms)
                {
                    room.RentalDetailId = rentalDetail.RentalDetailId;
                }

                System.Diagnostics.Debug.WriteLine($"[BOOKING] Saving {_selectedRooms.Count} room rental details");

                var roomsSaved = await _roomRentalDetailService.AddRoomRentalDetailsAsync(_selectedRooms);

                System.Diagnostics.Debug.WriteLine($"[BOOKING] Room save result: {roomsSaved}");

                if (!roomsSaved)
                {
                    ShowError("Không thể lưu chi tiết phòng", null);
                    return;
                }

                System.Diagnostics.Debug.WriteLine($"[BOOKING] Room details saved successfully");

                // ===== STEP 4: CALCULATE TOTAL =====
                int nights = (int)(_checkOutDate - _checkInDate).TotalDays;
                if (nights <= 0) nights = 1;
                decimal total = _selectedRooms.Sum(r => r.RentalPrice * nights);
                decimal deposit = _nudDeposit?.Value ?? 0;
                decimal remaining = total - deposit;

                // ===== STEP 5: SUCCESS MESSAGE =====
                string successMessage = $@"✅ ĐẶT PHÒNG THÀNH CÔNG

📋 Mã phiếu: {rentalDetail.RentalDetailId}
👤 Khách hàng: {_selectedCustomer.Name}
📱 SĐT: {_selectedCustomer.PhoneNumber}

🏨 Phòng đã đặt:
{string.Join("\n", _selectedRooms.Select(r => $"  • {r.RoomId} - {r.RentalPrice:N0} VNĐ/đêm"))}

📅 Check-in: {_checkInDate:dd/MM/yyyy HH:mm}
📅 Check-out: {_checkOutDate:dd/MM/yyyy HH:mm}
🌙 Thời gian: {nights} đêm

💰 TỔNG TIỀN: {total:N0} VNĐ
💳 ĐẶT CỌC: {deposit:N0} VNĐ
🧾 CÒN LẠI: {remaining:N0} VNĐ";

                ShowSuccess(successMessage);

                // ===== STEP 6: CLOSE FORM =====
                IsConfirmed = true;
                this.DialogResult = DialogResult.OK;
                this.Close();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[BOOKING] ERROR CAUGHT!");
                System.Diagnostics.Debug.WriteLine($"[BOOKING] Message: {ex.Message}");
                System.Diagnostics.Debug.WriteLine($"[BOOKING] Stack: {ex.StackTrace}");
                if (ex.InnerException != null)
                {
                    System.Diagnostics.Debug.WriteLine($"[BOOKING] Inner Exception: {ex.InnerException.Message}");
                    System.Diagnostics.Debug.WriteLine($"[BOOKING] Inner Stack: {ex.InnerException.StackTrace}");
                }

                string errorMsg = $"Lỗi: {ex.Message}";
                if (ex.InnerException != null)
                    errorMsg += $"\n\nChi tiết: {ex.InnerException.Message}";

                ShowError(errorMsg, null);
            }
        }

        private async Task<string> ResolveEmployeeIdAsync()
        {
            try
            {
                var serviceProvider = Program.Services;
                var employeeService = serviceProvider?.GetService(typeof(IEmployeeService)) as IEmployeeService;
                if (employeeService != null)
                {
                    var employees = await employeeService.GetAllEmployeesAsync();
                    var activeEmployee = employees?.FirstOrDefault(e => e.IsDeleted == 0);
                    if (activeEmployee != null && !string.IsNullOrWhiteSpace(activeEmployee.EmployeeId))
                        return activeEmployee.EmployeeId;
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[BOOKING] ResolveEmployeeIdAsync fallback: {ex.Message}");
            }

            // Fallback theo dữ liệu seed mặc định
            return "NV001";
        }

