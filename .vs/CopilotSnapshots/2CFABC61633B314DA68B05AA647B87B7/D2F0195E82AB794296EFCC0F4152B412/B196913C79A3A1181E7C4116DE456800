        #region ==================== HELPERS ====================

        private decimal CalculateTotalPrice()
        {
            int nights = (int)(_checkOutDate - _checkInDate).TotalDays;
            if (nights <= 0) nights = 1;
            return _selectedRooms.Sum(r => r.RentalPrice * nights);
        }

        private void UpdatePaymentSummary()
        {
            if (_lblTotalPrice == null || _lblRemaining == null || _nudDeposit == null)
                return;

            if (_nudDeposit.Value > _currentTotalPrice)
                _nudDeposit.Value = _currentTotalPrice;

            var remaining = _currentTotalPrice - _nudDeposit.Value;
            _lblTotalPrice.Text = $"💰 Tổng tiền: {_currentTotalPrice:N0} VNĐ";
            _lblRemaining.Text = $"🧾 Còn lại: {remaining:N0} VNĐ";
        }

        private void ShowMessage(string message, string title)
        {
            MessageBox.Show(message, title, MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void ShowWarning(string message)
        {
            MessageBox.Show(message, "⚠️ Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
        }

        private void ShowError(string title, Exception ex = null)
        {
            string message = ex != null ? $"{title}\n\n{ex.Message}" : title;
            MessageBox.Show(message, "❌ Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }

        private void ShowSuccess(string message)
        {
            MessageBox.Show(message, "✅ THÀNH CÔNG", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        #endregion

        public List<RoomRentalDetail> GetSelectedRooms() => _selectedRooms;
