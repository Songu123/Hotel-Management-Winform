    private void DisplayAllCustomers()
        {
            dgvCustomers.Rows.Clear();
    foreach (var customer in _allCustomers)
         {
      dgvCustomers.Rows.Add(customer.CustomerId, customer.Name, customer.PhoneNumber, customer.IdNumber, customer.DateOfBirth.ToString("dd/MM/yyyy"));
     }
        }

        private void SearchCustomers()
  {
            try
            {
    string term = txtSearchCustomer.Text.ToLower();
    var filtered = _allCustomers.Where(c => c.Name.ToLower().Contains(term) || c.PhoneNumber.Contains(term) || c.IdNumber.Contains(term)).ToList();

   dgvCustomers.Rows.Clear();
   foreach (var customer in filtered)
   {
        dgvCustomers.Rows.Add(customer.CustomerId, customer.Name, customer.PhoneNumber, customer.IdNumber, customer.DateOfBirth.ToString("dd/MM/yyyy"));
     }
          }
    catch (Exception ex)
       {
     MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
      }

    private void SelectCustomer(int rowIndex)
      {
        try
     {
              if (rowIndex < 0) return;

            string customerId = dgvCustomers.Rows[rowIndex].Cells[0].Value?.ToString();
                _selectedCustomer = _allCustomers.FirstOrDefault(c => c.CustomerId == customerId);

                if (_selectedCustomer != null)
        {
        MessageBox.Show($"✅ Đã chọn khách hàng: {_selectedCustomer.Name}", "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
         tabControl.SelectedIndex = 1;
           }
 }
            catch (Exception ex)
     {
     MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
     }
        }

