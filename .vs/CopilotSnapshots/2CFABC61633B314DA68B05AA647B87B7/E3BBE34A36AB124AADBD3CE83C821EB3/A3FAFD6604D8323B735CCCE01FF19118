        private async void BtnConfirm_Click(object sender, EventArgs e)
        {
            try
            {
      // Validate
          if (_selectedCustomer == null)
     {
      MessageBox.Show("Vui lòng chọn khách hàng", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
           tabControl.SelectedIndex = 0;
                return;
             }

        if (_selectedRooms.Count == 0)
          {
       MessageBox.Show("Chưa có phòng để đặt", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
    return;
       }

   // Validate services
        if (_rentalDetailService == null)
     {
        MessageBox.Show("Dịch vụ RentalDetail không khả dụng", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            return;
             }

        if (_roomRentalDetailService == null)
         {
  MessageBox.Show("Dịch vụ RoomRentalDetail không khả dụng", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
    return;
       }

     // Create RentalDetail with validation
        string rentalDetailId = _rentalDetailService.GenerateRentalDetailId();
        
  if (string.IsNullOrWhiteSpace(rentalDetailId))
     {
         MessageBox.Show("Không thể tạo mã chi tiết thuê", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
         return;
       }

                var rentalDetail = new RentalDetail
        {
    RentalDetailId = rentalDetailId,
       CustomerId = _selectedCustomer.CustomerId ?? throw new ArgumentNullException("CustomerId"),
          EmployeeId = "Admin",  // Default employee
  CreatedDate = DateTime.Now,
         DepositAmount = 0,
    ProcessingStatus = 0,
             IsDeleted = 0
             };

         // Save RentalDetail
       System.Diagnostics.Debug.WriteLine($"Creating RentalDetail: {rentalDetailId}");
     var savedRental = await _rentalDetailService.CreateRentalDetailAsync(rentalDetail);
        
            if (savedRental == null)
                {
         MessageBox.Show("Không thể lưu phiếu thuê", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
     return;
    }

                System.Diagnostics.Debug.WriteLine($"RentalDetail created successfully: {savedRental.RentalDetailId}");

                // Save room details
      foreach (var room in _selectedRooms)
   {
            room.RentalDetailId = rentalDetail.RentalDetailId;
    }

            System.Diagnostics.Debug.WriteLine($"Adding {_selectedRooms.Count} room rental details");
      var roomsSaved = await _roomRentalDetailService.AddRoomRentalDetailsAsync(_selectedRooms);
       
if (!roomsSaved)
           {
         MessageBox.Show("Không thể lưu chi tiết phòng", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
        return;
    }

  System.Diagnostics.Debug.WriteLine($"Room rental details saved successfully");

       int nights = (int)(_checkOutDate - _checkInDate).TotalDays;
  if (nights <= 0) nights = 1;
          decimal total = _selectedRooms.Sum(r => r.RentalPrice * nights);

        MessageBox.Show($"✅ ĐẶT PHÒNG THÀNH CÔNG\n\n📋 Mã phiếu: {rentalDetail.RentalDetailId}\n👤 Khách: {_selectedCustomer.Name}\n💰 Tổng tiền: {total:N0} VNĐ",
           "THÀNH CÔNG", MessageBoxButtons.OK, MessageBoxIcon.Information);

          IsConfirmed = true;
        this.DialogResult = DialogResult.OK;
                this.Close();
        }
            catch (Exception ex)
            {
     System.Diagnostics.Debug.WriteLine($"Error in BtnConfirm_Click: {ex.Message}");
       System.Diagnostics.Debug.WriteLine($"Stack Trace: {ex.StackTrace}");
  MessageBox.Show($"Lỗi: {ex.Message}\n\nChi tiết: {ex.InnerException?.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
   }
        }
