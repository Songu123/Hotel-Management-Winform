            {
         System.Diagnostics.Debug.WriteLine($"Error loading services: {ex.Message}");
       }
   }

        private void OnServiceCheckedChanged(Service service, bool isChecked)
        {
      if (isChecked)
     {
                _selectedServices.Add(service);
            }
            else
     {
          _selectedServices.RemoveAll(s => s.ServiceId == service.ServiceId);
     }
     CalculatePrice();
        }

