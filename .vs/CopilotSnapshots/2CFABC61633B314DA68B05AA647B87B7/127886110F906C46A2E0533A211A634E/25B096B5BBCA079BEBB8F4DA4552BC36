        private async void BtnCreateBooking_Click(object sender, EventArgs e)
        {
   try
       {
        if (_selectedCustomer == null || _selectedRooms.Count == 0)
       {
             MessageBox.Show("Dữ liệu không đủ để tạo phiếu", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            return;
      }

        // Create RentalDetail
              var rentalDetail = new RentalDetail
    {
       RentalDetailId = _rentalDetailService.GenerateRentalDetailId(),
          CustomerId = _selectedCustomer.CustomerId,
                  EmployeeId = "Admin",
             CreatedDate = DateTime.Now,
    DepositAmount = int.Parse(txtDeposit.Text ?? "0"),
    ProcessingStatus = 0,
  IsDeleted = 0
                };

       var savedRental = await _rentalDetailService.CreateRentalDetailAsync(rentalDetail);
         if (savedRental == null) throw new Exception("Không thể lưu phiếu thuê");

// Save room details
foreach (var room in _selectedRooms)
       {
        room.RentalDetailId = rentalDetail.RentalDetailId;
                }

    var roomsSaved = await _roomRentalDetailService.AddRoomRentalDetailsAsync(_selectedRooms);
       if (!roomsSaved) throw new Exception("Không thể lưu chi tiết phòng");

  IsBookingConfirmed = true;

      MessageBox.Show($"✅ Tạo phiếu thành công\n\n" +
     $"Mã phiếu: {rentalDetail.RentalDetailId}\n" +
   $"Khách hàng: {_selectedCustomer.Name}\n" +
  $"Tổng tiền: {lblTotalPrice.Text}",
   "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);

          this.DialogResult = DialogResult.OK;
                this.Close();
          }
            catch (Exception ex)
            {
      MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
       }
        }

