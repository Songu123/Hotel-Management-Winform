        private void BtnSearchCustomer_Click(object sender, EventArgs e)
        {
       try
 {
    string searchTerm = txtSearchCustomer.Text.ToLower();

             if (string.IsNullOrEmpty(searchTerm))
                {
     LoadData();
      return;
             }

  var allCustomers = dgvCustomers.DataSource as List<Customer> ?? new();
        var filtered = allCustomers
           ?.Where(c => c.Name.ToLower().Contains(searchTerm) ||
c.PhoneNumber.Contains(searchTerm) ||
             c.IdNumber.Contains(searchTerm))
    .ToList();

     DisplayCustomers(filtered ?? new List<Customer>());
