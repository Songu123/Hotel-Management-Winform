  #region ==================== ROOM TAB ====================

        private void DisplayAvailableRooms(List<Room> rooms)
        {
            try
    {
     dgvAvailableRooms.Rows.Clear();

           foreach (var room in rooms.Where(r => r.IsDeleted == 0 && r.Status == 0))
           {
          string status = _selectedRooms.Any(sr => sr.RoomId == room.RoomId) ? "✅ Đã chọn" : "❌ Chưa chọn";
Color statusColor = _selectedRooms.Any(sr => sr.RoomId == room.RoomId) ? Color.Green : Color.Gray;

            int rowIdx = dgvAvailableRooms.Rows.Add(
        room.RoomId,
       room.Name,
      GetRoomTypeName(room.RoomType),
    room.Price.ToString("N0"),
       status
      );

    dgvAvailableRooms.Rows[rowIdx].Cells[4].Style.ForeColor = statusColor;
      }
         }
       catch (Exception ex)
        {
     System.Diagnostics.Debug.WriteLine($"Error displaying rooms: {ex.Message}");
 }
        }

        private void DgvAvailableRooms_CellDoubleClick(object sender, DataGridViewCellEventArgs e)
     {
     try
            {
          if (e.RowIndex < 0) return;

       string roomId = dgvAvailableRooms.Rows[e.RowIndex].Cells[0].Value?.ToString();
       if (string.IsNullOrEmpty(roomId)) return;

// Check if already selected
            if (_selectedRooms.Any(r => r.RoomId == roomId))
      {
               MessageBox.Show("Phòng này đã được chọn", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
      return;
       }

        var rental = new RoomRentalDetail
        {
          RoomId = roomId,
        RentalDate = _checkInDate,
 ReturnDate = _checkOutDate,
           RentalPrice = int.Parse(dgvAvailableRooms.Rows[e.RowIndex].Cells[3].Value?.ToString()?.Replace(",", "") ?? "0"),
        RentalType = 0,
        Status = 0
      };

     _selectedRooms.Add(rental);
       DisplayAvailableRooms(dgvAvailableRooms.DataSource as List<Room> ?? new List<Room>());
             DisplaySelectedRooms();
                CalculatePrice();

   MessageBox.Show($"✅ Thêm phòng {roomId} thành công", "Thành công", 
           MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
catch (Exception ex)
      {
  MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
       }
 }

     private void DisplaySelectedRooms()
   {
          try
         {
 dgvSelectedRooms.Rows.Clear();

             int stt = 1;
      int nights = (int)(_checkOutDate - _checkInDate).TotalDays;
    if (nights <= 0) nights = 1;

       foreach (var rental in _selectedRooms)
          {
          int totalPrice = rental.RentalPrice * nights;

  dgvSelectedRooms.Rows.Add(
             stt++,
     rental.RoomId,
       rental.RentalPrice.ToString("N0"),
           nights,
         totalPrice.ToString("N0")
   );
  }
      }
       catch (Exception ex)
            {
         System.Diagnostics.Debug.WriteLine($"Error displaying selected rooms: {ex.Message}");
            }
        }

  private void DgvSelectedRooms_CellClick(object sender, DataGridViewCellEventArgs e)
 {
            try
         {
                if (e.ColumnIndex == dgvSelectedRooms.Columns["Delete"].Index && e.RowIndex >= 0)
    {
 var result = MessageBox.Show("Xóa phòng này?", "Xác nhận", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (result == DialogResult.Yes)
      {
          string roomId = dgvSelectedRooms.Rows[e.RowIndex].Cells[1].Value?.ToString();
            _selectedRooms.RemoveAll(r => r.RoomId == roomId);
  DisplaySelectedRooms();
   DisplayAvailableRooms(dgvAvailableRooms.DataSource as List<Room> ?? new List<Room>());
    CalculatePrice();
            }
                }
    }
  catch (Exception ex)
         {
    MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
    }
      }

