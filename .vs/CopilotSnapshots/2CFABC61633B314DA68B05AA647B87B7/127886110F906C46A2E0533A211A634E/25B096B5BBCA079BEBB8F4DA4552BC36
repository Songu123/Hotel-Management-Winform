        private string GetRoomTypeName(int type)
        {
      return type switch
  {
  1 => "Phòng Đơn",
                2 => "Phòng Đôi",
       3 => "Phòng Gia Đình",
            4 => "Phòng VIP",
     _ => "Không xác định"
  };
