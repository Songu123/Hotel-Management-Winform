    #region ==================== PRICE CALCULATION ====================

      private void CalculatePrice()
     {
       try
         {
      int nights = (int)(_checkOutDate - _checkInDate).TotalDays;
        if (nights <= 0) nights = 1;

                decimal roomPrice = _selectedRooms.Sum(r => r.RentalPrice * nights);
    decimal servicePrice = _selectedServices.Sum(s => s.Price);
             decimal totalPrice = roomPrice + servicePrice;

         lblRoomPrice.Text = $"{roomPrice:N0} VNĐ";
            lblServicePrice.Text = $"{servicePrice:N0} VNĐ";
   lblTotalPrice.Text = $"{totalPrice:N0} VNĐ";

      // Update confirmation tab
                lblConfirmRooms.Text = $"{_selectedRooms.Count} phòng";
    lblConfirmNights.Text = $"{nights} đêm";
                lblConfirmTotal.Text = $"{totalPrice:N0} VNĐ";
            }
 catch (Exception ex)
            {
      System.Diagnostics.Debug.WriteLine($"Error calculating price: {ex.Message}");
       }
    }

   #endregion

