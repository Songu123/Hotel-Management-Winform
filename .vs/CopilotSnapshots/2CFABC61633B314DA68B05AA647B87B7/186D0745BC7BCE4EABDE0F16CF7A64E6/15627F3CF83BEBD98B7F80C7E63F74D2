    /// <summary>
    /// 🎯 Simple Room Selection Dialog - Load available rooms only
    /// </summary>
    public class SimpleRoomSelectionDialog : Form
    {
        private IRoomService roomService;
     private DateTime checkInDate;
    private DateTime checkOutDate;
        public Room SelectedRoom { get; private set; }

    public SimpleRoomSelectionDialog(IRoomService rs, DateTime ci, DateTime co)
        {
     roomService = rs;
            checkInDate = ci;
       checkOutDate = co;
   InitializeDialogForm();
        }

        private void InitializeDialogForm()
        {
       this.Text = "Chọn Phòng Trống";
         this.Width = 900;
            this.Height = 500;
      this.StartPosition = FormStartPosition.CenterParent;
        this.BackColor = Color.White;

    // Room list
         var dgv = new DataGridView
      {
      Dock = DockStyle.Fill,
      AutoGenerateColumns = false,
  AllowUserToAddRows = false,
    ReadOnly = true,
          BackgroundColor = Color.White
            };

            dgv.Columns.Add(new DataGridViewTextBoxColumn { HeaderText = "Mã Phòng", DataPropertyName = "RoomId", Width = 80 });
            dgv.Columns.Add(new DataGridViewTextBoxColumn { HeaderText = "Tên", DataPropertyName = "Name", Width = 100 });
            dgv.Columns.Add(new DataGridViewTextBoxColumn { HeaderText = "Giá/Đêm", DataPropertyName = "Price", Width = 100, DefaultCellStyle = new DataGridViewCellStyle { Format = "N0" } });
    dgv.Columns.Add(new DataGridViewTextBoxColumn { HeaderText = "Loại", DataPropertyName = "RoomType", Width = 80 });

            dgv.DoubleClick += (s, e) =>
            {
         if (dgv.SelectedRows.Count > 0)
          {
SelectedRoom = dgv.SelectedRows[0].DataBoundItem as Room;
         this.DialogResult = DialogResult.OK;
       this.Close();
       }
      };

          this.Controls.Add(dgv);

            // Load rooms
     this.Load += async (s, e) =>
       {
           try
         {
           var availableRooms = await roomService.GetAvailableRoomsAsync();
         dgv.DataSource = availableRooms?.ToList() ?? new List<Room>();
          }
       catch (Exception ex)
   {
    MessageBox.Show($"Lỗi tải phòng: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
         }
            };
   }
    }
