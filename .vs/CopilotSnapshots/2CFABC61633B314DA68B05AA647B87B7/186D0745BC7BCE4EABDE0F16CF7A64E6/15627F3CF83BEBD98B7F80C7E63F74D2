       MessageBox.Show("✅ Form đã làm mới", "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
             }
            }
          catch (Exception ex)
      {
          MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
    }
    }

     public List<RoomRentalDetail> GetSelectedRooms() => _selectedRooms;

