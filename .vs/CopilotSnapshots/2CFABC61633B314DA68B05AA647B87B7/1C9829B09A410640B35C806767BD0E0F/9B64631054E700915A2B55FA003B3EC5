   private async void RoomAllocationDialog_Load(object sender, EventArgs e)
    {
            try
      {
   await LoadRoomsAsync();
            DisplayRooms(0); // Show all rooms initially
   }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi tải dữ liệu phòng: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
      this.DialogResult = DialogResult.Cancel;
            this.Close();
   }
        }

        private async Task LoadRoomsAsync()
   {
  try
            {
     _allRooms = (await _roomService.GetAllRoomsAsync()).ToList();
        System.Diagnostics.Debug.WriteLine($"✅ Loaded {_allRooms.Count} rooms");
   }
    catch (Exception ex)
            {
    System.Diagnostics.Debug.WriteLine($"❌ Error loading rooms: {ex.Message}");
     throw;
            }
   }

        private void FilterByFloor(int floor)
        {
 DisplayRooms(floor);
        }

        private void DisplayRooms(int selectedFloor)
        {
       try
 {
                var roomsPanel = this.Controls.Find("roomsContainer", true).FirstOrDefault() as FlowLayoutPanel;
              if (roomsPanel == null) return;

                roomsPanel.Controls.Clear();
          _roomCards.Clear();

             var filteredRooms = selectedFloor == 0 
              ? _allRooms.Where(r => r.IsDeleted == 0).ToList()
            : _allRooms.Where(r => r.IsDeleted == 0 && ExtractFloor(r.RoomId) == selectedFloor).ToList();

      foreach (var room in filteredRooms.OrderBy(r => r.Name))
     {
     var card = CreateRoomCard(room);
         roomsPanel.Controls.Add(card);
   _roomCards[room.RoomId] = card;
    }

       System.Diagnostics.Debug.WriteLine($"✅ Displayed {filteredRooms.Count} rooms");
  }
        catch (Exception ex)
 {
    System.Diagnostics.Debug.WriteLine($"❌ Error displaying rooms: {ex.Message}");
    }
  }

        private Panel CreateRoomCard(Room room)
        {
   var isAvailable = room.Status == 0; // 0 = available
       var isSelected = _selectedRooms.Any(r => r.RoomId == room.RoomId);

   var card = new Panel
            {
     Width = 150,
  Height = 180,
     BackColor = isSelected ? Color.FromArgb(34, 197, 94) : 
  (isAvailable ? Color.FromArgb(220, 255, 220) : Color.FromArgb(255, 220, 220)),
    BorderStyle = BorderStyle.FixedSingle,
    Cursor = isAvailable ? Cursors.Hand : Cursors.No,
        Margin = new Padding(8),
           Padding = new Padding(10)
        };

 // Room name
            var lblRoom = new Label
   {
      Text = room.Name,
                Font = new Font("Segoe UI", 14, FontStyle.Bold),
    ForeColor = isSelected ? Color.White : Color.Black,
 AutoSize = true,
      Location = new Point(10, 10)
          };
     card.Controls.Add(lblRoom);

  // Room type
  var lblType = new Label
            {
    Text = $"Loại: {GetRoomTypeName(room.RoomType)}",
     Font = new Font("Segoe UI", 9),
       ForeColor = isSelected ? Color.White : Color.FromArgb(100, 100, 100),
        AutoSize = true,
 Location = new Point(10, 40)
            };
  card.Controls.Add(lblType);

          // Price
            var lblPrice = new Label
       {
 Text = $"Giá: {room.Price:N0} VNĐ",
         Font = new Font("Segoe UI", 9, FontStyle.Bold),
    ForeColor = isSelected ? Color.White : Color.FromArgb(200, 50, 50),
           AutoSize = true,
      Location = new Point(10, 65)
     };
            card.Controls.Add(lblPrice);

  // Status
       var statusText = isAvailable ? "✅ Trống" : "❌ Đã có khách";
  var lblStatus = new Label
            {
   Text = statusText,
      Font = new Font("Segoe UI", 9, FontStyle.Bold),
     ForeColor = isSelected ? Color.White : (isAvailable ? Color.FromArgb(50, 150, 50) : Color.FromArgb(200, 50, 50)),
  AutoSize = true,
          Location = new Point(10, 90)
            };
       card.Controls.Add(lblStatus);

    // Action indicator
            if (isSelected)
            {
            var lblCheck = new Label
           {
           Text = "✓ Đã chọn",
   Font = new Font("Segoe UI", 10, FontStyle.Bold),
         ForeColor = Color.White,
                    AutoSize = true,
           Location = new Point(10, 120)
      };
      card.Controls.Add(lblCheck);
 }
            else if (!isAvailable)
       {
    var lblUnavailable = new Label
     {
            Text = "Không thể chọn",
       Font = new Font("Segoe UI", 9),
 ForeColor = Color.FromArgb(150, 50, 50),
         AutoSize = true,
         Location = new Point(10, 120)
           };
        card.Controls.Add(lblUnavailable);
      }

        // Click event
    card.Click += (s, e) => ToggleRoomSelection(room, card);
       card.MouseEnter += (s, e) =>
          {
        if (isAvailable && !isSelected)
 card.BackColor = Color.FromArgb(180, 255, 180);
            };
card.MouseLeave += (s, e) =>
            {
  if (!isSelected)
                 card.BackColor = Color.FromArgb(220, 255, 220);
            };

            return card;
        }

        private void ToggleRoomSelection(Room room, Panel card)
     {
        if (room.Status != 0) // Not available
      {
          MessageBox.Show("Phòng này không khả dụng!", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
        return;
       }

        var existing = _selectedRooms.FirstOrDefault(r => r.RoomId == room.RoomId);

            if (existing != null)
        {
        _selectedRooms.Remove(existing);
        }
    else
       {
       var nights = (int)(_checkOutDate - _checkInDate).TotalDays;
 var roomRentalDetail = new RoomRentalDetail
    {
        RoomId = room.RoomId,
           RentalDate = _checkInDate,
   ReturnDate = _checkOutDate,
   RentalPrice = room.Price,
RentalType = 0,
        Status = 0
     };
     _selectedRooms.Add(roomRentalDetail);
       }

            UpdateSelectedInfo();
      RefreshRoomCard(room);
        }

        private void RefreshRoomCard(Room room)
   {
      if (_roomCards.ContainsKey(room.RoomId))
   {
             _roomCards.Remove(room.RoomId);
        var roomsContainer = this.Controls.Find("roomsContainer", true).FirstOrDefault() as FlowLayoutPanel;
         if (roomsContainer != null)
                {
        var oldCard = roomsContainer.Controls.OfType<Panel>()
    .FirstOrDefault(p => p.Controls.OfType<Label>().Any(l => l.Text == room.Name));
               if (oldCard != null)
           {
     roomsContainer.Controls.Remove(oldCard);
 }

         var newCard = CreateRoomCard(room);
             roomsContainer.Controls.Add(newCard);
        _roomCards[room.RoomId] = newCard;
    }
       }
        }

     private void UpdateSelectedInfo()
  {
  var lblSelected = this.Controls.Find("lblSelectedInfo", true).FirstOrDefault() as Label;
        if (lblSelected != null)
       {
       var totalPrice = _selectedRooms.Sum(r => r.RentalPrice * (int)(_checkOutDate - _checkInDate).TotalDays);
    lblSelected.Text = $"✓ Đã chọn: {_selectedRooms.Count} phòng | Tổng giá: {totalPrice:N0} VNĐ";
      }
        }

        private int ExtractFloor(string roomId)
        {
    if (int.TryParse(roomId?.ToString().FirstOrDefault().ToString(), out var floor))
        return floor;
         return 1;
        }

        private string GetRoomTypeName(int type)
        {
            return type switch
    {
       0 => "Đơn",
 1 => "Đôi",
        2 => "Gia đình",
      3 => "VIP",
        _ => "Khác"
     };
        }
