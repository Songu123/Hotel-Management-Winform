        #endregion

        #region ==================== DATA LOADING ====================

        private void LoadCustomers()
        {
            try
            {
                var dgvCustomers = this.Tag as DataGridView;
                if (dgvCustomers == null) return;

                dgvCustomers.Rows.Clear();
                foreach (var customer in _allCustomers)
                {
                    dgvCustomers.Rows.Add(
                                 customer.CustomerId,
                              customer.Name,
                         customer.PhoneNumber,
                             customer.IdNumber
                            );
                }
            }
            catch (Exception ex)
            {
                ShowError("Lỗi tải khách hàng", ex);
            }
        }

        private void SearchCustomers(string searchTerm)
        {
            try
            {
                var dgvCustomers = this.Tag as DataGridView;
                if (dgvCustomers == null) return;

                dgvCustomers.Rows.Clear();

                if (string.IsNullOrWhiteSpace(searchTerm))
                {
                    LoadCustomers();
                    return;
                }

                string term = searchTerm.ToLower();
                var filtered = _allCustomers.Where(c =>
                          c.Name.ToLower().Contains(term) ||
                          c.PhoneNumber.Contains(term) ||
                    c.IdNumber.Contains(term)
                    ).ToList();

                foreach (var customer in filtered)
                {
                    dgvCustomers.Rows.Add(
                 customer.CustomerId,
                          customer.Name,
                customer.PhoneNumber,
               customer.IdNumber
                      );
                }

                if (filtered.Count == 0)
                    ShowMessage($"Không tìm thấy khách hàng phù hợp với '{searchTerm}'", "Thông báo");
            }
            catch (Exception ex)
            {
                ShowError("Lỗi tìm kiếm khách hàng", ex);
            }
        }

        private void SelectCustomer(DataGridView dgv, int rowIndex)
        {
            try
            {
                if (rowIndex < 0) return;

                string customerId = dgv.Rows[rowIndex].Cells[0].Value?.ToString();
                _selectedCustomer = _allCustomers.FirstOrDefault(c => c.CustomerId == customerId);

                if (_selectedCustomer != null)
                {
                    ShowMessage($"✅ Chọn khách hàng: {_selectedCustomer.Name}", "Thành công");
                }
            }
            catch (Exception ex)
            {
                ShowError("Lỗi chọn khách hàng", ex);
            }
        }

        #endregion

        #region ==================== CONFIRMATION ====================

        private async void BtnConfirm_Click(object sender, EventArgs e)
        {
            try
            {
                // ===== STEP 1: VALIDATION =====
                if (_selectedCustomer == null)
                {
                    ShowWarning("Vui lòng chọn khách hàng");
                    return;
                }

                if (_selectedRooms.Count == 0)
                {
                    ShowWarning("Chưa có phòng để đặt");
                    return;
                }

                if (_rentalDetailService == null || _roomRentalDetailService == null)
                {
                    ShowError("Dịch vụ không khả dụng");
                    return;
                }

                // ===== STEP 2: CREATE RENTAL DETAIL =====
                string rentalDetailId = _rentalDetailService.GenerateRentalDetailId();

                var rentalDetail = new RentalDetail
                {
                    RentalDetailId = rentalDetailId,
                    CustomerId = _selectedCustomer.CustomerId,
                    EmployeeId = "Admin",
                    CreatedDate = DateTime.Now,
                    DepositAmount = 0,
                    ProcessingStatus = 0,
                    IsDeleted = 0
                };

                System.Diagnostics.Debug.WriteLine($"[BOOKING] Creating RentalDetail: {rentalDetailId}");

                var savedRental = await _rentalDetailService.CreateRentalDetailAsync(rentalDetail);
                if (savedRental == null)
                {
                    ShowError("Không thể lưu phiếu thuê");
                    return;
                }

                System.Diagnostics.Debug.WriteLine($"[BOOKING] RentalDetail created successfully: {rentalDetailId}");

                // ===== STEP 3: SAVE ROOM DETAILS =====
                foreach (var room in _selectedRooms)
                {
                    room.RentalDetailId = rentalDetail.RentalDetailId;
                }

                System.Diagnostics.Debug.WriteLine($"[BOOKING] Saving {_selectedRooms.Count} room rental details");

                var roomsSaved = await _roomRentalDetailService.AddRoomRentalDetailsAsync(_selectedRooms);
                if (!roomsSaved)
                {
                    ShowError("Không thể lưu chi tiết phòng");
                    return;
                }

                System.Diagnostics.Debug.WriteLine($"[BOOKING] Room details saved successfully");

                // ===== STEP 4: CALCULATE TOTAL =====
                int nights = (int)(_checkOutDate - _checkInDate).TotalDays;
                if (nights <= 0) nights = 1;
                decimal total = _selectedRooms.Sum(r => r.RentalPrice * nights);

                // ===== STEP 5: SUCCESS MESSAGE =====
                string successMessage = $@"✅ ĐẶT PHÒNG THÀNH CÔNG

📋 Mã phiếu: {rentalDetail.RentalDetailId}
👤 Khách hàng: {_selectedCustomer.Name}
📱 SĐT: {_selectedCustomer.PhoneNumber}

🏨 Phòng đã đặt:
{string.Join("\n", _selectedRooms.Select(r => $"  • {r.RoomId} - {r.RentalPrice:N0} VNĐ/đêm"))}

📅 Check-in: {_checkInDate:dd/MM/yyyy HH:mm}
📅 Check-out: {_checkOutDate:dd/MM/yyyy HH:mm}
🌙 Thời gian: {nights} đêm

💰 TỔNG TIỀN: {total:N0} VNĐ";

                ShowSuccess(successMessage);

                // ===== STEP 6: CLOSE FORM =====
                IsConfirmed = true;
                this.DialogResult = DialogResult.OK;
                this.Close();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[BOOKING] Error: {ex.Message}");
                System.Diagnostics.Debug.WriteLine($"[BOOKING] Stack: {ex.StackTrace}");
                ShowError($"{ex.Message}\n\nChi tiết: {ex.InnerException?.Message}");
            }
        }

        #endregion

        #region ==================== HELPERS ====================

        private decimal CalculateTotalPrice()
        {
            int nights = (int)(_checkOutDate - _checkInDate).TotalDays;
            if (nights <= 0) nights = 1;
            return _selectedRooms.Sum(r => r.RentalPrice * nights);
        }

        private void ShowMessage(string message, string title)
        {
            MessageBox.Show(message, title, MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void ShowWarning(string message)
        {
            MessageBox.Show(message, "⚠️ Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
        }

        private void ShowError(string title, Exception ex = null)
        {
            string message = ex != null ? $"{title}\n\n{ex.Message}" : title;
            MessageBox.Show(message, "❌ Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }

        private void ShowSuccess(string message)
        {
            MessageBox.Show(message, "✅ THÀNH CÔNG", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        #endregion

        public List<RoomRentalDetail> GetSelectedRooms() => _selectedRooms;
