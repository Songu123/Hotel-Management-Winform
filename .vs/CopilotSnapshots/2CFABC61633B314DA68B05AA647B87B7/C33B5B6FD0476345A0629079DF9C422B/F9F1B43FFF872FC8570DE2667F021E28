            {
                RoomId = room.RoomId,
                RentalDate = checkIn,
                ReturnDate = checkOut,
                RentalPrice = room.Price,
                Status = 0
            });
        }

        public void Initialize(IRoomService roomService, ICustomerService customerService,
      IRentalDetailService rentalDetailService, IRoomRentalDetailService roomRentalDetailService)
