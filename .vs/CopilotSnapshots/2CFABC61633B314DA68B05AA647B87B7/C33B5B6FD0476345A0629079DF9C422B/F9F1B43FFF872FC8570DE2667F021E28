            dgvRooms.Columns.Add("STT", "STT");
            dgvRooms.Columns.Add("RoomId", "Mã Phòng");
            dgvRooms.Columns.Add("Type", "Loại");
            dgvRooms.Columns.Add("Price", "Giá/Đêm");
            dgvRooms.Columns.Add("Total", "Tổng");

            // Populate rooms
            int stt = 1;
            foreach (var room in _selectedRooms)
