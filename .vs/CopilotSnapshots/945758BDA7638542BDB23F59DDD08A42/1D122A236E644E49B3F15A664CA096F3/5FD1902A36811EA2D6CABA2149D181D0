        /// <summary>
        /// Apply hover/focus effects to TextBox
        /// </summary>
        private void ApplyTextBoxStyle(TextBox txt)
        {
            txt.MouseEnter += (s, e) =>
             {
                 if (!txt.Focused)
                     txt.BackColor = Color.FromArgb(249, 250, 251);
             };

            txt.MouseLeave += (s, e) =>
              {
                  if (!txt.Focused)
                      txt.BackColor = Color.White;
              };

            txt.GotFocus += (s, e) =>
        {
            txt.BackColor = Color.FromArgb(240, 253, 250);
        };

            txt.LostFocus += (s, e) =>
              {
                  txt.BackColor = Color.White;
              };

            txt.KeyDown += (s, e) =>
                {
                    if (e.KeyCode == Keys.Return)
                    {
                        e.SuppressKeyPress = true;
                        BtnLogin_Click(null, null);
                    }
                };
        }

        /// <summary>
