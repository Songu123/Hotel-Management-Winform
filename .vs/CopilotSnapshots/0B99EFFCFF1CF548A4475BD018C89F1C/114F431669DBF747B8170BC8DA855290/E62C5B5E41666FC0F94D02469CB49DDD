using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Text.RegularExpressions;
using System.Threading.Tasks;
using System.Windows.Forms;
using QuanLyKhachSan.Models;
using QuanLyKhachSan.Services.Interfaces;
using QuanLyKhachSan.Services.RequestHandlers;
using QuanLyKhachSan.Services.RequestHandlers.Dtos;
using QuanLyKhachSan.Services.RequestHandlers.Interfaces;

namespace QuanLyKhachSan.UI.CustomerUI
{
    public partial class AddCustomerForm : Form
    {
        private readonly ICustomerCreateRequestHandler _requestHandler;

        public AddCustomerForm(ICustomerService customerService)
        {
            InitializeComponent();
            // Create handler with service
            _requestHandler = new CustomerCreateRequestHandler(customerService ?? throw new ArgumentNullException(nameof(customerService)));
        }

        private void AddCustomerForm_Load(object sender, EventArgs e)
        {
            try
            {
                InitializeForm();
                AttachEventHandlers();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi tải form: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void InitializeForm()
        {
            // Set default values
            dtpNgaySinh.Value = DateTime.Now.AddYears(-18); // Default age 18
            rbNam.Checked = true;

            // Generate new customer ID
            txtMaKH.Text = GenerateNewCustomerId();
            txtMaKH.ReadOnly = true;

            // Focus on name field
            txtHoTen.Focus();
        }

        private string GenerateNewCustomerId()
        {
            // Format: KH + timestamp (e.g., KH20240101001)
            return $"KH{DateTime.Now:yyyyMMddHHmmss}";
        }

        private void AttachEventHandlers()
        {
            btnLuu.Click += BtnLuu_Click;
            btnHuy.Click += BtnHuy_Click;
            btnClose.Click += BtnClose_Click;
        }

        private async void BtnLuu_Click(object sender, EventArgs e)
        {
            try
            {
                // Create request from form data
                var request = new CustomerCreateRequest
                {
                    CustomerId = txtMaKH.Text.Trim(),
                    Name = txtHoTen.Text.Trim(),
                    IdNumber = txtCMND.Text.Trim(),
                    PhoneNumber = txtSDT.Text.Trim(),
                    DateOfBirth = dtpNgaySinh.Value,
                    Gender = rbNam.Checked ? 1 : 0,
                    Address = BuildAddress(),
                    Nationality = txtQuocTich.Text.Trim()
                };

                // Handle request (all validation happens here, not in UI)
                var result = await _requestHandler.HandleAsync(request);

                if (result.Success)
                {
                    MessageBox.Show(result.Message, "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    this.DialogResult = DialogResult.OK;
                    this.Close();
                }
                else
                {
                    // Show validation errors
                    if (result.Errors.Any())
                    {
                        var firstError = result.Errors.First();
                        MessageBox.Show(firstError.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        FocusFieldByName(firstError.Field);
                    }
                    else
                    {
                        MessageBox.Show(result.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi hệ thống: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void FocusFieldByName(string fieldName)
        {
            switch (fieldName.ToLower())
            {
                case "name":
                    txtHoTen.Focus();
                    break;
                case "phonenumber":
                    txtSDT.Focus();
                    break;
                case "customerid":
                    txtMaKH.Focus();
                    break;
                case "idnumber":
                    txtCMND.Focus();
                    break;
                case "dateofbirth":
                    dtpNgaySinh.Focus();
                    break;
                default:
                    break;
            }
        }

        private string BuildAddress()
        {
            var parts = new List<string>();

            if (!string.IsNullOrWhiteSpace(txtDuong.Text))
                parts.Add(txtDuong.Text.Trim());
            if (!string.IsNullOrWhiteSpace(txtPhuongThon.Text))
                parts.Add(txtPhuongThon.Text.Trim());
            if (!string.IsNullOrWhiteSpace(txtQuanHuyen.Text))
                parts.Add(txtQuanHuyen.Text.Trim());
            if (!string.IsNullOrWhiteSpace(txtTinhThanh.Text))
                parts.Add(txtTinhThanh.Text.Trim());

            return string.Join(", ", parts);
        }

        private void BtnHuy_Click(object sender, EventArgs e)
        {
            this.DialogResult = DialogResult.Cancel;
            this.Close();
        }

        private void BtnClose_Click(object sender, EventArgs e)
        {
            this.DialogResult = DialogResult.Cancel;
            this.Close();
        }
    }
}
