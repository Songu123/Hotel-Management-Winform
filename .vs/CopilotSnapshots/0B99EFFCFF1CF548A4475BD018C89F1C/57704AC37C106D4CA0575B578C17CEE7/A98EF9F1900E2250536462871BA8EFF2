        private void PopulateCustomerCombo(List<Customer> customers)
        {
     cboCustomer.Items.Clear();
            cboCustomer.Items.Add("-- Chọn khách hàng --");

            if (customers != null && customers.Count > 0)
            {
   foreach (var customer in customers)
      {
  cboCustomer.Items.Add($"{customer.CustomerId} - {customer.Name}");
   }
      }

         cboCustomer.SelectedIndex = 0;
        }

      private void TxtSearchCustomer_TextChanged(object sender, EventArgs e)
        {
      string searchText = txtSearchCustomer.Text.ToLower();

   if (string.IsNullOrWhiteSpace(searchText))
            {
PopulateCustomerCombo(_allCustomers);
                return;
       }

  var filtered = _allCustomers.Where(c =>
    c.CustomerId.ToLower().Contains(searchText) ||
       c.Name.ToLower().Contains(searchText)
          ).ToList();

            PopulateCustomerCombo(filtered);
        }

        private void CboCustomer_SelectedIndexChanged(object sender, EventArgs e)
        {
            var btnSave = this.Controls["btnSave"] as Button;
  if (btnSave == null)
            {
    // Get button from parent controls
           var buttons = this.Controls.OfType<Panel>().LastOrDefault();
  if (buttons != null)
       {
           btnSave = buttons.Controls.OfType<Button>().FirstOrDefault();
            }
            }

            if (cboCustomer.SelectedIndex > 0)
            {
        var selectedText = cboCustomer.SelectedItem.ToString();
             var parts = selectedText.Split(new string[] { " - " }, StringSplitOptions.None);

                if (parts.Length > 0)
     {
                _selectedCustomer = new Customer
     {
    CustomerId = parts[0].Trim(),
 Name = parts.Length > 1 ? parts[1].Trim() : ""
       };

         lblSelectedCustomer.Text = $"✓ Đã chọn: {_selectedCustomer.Name} ({_selectedCustomer.CustomerId})";
       SelectedCustomer = _selectedCustomer;

  if (btnSave != null)
       btnSave.Enabled = true;
 }
            }
          else
 {
         _selectedCustomer = null;
  lblSelectedCustomer.Text = "";
       SelectedCustomer = null;

  if (btnSave != null)
 btnSave.Enabled = false;
    }
        }

