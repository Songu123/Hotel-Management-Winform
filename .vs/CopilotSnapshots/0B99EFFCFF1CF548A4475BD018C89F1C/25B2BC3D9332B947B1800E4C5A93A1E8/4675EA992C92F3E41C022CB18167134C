## Integration with Existing System

### In RoomManagementUI

```csharp
public partial class UCRoom : UserControl
{
    private ModernRoomCardContainer _roomContainer;
 private IRoomService _roomService;

    public UCRoom(IRoomService roomService)
    {
   InitializeComponent();
    _roomService = roomService;
 
        // Setup modern cards
        _roomContainer = new ModernRoomCardContainer();
        _roomContainer.Dock = DockStyle.Fill;
        this.Controls.Add(_roomContainer);
      
        // Subscribe to events
        _roomContainer.ViewDetailsClicked += (s, room) => ShowRoomDetails(room);
        _roomContainer.BookingClicked += (s, room) => ShowBookingDialog(room);
        _roomContainer.CleaningClicked += (s, room) => ShowCleaningDialog(room);
        
   // Load rooms
        LoadRooms();
    }
 
    private async void LoadRooms()
    {
    var rooms = await _roomService.GetAllRoomsAsync();
 foreach (var room in rooms)
        {
      _roomContainer.AddRoom(room, GetRoomStatus(room));
        }
    }

    private ModernRoomCard.RoomStatus GetRoomStatus(Room room)
    {
        // Determine status based on room state
        return ModernRoomCard.RoomStatus.Available;
    }
}
```

