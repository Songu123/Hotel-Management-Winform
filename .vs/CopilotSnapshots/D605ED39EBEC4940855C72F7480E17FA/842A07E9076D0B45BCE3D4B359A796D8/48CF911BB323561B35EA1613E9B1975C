        private void btnAddAmenity_Click(object sender, EventArgs e)
        {
            _currentEditingAmenity = null;
            ClearAmenityForm();
            gbAmenityInfo.Text = "THÊM TIỆN ÍCH MỚI";
            pnlAmenityForm.Visible = true;
            pnlAmenityMain.Visible = false;
        }

        private void btnEditAmenity_Click(object sender, EventArgs e)
        {
            if (dgvAmenities.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn tiện ích cần chỉnh sửa", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            try
            {
                var amenityId = dgvAmenities.SelectedRows[0].Cells["colAmenityId"].Value?.ToString();
                var amenity = _allAmenities.FirstOrDefault(a => a.AmenityId == amenityId);

                if (amenity != null)
                {
                    _currentEditingAmenity = amenity;
                    PopulateAmenityForm(amenity);
                    gbAmenityInfo.Text = "CHỈNH SỬA TIỆN ÍCH";
                    pnlAmenityForm.Visible = true;
                    pnlAmenityMain.Visible = false;
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private async void btnDeleteAmenity_Click(object sender, EventArgs e)
        {
            if (dgvAmenities.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn tiện ích cần xóa", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            if (MessageBox.Show("Bạn có chắc muốn xóa tiện ích này không?", "Xác nhận", MessageBoxButtons.YesNo, MessageBoxIcon.Question) == DialogResult.No)
                return;

            try
            {
                var amenityId = dgvAmenities.SelectedRows[0].Cells["colAmenityId"].Value?.ToString();
                var amenity = _allAmenities.FirstOrDefault(a => a.AmenityId == amenityId);
                if (amenity != null)
                {
                    amenity.IsDeleted = 1;
                    _dbContext.Amenities.Update(amenity);
                    await _dbContext.SaveChangesAsync();
                    await LoadAmenityDataAsync();
                    MessageBox.Show("Xóa tiện ích thành công", "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private async void btnSaveAmenity_Click(object sender, EventArgs e)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(tbAmenityId.Text))
                {
                    MessageBox.Show("Mã tiện ích không được để trống", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    tbAmenityId.Focus();
                    return;
                }

                if (string.IsNullOrWhiteSpace(tbAmenityName.Text))
                {
                    MessageBox.Show("Tên tiện ích không được để trống", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    tbAmenityName.Focus();
                    return;
                }

                if (_currentEditingAmenity == null)
                {
                    var amenity = new Amenity
                    {
                        AmenityId = tbAmenityId.Text.Trim(),
                        Name = tbAmenityName.Text.Trim(),
                        IsDeleted = 0
                    };
                    _dbContext.Amenities.Add(amenity);
                }
                else
                {
                    _currentEditingAmenity.AmenityId = tbAmenityId.Text.Trim();
                    _currentEditingAmenity.Name = tbAmenityName.Text.Trim();
                    _dbContext.Amenities.Update(_currentEditingAmenity);
                }

                await _dbContext.SaveChangesAsync();
                MessageBox.Show("Lưu tiện ích thành công", "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                await LoadAmenityDataAsync();
                ClearAmenityForm();
                pnlAmenityForm.Visible = false;
                pnlAmenityMain.Visible = true;
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnCancelAmenity_Click(object sender, EventArgs e)
        {
            ClearAmenityForm();
            pnlAmenityForm.Visible = false;
            pnlAmenityMain.Visible = true;
            _currentEditingAmenity = null;
        }

        // ===== HELPER METHODS =====
        private void PopulateForm(Room room)
        {
            tbFormRoomId.Text = room.RoomId;
            tbFormRoomName.Text = room.Name;
            cbFormRoomType.SelectedIndex = room.RoomType - 1;
            cbFormRoomTypeDetails.SelectedIndex = room.RoomTypeDetails - 1;
            tbFormPrice.Text = room.Price.ToString();
            cbFormStatus.SelectedIndex = room.Status;
            cbFormCurrentCondition.SelectedIndex = room.CurrentCondition;
        }

        private void ClearForm()
        {
            tbFormRoomId.Clear();
            tbFormRoomName.Clear();
            cbFormRoomType.SelectedIndex = 0;
            cbFormRoomTypeDetails.SelectedIndex = 0;
            tbFormPrice.Clear();
            cbFormStatus.SelectedIndex = 0;
            cbFormCurrentCondition.SelectedIndex = 0;
            _currentEditingRoom = null;
        }

        private void PopulateAmenityForm(Amenity amenity)
        {
            tbAmenityId.Text = amenity.AmenityId;
            tbAmenityName.Text = amenity.Name;
        }

        private void ClearAmenityForm()
        {
            tbAmenityId.Clear();
            tbAmenityName.Clear();
            _currentEditingAmenity = null;
        }

        private void ResetFilters()
        {
            tbRoomId.Clear();
            tbRoomName.Clear();
            cbRoomType.SelectedIndex = 0;
            cbRoomTypeDetails.SelectedIndex = 0;
            cbPrice.SelectedIndex = 0;
            cbStatus.SelectedIndex = 0;
            cbCurrentCondition.SelectedIndex = 0;
        }

        private void ApplyStyleToDataGridView()
        {
            if (dgvRooms == null) return;

            dgvRooms.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill;
            dgvRooms.AllowUserToAddRows = false;
            dgvRooms.AllowUserToDeleteRows = false;
            dgvRooms.SelectionMode = DataGridViewSelectionMode.FullRowSelect;
            dgvRooms.MultiSelect = false;

            if (dgvAmenities != null)
            {
                dgvAmenities.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill;
                dgvAmenities.AllowUserToAddRows = false;
                dgvAmenities.AllowUserToDeleteRows = false;
                dgvAmenities.SelectionMode = DataGridViewSelectionMode.FullRowSelect;
                dgvAmenities.MultiSelect = false;
            }
        }
    }
