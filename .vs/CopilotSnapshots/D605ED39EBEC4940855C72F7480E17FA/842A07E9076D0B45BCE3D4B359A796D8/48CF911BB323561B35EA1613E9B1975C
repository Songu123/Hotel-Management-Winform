        private string GetRoomType(int roomType) => roomType switch { 1 => "Thường", 2 => "VIP", 3 => "Deluxe", 4 => "Suite", _ => "Không xác định" };
        private string GetRoomTypeDetails(int details) => details switch { 1 => "Phòng đơn", 2 => "Phòng đôi", 3 => "Phòng gia đình", _ => "Không xác định" };
        private string GetStatusDisplay(int status) => status switch { 0 => "Chưa dọn phòng", 1 => "Trống", 2 => "Đã đặt", _ => "Không xác định" };
        private string GetCurrentConditionDisplay(int condition) => condition switch { 0 => "Mới", 1 => "Tốt", 2 => "Cần sửa chữa", _ => "Không xác định" };

        // ===== ROOM TAB EVENT HANDLERS =====
        private async void tbRoomId_TextChanged(object sender, EventArgs e) => await ApplyFiltersAsync();
        private async void tbRoomName_TextChanged(object sender, EventArgs e) => await ApplyFiltersAsync();
        private async void cbRoomType_SelectedIndexChanged(object sender, EventArgs e) => await ApplyFiltersAsync();
        private async void cbRoomTypeDetails_SelectedIndexChanged(object sender, EventArgs e) => await ApplyFiltersAsync();
        private async void cbPrice_SelectedIndexChanged(object sender, EventArgs e) => await ApplyFiltersAsync();
        private async void cbStatus_SelectedIndexChanged(object sender, EventArgs e) => await ApplyFiltersAsync();
        private async void cbCurrentCondition_SelectedIndexChanged(object sender, EventArgs e) => await ApplyFiltersAsync();

        private async Task ApplyFiltersAsync()
        {
            try
            {
                var filteredRooms = _allRooms.AsEnumerable();

                string roomId = tbRoomId?.Text?.Trim() ?? "";
                if (!string.IsNullOrEmpty(roomId))
                    filteredRooms = filteredRooms.Where(r => r.RoomId.Contains(roomId, StringComparison.OrdinalIgnoreCase));

                string roomName = tbRoomName?.Text?.Trim() ?? "";
                if (!string.IsNullOrEmpty(roomName))
                    filteredRooms = filteredRooms.Where(r => r.Name.Contains(roomName, StringComparison.OrdinalIgnoreCase));

                int roomTypeIndex = cbRoomType?.SelectedIndex ?? 0;
                if (roomTypeIndex > 0)
                    filteredRooms = filteredRooms.Where(r => r.RoomType == roomTypeIndex);

                int detailsIndex = cbRoomTypeDetails?.SelectedIndex ?? 0;
                if (detailsIndex > 0)
                    filteredRooms = filteredRooms.Where(r => r.RoomTypeDetails == detailsIndex);

                int priceIndex = cbPrice?.SelectedIndex ?? 0;
                filteredRooms = priceIndex switch
                {
                    1 => filteredRooms.Where(r => r.Price < 100000),
                    2 => filteredRooms.Where(r => r.Price >= 100000 && r.Price < 200000),
                    3 => filteredRooms.Where(r => r.Price >= 200000 && r.Price < 300000),
                    4 => filteredRooms.Where(r => r.Price >= 300000),
                    _ => filteredRooms
                };

                int statusIndex = cbStatus?.SelectedIndex ?? 0;
                if (statusIndex > 0)
                    filteredRooms = filteredRooms.Where(r => r.Status == statusIndex - 1);

                int conditionIndex = cbCurrentCondition?.SelectedIndex ?? 0;
                if (conditionIndex > 0)
                    filteredRooms = filteredRooms.Where(r => r.CurrentCondition == conditionIndex - 1);

                BindRoomDataToGrid(filteredRooms.ToList());
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi lọc dữ liệu: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnAddRoom_Click(object sender, EventArgs e)
        {
            _currentEditingRoom = null;
            ClearForm();
            gbRoomInfo.Text = "THÊM PHÒNG MỚI";
            pnlForm.Visible = true;
            pnlGrid.Visible = false;
        }

        private async void btnEditRoom_Click(object sender, EventArgs e)
        {
            if (dgvRooms.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn phòng cần chỉnh sửa", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            try
            {
                var roomId = dgvRooms.SelectedRows[0].Cells["colRoomId"].Value?.ToString();
                var room = _allRooms.FirstOrDefault(r => r.RoomId == roomId);

                if (room != null)
                {
                    FrmEditRoom editForm = new FrmEditRoom(room, _dbContext);
                    if (editForm.ShowDialog() == DialogResult.OK && editForm.IsRoomUpdated)
                    {
                        await LoadRoomDataAsync();
                        await ApplyFiltersAsync();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnDeleteRoom_Click(object sender, EventArgs e)
        {
            if (dgvRooms.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn phòng cần xem chi tiết", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            try
            {
                var roomId = dgvRooms.SelectedRows[0].Cells["colRoomId"].Value?.ToString();
                var room = _allRooms.FirstOrDefault(r => r.RoomId == roomId);

                if (room != null)
                {
                    FrmRoomDetails detailsForm = new FrmRoomDetails(room, _dbContext);
                    detailsForm.ShowDialog();
                    _ = LoadRoomDataAsync();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private async void btnSaveRoom_Click(object sender, EventArgs e)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(tbFormRoomId.Text))
                {
                    MessageBox.Show("Mã phòng không được để trống", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    tbFormRoomId.Focus();
                    return;
                }

                if (string.IsNullOrWhiteSpace(tbFormRoomName.Text))
                {
                    MessageBox.Show("Tên phòng không được để trống", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    tbFormRoomName.Focus();
                    return;
                }

                if (!int.TryParse(tbFormPrice.Text, out int price) || price <= 0)
                {
                    MessageBox.Show("Giá phòng phải là số dương", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    tbFormPrice.Focus();
                    return;
                }

                var room = new Room
                {
                    RoomId = tbFormRoomId.Text.Trim(),
                    Name = tbFormRoomName.Text.Trim(),
                    RoomType = cbFormRoomType.SelectedIndex + 1,
                    RoomTypeDetails = cbFormRoomTypeDetails.SelectedIndex + 1,
                    Price = price,
                    Status = cbFormStatus.SelectedIndex,
                    CurrentCondition = cbFormCurrentCondition.SelectedIndex,
                    IsDeleted = 0
                };

                bool result;
                if (_currentEditingRoom == null)
                {
                    result = (await _roomService.CreateRoomAsync(room)) != null;
                }
                else
                {
                    room.RoomId = _currentEditingRoom.RoomId;
                    room.IsDeleted = _currentEditingRoom.IsDeleted;
                    result = await _roomService.UpdateRoomAsync(room);
                }

                if (result)
                {
                    MessageBox.Show("Lưu phòng thành công", "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    await LoadRoomDataAsync();
                    await ApplyFiltersAsync();
                    ClearForm();
                    pnlForm.Visible = false;
                    pnlGrid.Visible = true;
                }
                else
                {
                    MessageBox.Show("Lưu phòng thất bại", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

