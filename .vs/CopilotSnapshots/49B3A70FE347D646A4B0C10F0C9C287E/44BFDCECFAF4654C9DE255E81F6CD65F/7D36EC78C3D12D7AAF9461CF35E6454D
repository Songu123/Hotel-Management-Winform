        private string GetRoomTypeName(int roomType)
        {
            return roomType switch
            {
                1 => "Phòng Đơn",
                2 => "Phòng Đôi",
                3 => "Phòng Gia đình",
                4 => "Phòng VIP",
                5 => "Phòng Suite",
                _ => "Không xác định"
            };
        }

        /// <summary>
        /// Helper: Get room status name
        /// </summary>
        private string GetRoomStatusName(int status)
        {
            return status switch
            {
                0 => "Sẵn sàng",
                1 => "Đang sử dụng",
                2 => "Đang dọn",
                3 => "Bảo trì",
                _ => "Không xác định"
            };
