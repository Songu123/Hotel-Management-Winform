namespace QuanLyKhachSan.UI
{
    partial class MainForm
    {
        private System.ComponentModel.IContainer components = null;
        private Panel contentPanel;

        protected override void Dispose(bool disposing)
        {
            if (disposing && (components != null))
            {
                components.Dispose();
            }
            base.Dispose(disposing);
        }

        private void InitializeComponent()
        {
            components = new System.ComponentModel.Container();

            // Main panel
            Panel mainPanel = new Panel();
            mainPanel.Dock = DockStyle.Fill;
            mainPanel.BackColor = Color.FromArgb(245, 247, 250);

            // Sidebar panel
            Panel sidebarPanel = new Panel();
            sidebarPanel.Width = 220;
            sidebarPanel.Dock = DockStyle.Left;
            sidebarPanel.BackColor = Color.FromArgb(30, 40, 60);

            // Logo panel
            Panel logoPanel = new Panel();
            logoPanel.Height = 100;
            logoPanel.Dock = DockStyle.Top;
            logoPanel.BackColor = Color.FromArgb(20, 30, 50);
            logoPanel.BorderStyle = BorderStyle.FixedSingle;

            Label logoLabel = new Label();
            logoLabel.Text = "🏨 HOTEL";
            logoLabel.Font = new Font("Segoe UI", 18, FontStyle.Bold);
            logoLabel.ForeColor = Color.White;
            logoLabel.Dock = DockStyle.Fill;
            logoLabel.TextAlign = ContentAlignment.MiddleCenter;
            logoPanel.Controls.Add(logoLabel);

            sidebarPanel.Controls.Add(logoPanel);

            // Navigation buttons
            string[] menuItems = { "DASHBOARD", "ROOM MANAGEMENT", "BOOKING MANAGEMENT", "CUSTOMER MANAGEMENT", "INVOICES & SERVICES" };
            int yPos = 110;

            foreach (string item in menuItems)
            {
                Button btnMenu = new Button();
                btnMenu.Text = "📊 " + item;
                btnMenu.Width = 220;
                btnMenu.Height = 50;
                btnMenu.Location = new Point(0, yPos);
                btnMenu.FlatStyle = FlatStyle.Flat;
                btnMenu.ForeColor = Color.White;
                btnMenu.BackColor = item == "DASHBOARD" ? Color.FromArgb(70, 130, 180) : Color.Transparent;
                btnMenu.Font = new Font("Segoe UI", 10);
                btnMenu.FlatAppearance.BorderSize = 0;
                btnMenu.Cursor = Cursors.Hand;
                btnMenu.Tag = item;
                btnMenu.Click += (s, e) => MenuItemClick(s, e);

                sidebarPanel.Controls.Add(btnMenu);
                yPos += 55;
            }

            // Bottom menu items
            Panel bottomMenuPanel = new Panel();
            bottomMenuPanel.Height = 130;
            bottomMenuPanel.Dock = DockStyle.Bottom;
            bottomMenuPanel.BackColor = Color.FromArgb(30, 40, 60);

            string[] bottomItems = { "HELP CENTER", "LOGOUT" };
            int bottomYPos = 0;
            foreach (string item in bottomItems)
            {
                Button btnBottom = new Button();
                btnBottom.Text = "❓ " + item;
                btnBottom.Width = 220;
                btnBottom.Height = 50;
                btnBottom.Location = new Point(0, bottomYPos);
                btnBottom.FlatStyle = FlatStyle.Flat;
                btnBottom.ForeColor = Color.White;
                btnBottom.BackColor = Color.Transparent;
                btnBottom.Font = new Font("Segoe UI", 10);
                btnBottom.FlatAppearance.BorderSize = 0;
                btnBottom.Cursor = Cursors.Hand;
                btnBottom.Click += (s, e) => BottomMenuClick(s, e);
                bottomMenuPanel.Controls.Add(btnBottom);
                bottomYPos += 55;
            }
            sidebarPanel.Controls.Add(bottomMenuPanel);

            // Header panel
            Panel headerPanel = new Panel();
            headerPanel.Height = 60;
            headerPanel.Dock = DockStyle.Top;
            headerPanel.BackColor = Color.White;
            headerPanel.BorderStyle = BorderStyle.FixedSingle;

            Label headerTitleLabel = new Label();
            headerTitleLabel.Text = "Welcome to Hotel Management";
            headerTitleLabel.Font = new Font("Segoe UI", 24, FontStyle.Bold);
            headerTitleLabel.ForeColor = Color.FromArgb(30, 40, 60);
            headerTitleLabel.Location = new Point(30, 8);
            headerTitleLabel.Size = new Size(600, 40);

            Label headerSubLabel = new Label();
            headerSubLabel.Text = "Manage your hotel efficiently with our comprehensive system.";
            headerSubLabel.Font = new Font("Segoe UI", 10);
            headerSubLabel.ForeColor = Color.Gray;
            headerSubLabel.Location = new Point(30, 45);
            headerSubLabel.Size = new Size(600, 20);

            headerPanel.Controls.Add(headerTitleLabel);
            headerPanel.Controls.Add(headerSubLabel);

            // Content panel
            contentPanel = new Panel();
            contentPanel.Dock = DockStyle.Fill;
            contentPanel.AutoScroll = true;
            contentPanel.BackColor = Color.FromArgb(245, 247, 250);

            // Welcome content
            CreateWelcomeContent(contentPanel);

            // Add panels to main
            mainPanel.Controls.Add(contentPanel);
            mainPanel.Controls.Add(headerPanel);

            // Form settings
            this.AutoScaleDimensions = new SizeF(7F, 15F);
            this.AutoScaleMode = AutoScaleMode.Font;
            this.ClientSize = new Size(1600, 900);
            this.Controls.Add(mainPanel);
            this.Controls.Add(sidebarPanel);
            this.Name = "MainForm";
            this.Text = "Hotel Management System";
            this.StartPosition = FormStartPosition.CenterScreen;
            this.WindowState = FormWindowState.Maximized;
        }

        private void CreateWelcomeContent(Panel container)
        {
            container.Controls.Clear();
            container.Padding = new Padding(40);

            // Welcome Panel
            Panel welcomePanel = new Panel();
            welcomePanel.Location = new Point(40, 20);
            welcomePanel.Size = new Size(1500, 200);
            welcomePanel.BackColor = Color.White;
            welcomePanel.BorderStyle = BorderStyle.FixedSingle;
            welcomePanel.Padding = new Padding(30);

            Label welcomeTitle = new Label();
            welcomeTitle.Text = "Welcome to Hotel Management System";
            welcomeTitle.Font = new Font("Segoe UI", 20, FontStyle.Bold);
            welcomeTitle.ForeColor = Color.FromArgb(30, 40, 60);
            welcomeTitle.Location = new Point(30, 15);
            welcomeTitle.Size = new Size(600, 35);
            welcomePanel.Controls.Add(welcomeTitle);

            Label welcomeDesc = new Label();
            welcomeDesc.Text = "This comprehensive system helps you manage all aspects of your hotel operations.\n" +
      "From room management to booking and invoicing, everything is organized in one place.\n" +
  "Select a section from the left menu to get started.";
            welcomeDesc.Font = new Font("Segoe UI", 11);
            welcomeDesc.ForeColor = Color.Gray;
            welcomeDesc.Location = new Point(30, 55);
            welcomeDesc.Size = new Size(800, 80);
            welcomeDesc.AutoSize = false;
            welcomePanel.Controls.Add(welcomeDesc);

            container.Controls.Add(welcomePanel);

            // Quick Access Section
            Label quickAccessLabel = new Label();
            quickAccessLabel.Text = "Quick Access";
            quickAccessLabel.Font = new Font("Segoe UI", 16, FontStyle.Bold);
            quickAccessLabel.ForeColor = Color.FromArgb(30, 40, 60);
            quickAccessLabel.Location = new Point(40, 240);
            quickAccessLabel.Size = new Size(300, 30);
            container.Controls.Add(quickAccessLabel);

            // Quick Access Cards
            string[] quickItems = {
       "📊 Dashboard",
       "🛏️ Room Management",
  "📅 Bookings",
 "👥 Customers",
                "💰 Invoices",
                "⚙️ Services"
            };

            int[] colors = {
      Color.FromArgb(40, 200, 150).ToArgb(),
        Color.FromArgb(70, 130, 180).ToArgb(),
        Color.FromArgb(200, 120, 80).ToArgb(),
            Color.FromArgb(100, 150, 200).ToArgb(),
        Color.FromArgb(150, 100, 200).ToArgb(),
   Color.FromArgb(100, 200, 150).ToArgb()
      };

            int cardX = 40;
            int cardY = 280;

            for (int i = 0; i < quickItems.Length; i++)
            {
                Panel card = CreateQuickAccessCard(quickItems[i], Color.FromArgb(colors[i]), cardX, cardY);
                container.Controls.Add(card);

                cardX += 270;
                if ((i + 1) % 3 == 0)
                {
                    cardX = 40;
                    cardY += 170;
                }
            }

            // Features Section
            Label featuresLabel = new Label();
            featuresLabel.Text = "Key Features";
            featuresLabel.Font = new Font("Segoe UI", 16, FontStyle.Bold);
            featuresLabel.ForeColor = Color.FromArgb(30, 40, 60);
            featuresLabel.Location = new Point(40, 650);
            featuresLabel.Size = new Size(300, 30);
            container.Controls.Add(featuresLabel);

            // Features Panel
            Panel featuresPanel = new Panel();
            featuresPanel.Location = new Point(40, 690);
            featuresPanel.Size = new Size(1500, 250);
            featuresPanel.BackColor = Color.White;
            featuresPanel.BorderStyle = BorderStyle.FixedSingle;
            featuresPanel.Padding = new Padding(30);

            string[] features = {
         "✓ Real-time room availability tracking",
             "✓ Comprehensive booking management system",
                "✓ Professional invoice generation and payment tracking",
       "✓ Customer profile and loyalty program management",
  "✓ Detailed financial reports and analytics",
                "✓ Service charge management for premium amenities",
   "✓ Multi-user dashboard with live statistics",
    "✓ Secure database with Entity Framework Core"
    };

            int featureY = 15;
            for (int i = 0; i < features.Length; i++)
            {
                Label featureLabel = new Label();
                featureLabel.Text = features[i];
                featureLabel.Font = new Font("Segoe UI", 10);
                featureLabel.ForeColor = Color.FromArgb(50, 50, 50);
                featureLabel.Location = new Point(30, featureY);
                featureLabel.Size = new Size(600, 25);
                featuresPanel.Controls.Add(featureLabel);

                featureY += 28;
                if (i == 3)
                {
                    featureY = 15;
                    featureLabel.Location = new Point(750, featureY);
                }
            }

            container.Controls.Add(featuresPanel);
        }

        private Panel CreateQuickAccessCard(string title, Color accentColor, int x, int y)
        {
            Panel card = new Panel();
            card.Location = new Point(x, y);
            card.Size = new Size(250, 150);
            card.BackColor = Color.White;
            card.BorderStyle = BorderStyle.FixedSingle;
            card.Cursor = Cursors.Hand;

            Panel accentBar = new Panel();
            accentBar.Height = 4;
            accentBar.Dock = DockStyle.Top;
            accentBar.BackColor = accentColor;
            card.Controls.Add(accentBar);

            Label titleLabel = new Label();
            titleLabel.Text = title;
            titleLabel.Font = new Font("Segoe UI", 14, FontStyle.Bold);
            titleLabel.ForeColor = Color.FromArgb(30, 40, 60);
            titleLabel.Location = new Point(15, 40);
            titleLabel.Size = new Size(220, 35);
            titleLabel.TextAlign = ContentAlignment.MiddleLeft;
            card.Controls.Add(titleLabel);

            Label clickLabel = new Label();
            clickLabel.Text = "Click to access →";
            clickLabel.Font = new Font("Segoe UI", 9);
            clickLabel.ForeColor = Color.Gray;
            clickLabel.Location = new Point(15, 110);
            clickLabel.Size = new Size(220, 20);
            card.Controls.Add(clickLabel);

            return card;
        }
    }
}
