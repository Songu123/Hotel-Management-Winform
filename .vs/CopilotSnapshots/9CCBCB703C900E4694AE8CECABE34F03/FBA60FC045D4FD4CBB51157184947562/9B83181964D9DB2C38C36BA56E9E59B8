        private Panel CreateMetricCard(string title, string value, string subtitle, Color accentColor, int x, int y)
        {
            Panel card = new Panel();
            card.Location = new Point(x, y);
            card.Size = new Size(370, 180);
            card.BackColor = Color.White;
            card.BorderStyle = BorderStyle.FixedSingle;
            card.Cursor = Cursors.Hand;

            // Top accent bar
            Panel accentBar = new Panel();
            accentBar.Height = 4;
            accentBar.Dock = DockStyle.Top;
            accentBar.BackColor = accentColor;
            card.Controls.Add(accentBar);

            // Title
            Label titleLabel = new Label();
            titleLabel.Text = title;
            titleLabel.Font = new Font("Segoe UI", 9, FontStyle.Bold);
            titleLabel.ForeColor = Color.Gray;
            titleLabel.Location = new Point(15, 15);
            titleLabel.Size = new Size(340, 20);
            card.Controls.Add(titleLabel);

            // Value
            Label valueLabel = new Label();
            valueLabel.Text = value;
            valueLabel.Font = new Font("Segoe UI", 36, FontStyle.Bold);
            valueLabel.ForeColor = Color.FromArgb(30, 40, 60);
            valueLabel.Location = new Point(15, 45);
            valueLabel.Size = new Size(340, 50);
            card.Controls.Add(valueLabel);

            // Subtitle
            Label subtitleLabel = new Label();
            subtitleLabel.Text = subtitle;
            subtitleLabel.Font = new Font("Segoe UI", 10);
            subtitleLabel.ForeColor = Color.Gray;
            subtitleLabel.Location = new Point(15, 110);
            subtitleLabel.Size = new Size(340, 50);
            card.Controls.Add(subtitleLabel);

            return card;
        }

