  private async void LoadInvoiceData(DataGridView dgv)
        {
       try
  {
           dgv.Rows.Clear();
      var invoices = await _invoiceService.GetUnpaidInvoicesAsync();
     foreach (var invoice in invoices)
        {
     dgv.Rows.Add(invoice.InvoiceId, invoice.Customer?.FullName ?? "N/A", 
   invoice.CreatedDate.ToString("MMM dd, yyyy"), 
                 $"${invoice.TotalAmount}", invoice.Status.ToString());
   }
            }
            catch (Exception ex)
            {
   MessageBox.Show($"Lỗi tải dữ liệu hóa đơn: {ex.Message}");
  }
        }

  private async Task RefreshInvoiceData(string status)
  {
     var dgv = contentPanel?.Controls.Find("dgvInvoices", false).FirstOrDefault() as DataGridView;
          if (dgv != null)
     {
 try
         {
      dgv.Rows.Clear();
     var invoices = await _invoiceService.GetUnpaidInvoicesAsync();
        
             var filteredInvoices = status == "All" 
        ? invoices.ToList()
          : invoices.Where(i => i.Status.ToString() == status).ToList();
         
              foreach (var invoice in filteredInvoices)
   {
        dgv.Rows.Add(invoice.InvoiceId, invoice.Customer?.FullName ?? "N/A", 
    invoice.CreatedDate.ToString("MMM dd, yyyy"), 
      $"${invoice.TotalAmount}", invoice.Status.ToString());
        }
     }
       catch (Exception ex)
{
     MessageBox.Show($"Lỗi: {ex.Message}");
       }
      }
  }

