            tbSearch.TextChanged += OnSearchChanged;
            filterPanel.Controls.Add(tbSearch);

            // Status Filter
            Label statusLabel = new Label();
            statusLabel.Text = "Status:";
            statusLabel.Font = new Font("Segoe UI", 10, FontStyle.Bold);
            statusLabel.ForeColor = Color.FromArgb(30, 40, 60);
            statusLabel.Location = new Point(330, 15);
            statusLabel.Size = new Size(60, 25);
            filterPanel.Controls.Add(statusLabel);

            cbStatus = new ComboBox();
            cbStatus.Location = new Point(400, 15);
            cbStatus.Size = new Size(150, 28);
            cbStatus.Items.Add("Tất cả");
            cbStatus.Items.Add("Trống");
            cbStatus.Items.Add("Đã đặt");
            cbStatus.Items.Add("Có người ở");
            cbStatus.Items.Add("Bảo trì");
            cbStatus.Items.Add("Không sử dụng");
            cbStatus.DropDownStyle = ComboBoxStyle.DropDownList;
            cbStatus.SelectedIndex = 0;
            cbStatus.SelectedIndexChanged += OnStatusFilterChanged;
            filterPanel.Controls.Add(cbStatus);

            // Room Type Filter
            Label typeLabel = new Label();
            typeLabel.Text = "Room Type:";
            typeLabel.Font = new Font("Segoe UI", 10, FontStyle.Bold);
            typeLabel.ForeColor = Color.FromArgb(30, 40, 60);
            typeLabel.Location = new Point(570, 15);
            typeLabel.Size = new Size(80, 25);
            filterPanel.Controls.Add(typeLabel);

            cbRoomType = new ComboBox();
            cbRoomType.Location = new Point(660, 15);
            cbRoomType.Size = new Size(200, 28);
            cbRoomType.DropDownStyle = ComboBoxStyle.DropDownList;
            cbRoomType.SelectedIndexChanged += OnRoomTypeFilterChanged;
            filterPanel.Controls.Add(cbRoomType);

            mainLayout.Controls.Add(filterPanel, 0, 1);

            // ===== ROW 2: DataGridView =====
            contentPanel = new Panel();
            contentPanel.Dock = DockStyle.Fill;
            contentPanel.Padding = new Padding(20);
            contentPanel.BackColor = Color.FromArgb(245, 247, 250);
            contentPanel.AutoScroll = true;

            dgvRooms = new DataGridView();
            dgvRooms.Dock = DockStyle.Fill;
            dgvRooms.BackgroundColor = Color.White;
            dgvRooms.BorderStyle = BorderStyle.FixedSingle;
            dgvRooms.AllowUserToAddRows = false;
            dgvRooms.ReadOnly = false;
            dgvRooms.RowHeadersVisible = false;
            dgvRooms.GridColor = Color.LightGray;
            dgvRooms.Font = new Font("Segoe UI", 10);
            dgvRooms.ColumnHeadersHeightSizeMode = DataGridViewColumnHeadersHeightSizeMode.AutoSize;
            dgvRooms.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill;
            dgvRooms.CellClick += OnDataGridViewCellClick;

            // Columns
            dgvRooms.Columns.Add("RoomId", "ID");
            dgvRooms.Columns.Add("RoomNumber", "🔑 Room No");
            dgvRooms.Columns.Add("RoomType", "📏 Type");
            dgvRooms.Columns.Add("Status", "✓ Status");
            dgvRooms.Columns.Add("Price", "💰 Price/Night");
            dgvRooms.Columns.Add("Capacity", "👥 Capacity");
            dgvRooms.Columns.Add("Notes", "📝 Notes");

            // Add action columns
            DataGridViewButtonColumn editColumn = new DataGridViewButtonColumn();
            editColumn.Text = "Edit";
            editColumn.UseColumnTextForButtonValue = true;
            editColumn.HeaderText = "Edit";
            editColumn.Width = 70;
            dgvRooms.Columns.Add(editColumn);

            DataGridViewButtonColumn deleteColumn = new DataGridViewButtonColumn();
            deleteColumn.Text = "Delete";
            deleteColumn.UseColumnTextForButtonValue = true;
            deleteColumn.HeaderText = "Delete";
            deleteColumn.Width = 70;
            dgvRooms.Columns.Add(deleteColumn);

            // Style columns
            dgvRooms.Columns[0].Visible = false; // Hide ID
            dgvRooms.Columns[1].Width = 80;  // Room Number
            dgvRooms.Columns[2].Width = 100; // Type
            dgvRooms.Columns[3].Width = 100; // Status
            dgvRooms.Columns[4].Width = 120; // Price
            dgvRooms.Columns[5].Width = 80;  // Capacity
            dgvRooms.Columns[6].Width = 150; // Notes
            dgvRooms.Columns[7].Width = 70;  // Edit button
            dgvRooms.Columns[8].Width = 70;  // Delete button

            contentPanel.Controls.Add(dgvRooms);
            mainLayout.Controls.Add(contentPanel, 0, 2);

            // Form settings
            this.AutoScaleDimensions = new SizeF(7F, 15F);
            this.AutoScaleMode = AutoScaleMode.Font;
            this.ClientSize = new Size(1400, 900);
            this.Controls.Add(mainLayout);
            this.Name = "RoomManagementForm";
            this.Text = "Hotel Management - Room Management";
            this.StartPosition = FormStartPosition.CenterScreen;
            this.WindowState = FormWindowState.Maximized;
            this.Load += (s, e) => RoomManagementForm_Load(s, e);
        }

        private void OnDataGridViewCellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (dgvRooms == null || e.RowIndex < 0)
                return;

            // Column 7 = Edit button, Column 8 = Delete button
            if (e.ColumnIndex == dgvRooms.Columns.Count - 2) // Edit column
            {
                OnEditRoomClick(sender, e);
            }
            else if (e.ColumnIndex == dgvRooms.Columns.Count - 1) // Delete column
            {
                OnDeleteRoomClick(sender, e);
            }
        }
    }
