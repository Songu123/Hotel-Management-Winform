            headerPanel.Controls.Add(titleLabel);

            Label subtitleLabel = new Label();
            subtitleLabel.Text = "Manage hotel room inventory, status, and availability";
            subtitleLabel.Font = new Font("Segoe UI", 10);
            subtitleLabel.ForeColor = Color.Gray;
            subtitleLabel.Location = new Point(10, 55);
            subtitleLabel.Size = new Size(500, 20);
            headerPanel.Controls.Add(subtitleLabel);

            Button btnAddRoom = new Button();
            btnAddRoom.Text = "+ ADD NEW ROOM";
            btnAddRoom.Location = new Point(600, 30);
            btnAddRoom.Size = new Size(150, 40);
            btnAddRoom.BackColor = Color.FromArgb(30, 40, 60);
            btnAddRoom.ForeColor = Color.White;
            btnAddRoom.Font = new Font("Segoe UI", 10, FontStyle.Bold);
            btnAddRoom.FlatStyle = FlatStyle.Flat;
            btnAddRoom.Cursor = Cursors.Hand;
            btnAddRoom.Click += OnAddRoomClick;
            headerPanel.Controls.Add(btnAddRoom);

            mainLayout.Controls.Add(headerPanel, 0, 0);

            // ===== ROW 1: Filter Panel =====
            Panel filterPanel = new Panel();
            filterPanel.BackColor = Color.White;
            filterPanel.BorderStyle = BorderStyle.FixedSingle;
            filterPanel.Padding = new Padding(20);

            // Search Label & TextBox
            Label searchLabel = new Label();
            searchLabel.Text = "🔍 Search:";
            searchLabel.Font = new Font("Segoe UI", 10, FontStyle.Bold);
