private async void DashboardForm_Load(object sender, EventArgs e)
        {
       try
            {
      await LoadDashboardData();
   }
   catch (Exception ex)
            {
              MessageBox.Show("Lỗi tải dữ liệu: " + ex.Message);
  }
        }

      private async Task LoadDashboardData()
   {
 // Tính toán thống kê
       var allRooms = await _roomService.GetAllRoomsAsync();
      var availableRooms = await _roomService.GetAvailableRoomsAsync();
    var upcomingCheckIns = await _bookingService.GetUpcomingCheckInsAsync(1);

   // Cập nhật giao diện với dữ liệu thực
     UpdateOccupancyRate(allRooms.Count(), availableRooms.Count());
 UpdateCheckInsPending(upcomingCheckIns.Count());

   // Load revenue data
 await UpdateRevenueData();
        }

        private void UpdateOccupancyRate(int totalRooms, int availableRooms)
 {
   if (totalRooms > 0)
    {
      int occupiedRooms = totalRooms - availableRooms;
     int occupancyRate = (occupiedRooms * 100) / totalRooms;
  // Cập nhật label occupancy rate
