    }
 catch (Exception ex)
      {
         MessageBox.Show($"Lỗi mở form: {ex.Message}");
  }
      }

     private void OpenForm<T>() where T : Form
        {
   try
   {
           // Kiểm tra nếu form đã mở
         foreach (Form openForm in Application.OpenForms)
    {
  if (openForm.GetType() == typeof(T))
 {
        openForm.BringToFront();
     openForm.Focus();
      return;
        }
     }

  // Nếu chưa mở, tạo instance mới qua DI
   var form = ActivatorUtilities.CreateInstance<T>(_serviceProvider);
    form.Show();
        }
      catch (Exception ex)
     {
       MessageBox.Show($"Lỗi: {ex.Message}");
     }
      }

